+wxString ROUTER_TOOL::GetRoutingPreview()
+{
+    if( !m_router || !m_iface )
+        return {};
+
+    const auto state = m_router->GetState();
+
+    if( state != PNS::ROUTER::ROUTE_TRACK && state != PNS::ROUTER::DRAG_SEGMENT )
+        return {};
+
+    std::vector<PNS::ITEM*> removed, added, heads;
+    m_router->GetUpdatedItems( removed, added, heads );
+    std::vector<std::unique_ptr<PNS::ITEM>> ownedHeads;
+
+    for( PNS::ITEM* item : heads )
+        ownedHeads.emplace_back( item );
+
+    using nlohmann::json;
+    json snapshot = { { "version", 1 }, { "removed", json::array() },
+                      { "tracks", json::array() } };
+    json& tracks = snapshot["tracks"];
+
+    for( const PNS::ITEM* item : removed )
+    {
+        if( const BOARD_ITEM* parent = item->Parent();
+            parent && parent->IsType( { PCB_TRACE_T, PCB_ARC_T, PCB_VIA_T } ) )
+        {
+            snapshot["removed"].push_back( parent->m_Uuid.AsString().ToStdString() );
+        }
+    }
+
+    auto addSegment = [&]( int net, int layer, const SEG& segment )
+    {
+        tracks.push_back( { 0, net, layer, segment.A.x, segment.A.y, segment.B.x, segment.B.y } );
+    };
+
+    auto addArc = [&]( int net, int layer, const SHAPE_ARC& arc )
+    {
+        const VECTOR2I& start = arc.GetP0();
+        const VECTOR2I& mid = arc.GetArcMid();
+        const VECTOR2I& end = arc.GetP1();
+        tracks.push_back( { 1, net, layer, start.x, start.y, mid.x, mid.y, end.x, end.y } );
+    };
+
+    auto addVia = [&]( int net, const PNS::VIA& via )
+    {
+        const VECTOR2I& pos = via.Pos();
+        tracks.push_back( { 2, net, m_iface->GetBoardLayerFromPNSLayer( via.Layers().Start() ),
+                            m_iface->GetBoardLayerFromPNSLayer( via.Layers().End() ),
+                            static_cast<int>( via.ViaType() ), pos.x, pos.y } );
+    };
+
+    auto append = [&]( const PNS::ITEM& item )
+    {
+        const auto* net = static_cast<const NETINFO_ITEM*>( item.Net() );
+
+        if( item.IsVirtual() || !net || net->GetNetCode() <= 0 )
+            return;
+
+        const int netcode = net->GetNetCode();
+        const int layer = m_iface->GetBoardLayerFromPNSLayer( item.Layers().Start() );
+
+        switch( item.Kind() )
+        {
+        case PNS::ITEM::SEGMENT_T:
+            addSegment( netcode, layer, static_cast<const PNS::SEGMENT&>( item ).Seg() );
+            break;
+        case PNS::ITEM::ARC_T:
+            addArc( netcode, layer, static_cast<const PNS::ARC&>( item ).CArc() );
+            break;
+        case PNS::ITEM::VIA_T:
+            addVia( netcode, static_cast<const PNS::VIA&>( item ) );
+            break;
+        case PNS::ITEM::LINE_T:
+        {
+            const auto& line = static_cast<const PNS::LINE&>( item );
+            const SHAPE_LINE_CHAIN& chain = line.CLine();
+
+            for( int i = 0; i < chain.SegmentCount(); ++i )
+            {
+                if( !chain.IsArcSegment( i ) )
+                    addSegment( netcode, layer, chain.CSegment( i ) );
+            }
+
+            for( const SHAPE_ARC& arc : chain.CArcs() )
+                addArc( netcode, layer, arc );
+
+            if( line.EndsWithVia() )
+                addVia( netcode, line.Via() );
+
+            break;
+        }
+        default:
+            break;
+        }
+    };
+
+    for( const PNS::ITEM* item : added )
+        append( *item );
+
+    // During a drag the added items already describe everything shown by updateView().
+    // During routing the cursor-attached heads are drawn separately.
+    if( state == PNS::ROUTER::ROUTE_TRACK )
+    {
+        for( const auto& item : ownedHeads )
+            append( *item );
+    }
+
+    return wxString::FromUTF8( snapshot.dump() );
+}
