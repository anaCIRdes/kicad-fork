+};
+
+
+/**
+ * Shows the editor frames of all workspace projects as tabs of the project manager.
+ *
+ * Each docked frame gets a placeholder page in the manager's notebook.  The frame itself stays
+ * a real top level window (see KIPLATFORM::WINDOW_EMBED); it is stripped of its decorations and
+ * kept exactly over its placeholder page whenever that page is visible, and hidden otherwise.
+ * Splitting the notebook (two tabs side by side) therefore shows two editors side by side.
+ *
+ * With tabs switched off (or where docking is not supported) the class still knows all editor
+ * frames and is used to bring an already open one to the front reliably.
+ */
+class WORKSPACE_DOCK : public wxEvtHandler
+{
+public:
+    WORKSPACE_DOCK( KICAD_MANAGER_FRAME* aFrame, wxAuiNotebook* aNotebook, WORKSPACE_PANE* aPane );
+    ~WORKSPACE_DOCK() override;
+
+    /// Can frames be docked on this platform / display server?
+    bool IsAvailable() const;
+
+    bool IsTabbed() const { return m_tabbed; }
+    void SetTabbed( bool aTabbed );
+
+    /**
+     * Bring the editor of the given kind of the given project to the front.
+     *
+     * @return false if no such editor frame is open (the caller then opens it).
+     */
+    bool Activate( const wxString& aProFile, int aFrameType );
+
+    /// Bring the frame to the front as soon as it shows up (it is being opened right now).
+    void ActivateWhenOpened( const wxString& aProFile, int aFrameType );
+
+    /// Give all docked frames back their decorations; call before the manager goes away.
+    void ReleaseAll();
+
+    /// Is \a aPage one of the placeholder pages?
+    bool OwnsPage( wxWindow* aPage ) const;
+
+    /// The user clicked the close button of a placeholder page.
+    void RequestClosePage( wxWindow* aPage );
+
+    /// Re-apply position and visibility of all docked frames now.
+    void Sync();
+
+    /// Refresh translated tab labels.
+    void ShowChangedLanguage();
+
+private:
+    void onTimer( wxTimerEvent& aEvent );
+    void onPageChanged( wxAuiNotebookEvent& aEvent );
+    void onTabRightUp( wxAuiNotebookEvent& aEvent );
+    void onFrameMove( wxMoveEvent& aEvent );
+
+    void refreshWindows();
+    std::vector<WS_WINDOW_INFO> collect() const;
+
+    WS_DOC_PAGE* findPage( unsigned long long aHandle ) const;
+    WS_DOC_PAGE* findPage( const wxString& aProFile, int aFrameType ) const;
+    void         addPage( const WS_WINDOW_INFO& aInfo, bool aSelect );
+    void         removePage( WS_DOC_PAGE* aPage, bool aDetach );
+    void         updateLabel( WS_DOC_PAGE* aPage );
+    void         selectPage( WS_DOC_PAGE* aPage );
+    void         detachPage( WS_DOC_PAGE* aPage );
+    void         unsplit();
+    void         splitPage( wxWindow* aWindow, int aDirection );
+
+    wxString labelFor( const WS_WINDOW_INFO& aInfo ) const;
+
+private:
+    KICAD_MANAGER_FRAME* m_frame;
+    wxAuiNotebook*       m_notebook;
+    WORKSPACE_PANE*      m_pane;
+    wxTimer              m_timer;
+    bool                 m_tabbed;
+    bool                 m_inRefresh;
+
+    std::vector<WS_DOC_PAGE*>                     m_pages;
+    std::map<unsigned long long, WS_WINDOW_INFO>  m_known;     ///< all editor frames seen last
+    std::set<unsigned long long>                  m_floating;  ///< frames the user undocked
+
+    wxString m_pendingProFile;      ///< frame to activate as soon as it appears
+    int      m_pendingFrameType;
+    int      m_pendingTicks;
+};
+
+#endif // KICAD_WORKSPACE_DOCK_H
