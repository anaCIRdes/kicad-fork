+
+void WORKSPACE_PANE::OnProjectLoaded( const wxString& aProFile )
+{
+    // Like in Altium Designer every project that gets opened stays listed in the workspace
+    // until the user removes it.
+    if( !aProFile.IsEmpty() && wxFileName( aProFile ).GetExt() == FILEEXT::ProjectFileExtension
+        && m_workspace.AddProject( aProFile ) )
+    {
+        workspaceChanged( true );
+    }
+    else
+    {
+        ActiveProjectChanged();
+    }
+}
