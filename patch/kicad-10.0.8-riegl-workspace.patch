+void WORKSPACE_PANE::NewWorkspace()
+{
+    wxFileDialog dlg( m_frame, _( "Create New Workspace" ), wxEmptyString, wxEmptyString,
+                      _( "KiCad workspace files" ) + wxS( " (*.kicad_workspace)|*.kicad_workspace" ),
+                      wxFD_SAVE | wxFD_OVERWRITE_PROMPT );
+
+    if( dlg.ShowModal() == wxID_CANCEL )
+        return;
+
+    wxFileName fn( dlg.GetPath() );
+    fn.SetExt( WORKSPACE_FILE_EXT );
+
+    m_workspace.Clear();
+    m_workspace.SetFileName( fn.GetFullPath() );
+    m_snapshot.clear();
+    workspaceChanged( true );
+}
+
+
+void WORKSPACE_PANE::OpenWorkspace()
+{
+    wxFileDialog dlg( m_frame, _( "Open Workspace" ), wxEmptyString, wxEmptyString,
+                      _( "KiCad workspace files" ) + wxS( " (*.kicad_workspace)|*.kicad_workspace" ),
+                      wxFD_OPEN | wxFD_FILE_MUST_EXIST );
+
+    if( dlg.ShowModal() == wxID_CANCEL )
+        return;
+
+    WORKSPACE loaded;
+
+    if( !loaded.Load( dlg.GetPath() ) )
+    {
+        DisplayErrorMessage( m_frame, wxString::Format( _( "'%s' is not a valid workspace file." ),
+                                                        dlg.GetPath() ) );
+        return;
+    }
+
+    m_workspace = loaded;
+    m_snapshot.clear();
+    workspaceChanged( false );
+}
+
+
+void WORKSPACE_PANE::SaveWorkspaceAs()
+{
+    wxFileName current( m_workspace.GetFileName() );
+
+    wxFileDialog dlg( m_frame, _( "Save Workspace As" ), wxEmptyString, current.GetFullName(),
+                      _( "KiCad workspace files" ) + wxS( " (*.kicad_workspace)|*.kicad_workspace" ),
+                      wxFD_SAVE | wxFD_OVERWRITE_PROMPT );
+
+    if( dlg.ShowModal() == wxID_CANCEL )
+        return;
+
+    wxFileName fn( dlg.GetPath() );
+    fn.SetExt( WORKSPACE_FILE_EXT );
+
+    if( !m_workspace.SaveAs( fn.GetFullPath() ) )
+    {
+        DisplayErrorMessage( m_frame, wxString::Format( _( "Could not write workspace file '%s'." ),
+                                                        fn.GetFullPath() ) );
+        return;
+    }
+
+    workspaceChanged( false );
+}
+
+
+void WORKSPACE_PANE::AddProjectDialog()
+{
+    wxFileDialog dlg( m_frame, _( "Add Projects to Workspace" ), wxEmptyString, wxEmptyString,
+                      FILEEXT::ProjectFileWildcard(),
+                      wxFD_OPEN | wxFD_FILE_MUST_EXIST | wxFD_MULTIPLE );
+
+    if( dlg.ShowModal() == wxID_CANCEL )
+        return;
+
+    wxArrayString paths;
+    dlg.GetPaths( paths );
+
+    bool changed = false;
+
+    for( const wxString& path : paths )
+    {
+        if( wxFileName( path ).GetExt() == FILEEXT::ProjectFileExtension )
+            changed |= m_workspace.AddProject( path );
+    }
+
+    if( changed )
+        workspaceChanged( true );
+}
