+/**
+ * @file xsignal.h
+ * xSignals (RIEGL fork): designer-defined signal paths between two pads.  The pads may be in
+ * the same net (one branch of a net) or in different nets that are joined by series components
+ * (termination resistors, AC coupling capacitors, ...).  xSignals are collected in classes; a
+ * class can carry a matched-length and/or an absolute length requirement.  A whole net can be
+ * a member too, which gives plain length matching of a group of nets.
+ *
+ * The data is kept out of the board file on purpose: it lives in "<board>.kicad_xsignals" next
+ * to the board, so that the board stays readable by stock KiCad.
+ */
+
+#ifndef XSIGNAL_H
+#define XSIGNAL_H
+
+#include <map>
+#include <set>
+#include <vector>
+#include <optional>
+#include <wx/string.h>
+#include <kiid.h>
+#include <math/vector2d.h>
+
+class BOARD;
+class BOARD_CONNECTED_ITEM;
+class FOOTPRINT;
+class PAD;
+
+
+/// One end point (pad) of an xSignal section.
+struct XSIGNAL_NODE
+{
+    wxString m_Ref;      ///< footprint reference, e.g. "U1"
+    wxString m_Pad;      ///< pad number, e.g. "A3"
+    KIID     m_Uuid;     ///< pad uuid (preferred when it can be resolved)
+
+    wxString Label() const { return m_Ref + wxS( "." ) + m_Pad; }
+};
+
+
+/**
+ * A signal path.
+ *
+ * Path type: m_Nodes holds an even number of pads.  Pads 2k and 2k+1 are in the same net and
+ * form one routed section; pad 2k+1 and pad 2k+2 belong to the same series component.
+ *
+ * Net type: m_Nodes is empty and m_Net names a net whose complete routing is measured (the
+ * same value the net inspector and the length rules of stock KiCad use).
+ */
+struct XSIGNAL
+{
+    wxString                  m_Name;
+    wxString                  m_Class;       ///< empty: not in a class
+    bool                      m_WholeNet = false;
+    wxString                  m_Net;         ///< whole-net signals only
+    std::vector<XSIGNAL_NODE> m_Nodes;
+
+    /// "U1.A3 > R5 > U2.B7" or the net name
+    wxString Description() const;
+};
+
+
+enum class XSIGNAL_MATCH
+{
+    NONE,          ///< no matching, only the absolute limits (if any)
+    LONGEST,       ///< every member must be within the tolerance of the longest member
+    MEMBER,        ///< every member must be within +/- tolerance of a chosen member
+    TARGET         ///< every member must be within +/- tolerance of a fixed length
+};
+
+
+struct XSIGNAL_CLASS
+{
+    wxString      m_Name;
+    XSIGNAL_MATCH m_Match = XSIGNAL_MATCH::NONE;
+    int64_t       m_Tolerance = 0;       ///< IU
+    wxString      m_Reference;           ///< member name for XSIGNAL_MATCH::MEMBER
+    int64_t       m_Target = 0;          ///< IU, for XSIGNAL_MATCH::TARGET
+    int64_t       m_MinLength = 0;       ///< IU, 0: no lower limit
+    int64_t       m_MaxLength = 0;       ///< IU, 0: no upper limit
+
+    bool HasConstraint() const
+    {
+        return m_Match != XSIGNAL_MATCH::NONE || m_MinLength > 0 || m_MaxLength > 0;
+    }
+};
+
+
+enum class XSIGNAL_STATUS
+{
+    NO_RULE,       ///< no requirement applies
+    MATCHED,       ///< within the allowed window
+    TOO_SHORT,
+    TOO_LONG,
+    UNROUTED,      ///< at least one section has no continuous track path
+    BROKEN         ///< a pad or net could not be found on the board
+};
+
+
+/// Measured values of one xSignal
+struct XSIGNAL_METRICS
+{
+    XSIGNAL_STATUS m_Status = XSIGNAL_STATUS::NO_RULE;
+    bool           m_Resolved = false;   ///< all pads / the net were found
+    bool           m_Routed = false;     ///< every section has a continuous track path
+    int            m_NodeCount = 0;
+    int            m_ViaCount = 0;
+    int64_t        m_TrackLength = 0;    ///< routed track length (shortest path, clipped in pads)
+    int64_t        m_ViaLength = 0;      ///< via height through the stackup
+    int64_t        m_PadToDie = 0;       ///< pad-to-die (pin package) length of the end pads
+    int64_t        m_Unrouted = 0;       ///< Manhattan estimate of unrouted sections
+    int64_t        m_Delay = 0;          ///< propagation delay (needs tuning profiles), IU
+    wxString       m_Problem;            ///< text for BROKEN / UNROUTED
+
+    /// allowed window of the signal length from the class requirement
+    bool           m_HasWindow = false;
+    int64_t        m_WindowMin = 0;
+    int64_t        m_WindowMax = 0;
+    int64_t        m_ReferenceLength = 0;
+    wxString       m_ReferenceName;
+
+    /// per routed section: net code and the total length of that section
+    std::vector<std::pair<int, int64_t>> m_Sections;
+
+    /// tracks, arcs, vias and pads of the path (for highlighting / selection)
+    std::vector<BOARD_CONNECTED_ITEM*> m_Items;
+    std::vector<PAD*>                  m_Pads;
+
+    /// Accurate node-to-node length, including the estimate for unrouted sections
+    int64_t SignalLength() const { return m_TrackLength + m_ViaLength + m_PadToDie + m_Unrouted; }
+
+    /// Distance to the nearest edge of the window: negative = too short, positive = too long
+    int64_t Margin() const;
+};
+
+
+/// Result of an analysis (wizard, "from connected nets", ...): a proposed xSignal
+struct XSIGNAL_PROPOSAL
+{
+    XSIGNAL  m_Signal;
+    wxString m_SourceNet;
+};
+
+
+/**
+ * All xSignals and xSignal classes of a board.
+ */
+class XSIGNAL_STORE
+{
+public:
+    explicit XSIGNAL_STORE( BOARD* aBoard );
+
+    BOARD* GetBoard() const { return m_board; }
+
+    // ---- persistence -------------------------------------------------------------------
+
+    static wxString FileNameFor( const wxString& aBoardFileName );
+
+    /// Load the side-car file of the given board file (missing file: empty store)
+    bool Load( const wxString& aBoardFileName );
+
+    /// Save next to the given board file; removes the side-car file if the store is empty
+    bool Save( const wxString& aBoardFileName );
+
+    const wxString& LoadedFor() const { return m_loadedFor; }
+    bool IsModified() const { return m_modified; }
+    void SetModified( bool aModified = true ) { m_modified = aModified; }
+
+    /// Used after "save a copy": the store still belongs to the board file that is open
+    void RestoreState( const wxString& aLoadedFor, bool aModified )
+    {
+        m_loadedFor = aLoadedFor;
+        m_modified = aModified;
+    }
+
+    // ---- data --------------------------------------------------------------------------
+
+    std::vector<XSIGNAL>&             Signals() { return m_signals; }
+    const std::vector<XSIGNAL>&       Signals() const { return m_signals; }
+    std::vector<XSIGNAL_CLASS>&       Classes() { return m_classes; }
+    const std::vector<XSIGNAL_CLASS>& Classes() const { return m_classes; }
+
+    XSIGNAL*       FindSignal( const wxString& aName );
+    XSIGNAL_CLASS* FindClass( const wxString& aName );
+
+    /// Add a signal; a name clash is resolved by appending a number.  Returns the final name.
+    wxString AddSignal( XSIGNAL aSignal );
+    bool     RemoveSignal( const wxString& aName );
+    bool     RenameSignal( const wxString& aOldName, const wxString& aNewName );
+
+    /// Create the class if it does not exist yet
+    XSIGNAL_CLASS* EnsureClass( const wxString& aName );
+    bool           RemoveClass( const wxString& aName, bool aRemoveMembers );
+    bool           RenameClass( const wxString& aOldName, const wxString& aNewName );
+
+    /// True if an identical path (same pads in the same order or reversed) already exists
+    bool Exists( const XSIGNAL& aSignal ) const;
+
+    /// Altium-style default name: NET_PPn or STARTNET_ENDNET_PPn
+    wxString MakeName( const XSIGNAL& aSignal ) const;
+
+    // ---- measuring ---------------------------------------------------------------------
+
+    /// Measure one signal (no class evaluation)
+    XSIGNAL_METRICS Measure( const XSIGNAL& aSignal ) const;
+
+    /// Measure all signals and evaluate the class requirements.  Index = index in Signals().
+    std::vector<XSIGNAL_METRICS> MeasureAll() const;
+
+    /**
+     * Target for the length tuning tool: if aItem (a track) is part of an xSignal whose class
+     * has a requirement, return the window for the routed section that contains the track.
+     *
+     * @param aMin, aOpt, aMax receive the window for that section in IU
+     * @param aInfo receives a short description ("xSignal D0_PP1, class DATA")
+     */
+    bool TuningTarget( const BOARD_CONNECTED_ITEM* aItem, int& aMin, int& aOpt, int& aMax,
+                       wxString* aInfo = nullptr ) const;
+
+    /// Names of all xSignals whose path contains the given item
+    std::vector<wxString> SignalsContaining( const BOARD_CONNECTED_ITEM* aItem ) const;
+
+    // ---- creating ----------------------------------------------------------------------
+
+    /// The pad that is electrically "opposite" of aPad on a series component, or nullptr
+    static PAD* SeriesPartner( const PAD* aPad );
+
+    /// True if the footprint is usable as a series (pass-through) component
+    static bool IsSeriesComponent( const FOOTPRINT* aFootprint );
+
+    /**
+     * Build the path between two pads.  Same net: one section.  Different nets: the shortest
+     * chain through at most aMaxSeries series components.
+     */
+    bool PathBetweenPads( PAD* aStart, PAD* aEnd, int aMaxSeries, XSIGNAL& aSignal ) const;
+
+    /// All paths that pass through the given series components (Altium: "from connected nets")
+    std::vector<XSIGNAL_PROPOSAL> PathsThroughComponents( const std::vector<FOOTPRINT*>& aSeries,
+                                                          wxString* aSkipped = nullptr ) const;
+
+    /**
+     * All paths from the pads of aSource to pads of the destination components, directly or
+     * through up to aMaxSeries series components.
+     *
+     * @param aNets if not empty, only source pads in one of these nets (net codes) are used
+     */
+    std::vector<XSIGNAL_PROPOSAL> PathsBetweenComponents( FOOTPRINT* aSource,
+                                                          const std::set<FOOTPRINT*>& aDestinations,
+                                                          int aMaxSeries,
+                                                          const std::set<int>& aNets ) const;
+
+    /// A signal for a complete net, or a pad-to-pad signal if the net has exactly two pads
+    XSIGNAL SignalForNet( int aNetCode ) const;
+
+    static XSIGNAL_NODE NodeFor( const PAD* aPad );
+
+    /// Find the pad of a node (by uuid, then by reference and pad number)
+    PAD* ResolveNode( const XSIGNAL_NODE& aNode ) const;
+
+private:
+    struct SECTION_RESULT
+    {
+        bool                               routed = false;
+        int64_t                            track = 0;
+        int64_t                            via = 0;
+        int64_t                            padToDie = 0;
+        int64_t                            delay = 0;
+        int                                viaCount = 0;
+        std::vector<BOARD_CONNECTED_ITEM*> items;
+    };
+
+    SECTION_RESULT measureSection( PAD* aFrom, PAD* aTo ) const;
+    void           evaluate( std::vector<XSIGNAL_METRICS>& aMetrics ) const;
+    wxString       uniqueName( const wxString& aBase ) const;
+
+    BOARD*                     m_board;
+    std::vector<XSIGNAL>       m_signals;
+    std::vector<XSIGNAL_CLASS> m_classes;
+    wxString                   m_loadedFor;
+    bool                       m_modified = false;
+};
+
+#endif // XSIGNAL_H
