+#ifndef KICAD_WORKSPACE_H
+#define KICAD_WORKSPACE_H
+
+#include <vector>
+#include <wx/string.h>
+
+/// File extension of a workspace file (JSON).
+#define WORKSPACE_FILE_EXT wxS( "kicad_workspace" )
+
+/**
+ * Owner information read from a KiCad lock file (~name.ext.lck) without touching it.
+ */
+struct WS_LOCK_INFO
+{
+    bool     locked = false;   ///< a lock file exists
+    bool     mine = false;     ///< same user on this computer
+    bool     thisProcess = false; ///< held by the calling process
+    bool     stale = false;    ///< mine, but the owning process no longer exists
+    long     pid = 0;
+    wxString user;
+    wxString host;
+    wxString since;            ///< ISO date/time, may be empty (stock KiCad lock)
+    wxString app;              ///< may be empty (stock KiCad lock)
+
+    /// "user@host" or an empty string
+    wxString Owner() const;
+
+    bool operator==( const WS_LOCK_INFO& aOther ) const
+    {
+        return locked == aOther.locked && stale == aOther.stale && pid == aOther.pid
+               && user == aOther.user && host == aOther.host && since == aOther.since;
+    }
+
+    bool operator!=( const WS_LOCK_INFO& aOther ) const { return !( *this == aOther ); }
+};
+
+
+struct WS_FILE
+{
+    wxString     path;         ///< absolute path
+    WS_LOCK_INFO lock;
+};
+
+
+struct WS_PROJECT
+{
+    wxString             proFile;   ///< absolute path of the .kicad_pro file
+    bool                 exists = false;
+    WS_LOCK_INFO         lock;      ///< lock of the project file itself
+    std::vector<WS_FILE> files;     ///< schematics and boards found in the project folder
+};
+
+
+/**
+ * A list of KiCad projects that are shown together in the workspace pane.
+ *
+ * Stored as a small JSON document:
+ * { "version": 1, "projects": [ { "path": "relative/or/absolute.kicad_pro" }, ... ] }
+ * Paths are stored relative to the workspace file when the project lives below the
+ * workspace folder, absolute otherwise.
+ */
+class WORKSPACE
+{
+public:
+    bool Load( const wxString& aFileName );
+    bool Save() const;
+    bool SaveAs( const wxString& aFileName );
+
+    const wxString& GetFileName() const { return m_fileName; }
+    void SetFileName( const wxString& aFileName ) { m_fileName = aFileName; }
+
+    const std::vector<wxString>& GetProjects() const { return m_projects; }
+
+    bool Contains( const wxString& aProFile ) const;
+    bool AddProject( const wxString& aProFile );
+    bool RemoveProject( const wxString& aProFile );
+    void Clear() { m_projects.clear(); }
+
+    /// Normalize a project path so that the same project always compares equal.
+    static wxString Normalize( const wxString& aProFile );
+
+    /// Read the lock file belonging to \a aFile (does never create or modify anything).
+    static WS_LOCK_INFO ReadLockInfo( const wxString& aFile );
+
+    /**
+     * Collect files and lock states of all given projects.  Does only read from the file
+     * system and is safe to run in a worker thread.
+     */
+    static std::vector<WS_PROJECT> Scan( const std::vector<wxString>& aProjects );
+
+    /// Location of the workspace used when the user did not open or save one explicitly.
+    static wxString DefaultFileName();
+
+    /// Remember / recall the workspace that was in use when KiCad was closed.
+    static wxString LoadLastUsed();
+    static void     SaveLastUsed( const wxString& aFileName );
+
+private:
+    wxString              m_fileName;
+    std::vector<wxString> m_projects;
+};
+
+#endif // KICAD_WORKSPACE_H
