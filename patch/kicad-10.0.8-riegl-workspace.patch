+void XSIGNAL_PANEL::onReport( wxCommandEvent& aEvent )
+{
+    XSIGNAL_STORE* s = store();
+
+    if( !s || m_rows.empty() )
+    {
+        DisplayInfoMessage( m_frame, _( "There are no xSignals to report." ) );
+        return;
+    }
+
+    wxFileName fn( m_board->GetFileName() );
+    fn.SetName( fn.GetName() + wxS( "-xsignals" ) );
+    fn.SetExt( wxS( "csv" ) );
+
+    wxFileDialog dlg( m_frame, _( "Save xSignal Report" ), fn.GetPath(), fn.GetFullName(),
+                      _( "CSV files" ) + wxS( " (*.csv)|*.csv" ), wxFD_SAVE | wxFD_OVERWRITE_PROMPT );
+
+    if( dlg.ShowModal() != wxID_OK )
+        return;
+
+    auto quote = []( wxString aText )
+                 {
+                     aText.Replace( wxS( "\"" ), wxS( "\"\"" ) );
+                     return wxS( "\"" ) + aText + wxS( "\"" );
+                 };
+
+    wxString text;
+
+    for( int col = 0; col < COL_COUNT; ++col )
+    {
+        wxListItem item;
+        item.SetMask( wxLIST_MASK_TEXT );
+        m_signalList->GetColumn( col, item );
+        text += ( col ? wxS( ";" ) : wxS( "" ) ) + quote( item.GetText() );
+    }
+
+    text += wxS( ";" ) + quote( _( "Status" ) ) + wxS( "\n" );
+
+    for( size_t idx : m_rows )
+    {
+        for( int col = 0; col < COL_COUNT; ++col )
+            text += ( col ? wxS( ";" ) : wxS( "" ) ) + quote( cellText( idx, col ) );
+
+        wxString status;
+
+        switch( m_metrics[idx].m_Status )
+        {
+        case XSIGNAL_STATUS::MATCHED:        status = _( "OK" );         break;
+        case XSIGNAL_STATUS::TOO_SHORT: status = _( "too short" );  break;
+        case XSIGNAL_STATUS::TOO_LONG:  status = _( "too long" );   break;
+        case XSIGNAL_STATUS::UNROUTED:  status = _( "unrouted" );   break;
+        case XSIGNAL_STATUS::BROKEN:    status = _( "not found" );  break;
+        default:                                                    break;
+        }
+
+        text += wxS( ";" ) + quote( status ) + wxS( "\n" );
+    }
+
+    wxFFile file( dlg.GetPath(), wxS( "wb" ) );
+
+    // UTF-8 with byte order mark, so that spreadsheet programs detect the encoding
+    if( !file.IsOpened() || file.Write( "\xEF\xBB\xBF", 3 ) != 3 || !file.Write( text, wxConvUTF8 ) )
+    {
+        DisplayError( m_frame, wxString::Format( _( "Could not write file '%s'." ), dlg.GetPath() ) );
+    }
+}
