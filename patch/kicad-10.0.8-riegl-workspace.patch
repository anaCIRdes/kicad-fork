+// ---------------------------------------------------------------------------------------------
+// WS_WINDOW_INFO: the list a helper process publishes
+// ---------------------------------------------------------------------------------------------
+
+wxString WS_WINDOW_INFO::ReportFileName( const wxString& aCommandDir )
+{
+    return aCommandDir + wxFileName::GetPathSeparator() + wxS( "windows.json" );
+}
+
+
+bool WS_WINDOW_INFO::Write( const wxString& aCommandDir, const std::vector<WS_WINDOW_INFO>& aWindows )
+{
+    nlohmann::json j;
+    j["windows"] = nlohmann::json::array();
+
+    for( const WS_WINDOW_INFO& win : aWindows )
+    {
+        nlohmann::json entry;
+        entry["handle"] = win.handle;
+        entry["type"] = win.frameType;
+        entry["title"] = std::string( win.title.utf8_str() );
+        j["windows"].push_back( entry );
+    }
+
+    std::string text = j.dump();
+    wxString    target = ReportFileName( aCommandDir );
+    wxString    temp = target + wxS( ".tmp" );
+    wxLogNull   noLog;
+
+    {
+        wxFFile file( temp, wxS( "wb" ) );
+
+        if( !file.IsOpened() )
+            return false;
+
+        if( file.Write( text.data(), text.size() ) != text.size() )
+            return false;
+
+        file.Close();
+    }
+
+    // Rename so that the reader only ever sees complete files
+    return wxRenameFile( temp, target, true );
+}
+
+
+bool WS_WINDOW_INFO::Read( const wxString& aCommandDir, std::vector<WS_WINDOW_INFO>& aWindows )
+{
+    wxString  name = ReportFileName( aCommandDir );
+    wxLogNull noLog;
+
+    if( !wxFileName::FileExists( name ) )
+        return false;
+
+    wxFFile file( name, wxS( "rb" ) );
+
+    if( !file.IsOpened() )
+        return false;
+
+    wxFileOffset len = file.Length();
+
+    if( len <= 0 || len > 1024 * 1024 )
+        return false;
+
+    std::string text( static_cast<size_t>( len ), '\0' );
+
+    if( file.Read( text.data(), text.size() ) != text.size() )
+        return false;
+
+    try
+    {
+        nlohmann::json j = nlohmann::json::parse( text );
+
+        for( const nlohmann::json& entry : j.at( "windows" ) )
+        {
+            WS_WINDOW_INFO win;
+            win.handle = entry.value( "handle", 0ULL );
+            win.frameType = entry.value( "type", -1 );
+            win.title = wxString::FromUTF8( entry.value( "title", std::string() ) );
+
+            if( win.handle != 0 )
+                aWindows.push_back( win );
+        }
+    }
+    catch( const std::exception& )
+    {
+        return false;
+    }
+
+    return true;
+}
