+#include <xsignal/xsignal.h>
+
+/*
+    xSignal length test (RIEGL fork).  Checks the matched-length and absolute length
+    requirements of the xSignal classes of the board.
+
+    Errors generated:
+    - DRCE_LENGTH_OUT_OF_RANGE  (absolute limits of a class)
+    - DRCE_SKEW_OUT_OF_RANGE    (matched length within a class)
+*/
+
+class DRC_TEST_PROVIDER_XSIGNAL : public DRC_TEST_PROVIDER
+{
+public:
+    DRC_TEST_PROVIDER_XSIGNAL() {}
+
+    virtual ~DRC_TEST_PROVIDER_XSIGNAL() = default;
+
+    virtual bool Run() override;
+
+    virtual const wxString GetName() const override { return wxT( "xsignal_length" ); };
+};
+
+
+bool DRC_TEST_PROVIDER_XSIGNAL::Run()
+{
+    BOARD* board = m_drcEngine->GetBoard();
+
+    if( !board )
+        return true;
+
+    XSIGNAL_STORE* store = board->XSignals();
+
+    if( !store || store->Signals().empty() )
+        return true;
+
+    const bool testLength = !m_drcEngine->IsErrorLimitExceeded( DRCE_LENGTH_OUT_OF_RANGE );
+    const bool testSkew = !m_drcEngine->IsErrorLimitExceeded( DRCE_SKEW_OUT_OF_RANGE );
+
+    if( !testLength && !testSkew )
+        return true;
+
+    if( !reportPhase( _( "Checking xSignal lengths..." ) ) )
+        return false;
+
+    std::vector<XSIGNAL_METRICS> metrics = store->MeasureAll();
+
+    for( size_t ii = 0; ii < store->Signals().size(); ++ii )
+    {
+        if( m_drcEngine->IsCancelled() )
+            return false;
+
+        const XSIGNAL&         sig = store->Signals()[ii];
+        const XSIGNAL_METRICS& m = metrics[ii];
+
+        if( m.m_Status != XSIGNAL_STATUS::TOO_SHORT && m.m_Status != XSIGNAL_STATUS::TOO_LONG )
+            continue;
+
+        if( m.m_Pads.empty() )
+            continue;
+
+        XSIGNAL_CLASS* cls = store->FindClass( sig.m_Class );
+
+        if( !cls )
+            continue;
+
+        const int64_t length = m.SignalLength();
+        const bool    tooShort = m.m_Status == XSIGNAL_STATUS::TOO_SHORT;
+
+        // Which requirement is violated: the absolute limit of the class or the matching?
+        bool absolute = false;
+
+        if( tooShort && cls->m_MinLength > 0 && length < cls->m_MinLength )
+            absolute = true;
+
+        if( !tooShort && cls->m_MaxLength > 0 && length > cls->m_MaxLength )
+            absolute = true;
+
+        if( cls->m_Match == XSIGNAL_MATCH::NONE )
+            absolute = true;
+
+        if( absolute ? !testLength : !testSkew )
+            continue;
+
+        std::shared_ptr<DRC_ITEM> drcItem = DRC_ITEM::Create( absolute ? DRCE_LENGTH_OUT_OF_RANGE
+                                                                       : DRCE_SKEW_OUT_OF_RANGE );
+        wxString msg;
+
+        if( absolute )
+        {
+            if( tooShort )
+            {
+                msg.Printf( _( "(xSignal %s, class %s: min length %s; actual %s)" ),
+                            sig.m_Name, sig.m_Class,
+                            MessageTextFromValue( (double) cls->m_MinLength ),
+                            MessageTextFromValue( (double) length ) );
+            }
+            else
+            {
+                msg.Printf( _( "(xSignal %s, class %s: max length %s; actual %s)" ),
+                            sig.m_Name, sig.m_Class,
+                            MessageTextFromValue( (double) cls->m_MaxLength ),
+                            MessageTextFromValue( (double) length ) );
+            }
+        }
+        else
+        {
+            wxString reference = m.m_ReferenceName.IsEmpty() ? wxString( _( "fixed target" ) )
+                                                             : m.m_ReferenceName;
+
+            msg.Printf( _( "(xSignal %s, class %s: allowed %s to %s; actual %s; reference %s (%s), "
+                           "tolerance %s)" ),
+                        sig.m_Name, sig.m_Class,
+                        MessageTextFromValue( (double) m.m_WindowMin ),
+                        MessageTextFromValue( (double) m.m_WindowMax ),
+                        MessageTextFromValue( (double) length ),
+                        MessageTextFromValue( (double) m.m_ReferenceLength ),
+                        reference,
+                        MessageTextFromValue( (double) cls->m_Tolerance ) );
+        }
+
+        drcItem->SetErrorDetail( msg );
+
+        PAD* first = m.m_Pads.front();
+        PAD* last = m.m_Pads.back();
+
+        if( first != last )
+            drcItem->SetItems( first, last );
+        else
+            drcItem->SetItems( first );
+
+        reportViolation( drcItem, first->GetPosition(), first->GetPrincipalLayer() );
+    }
+
+    return !m_drcEngine->IsCancelled();
+}
+
+
+namespace detail
+{
+    static DRC_REGISTER_TEST_PROVIDER<DRC_TEST_PROVIDER_XSIGNAL> dummy;
+}
