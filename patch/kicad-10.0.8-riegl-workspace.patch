+
+void DIALOG_XSIGNAL_ADD::onClassChanged( wxCommandEvent& aEvent )
+{
+    // Show the requirement an existing class already has
+    if( XSIGNAL_CLASS* cls = m_store->FindClass( m_classCombo->GetValue() ) )
+    {
+        if( cls->m_Match == XSIGNAL_MATCH::LONGEST )
+        {
+            m_matchCheck->SetValue( true );
+            m_tolerance->SetValue( cls->m_Tolerance );
+            m_tolerance->Enable( true );
+        }
+    }
+}
+
+
+bool DIALOG_XSIGNAL_ADD::TransferDataFromWindow()
+{
+    wxString className = m_classCombo->GetValue().Trim().Trim( false );
+
+    if( m_matchCheck->GetValue() && className.IsEmpty() )
+    {
+        DisplayError( this, _( "Length matching needs a class. Enter a class name." ) );
+        return false;
+    }
+
+    if( m_matchCheck->GetValue() && m_tolerance->GetValue() < 0 )
+    {
+        DisplayError( this, _( "Lengths must not be negative." ) );
+        return false;
+    }
+
+    m_created.clear();
+
+    for( unsigned ii = 0; ii < m_list->GetCount() && ii < m_proposals.size(); ++ii )
+    {
+        if( !m_list->IsChecked( ii ) )
+            continue;
+
+        XSIGNAL sig = m_proposals[ii].m_Signal;
+        sig.m_Class = className;
+        m_created.push_back( m_store->AddSignal( sig ) );
+    }
+
+    if( m_created.empty() )
+    {
+        DisplayError( this, _( "No xSignal is selected." ) );
+        return false;
+    }
+
+    s_lastMatch = m_matchCheck->GetValue();
+
+    if( s_lastMatch )
+        s_lastTolerance = m_tolerance->GetValue();
+
+    if( m_matchCheck->GetValue() )
+    {
+        if( XSIGNAL_CLASS* cls = m_store->EnsureClass( className ) )
+        {
+            // Do not overwrite a different kind of matching the class already has
+            if( cls->m_Match == XSIGNAL_MATCH::NONE || cls->m_Match == XSIGNAL_MATCH::LONGEST )
+            {
+                cls->m_Match = XSIGNAL_MATCH::LONGEST;
+                cls->m_Tolerance = m_tolerance->GetValue();
+            }
+        }
+    }
+
+    m_store->SetModified();
+    return true;
+}
