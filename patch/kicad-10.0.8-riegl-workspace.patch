+
+bool WORKSPACE_PANE::isActiveProject( const wxString& aProFile ) const
+{
+    if( Prj().IsNullProject() )
+        return false;
+
+    wxString active = Prj().GetProjectFullName();
+
+    return !active.IsEmpty() && wxFileName( active ).SameAs( wxFileName( aProFile ) );
