+
+wxString XSIGNAL_PANEL::currentClassFilter( bool* aAll, bool* aNoClass ) const
+{
+    int sel = m_classList->GetSelection();
+
+    *aAll = sel == wxNOT_FOUND || sel == 0;
+    *aNoClass = sel == 1;
+
+    if( sel >= 2 && sel - 2 < (int) m_classEntries.size() )
+        return m_classEntries[sel - 2];
+
+    return wxEmptyString;
+}
+
+
+wxString XSIGNAL_PANEL::selectedClass() const
+{
+    bool all = false;
+    bool noClass = false;
+    return currentClassFilter( &all, &noClass );
+}
+
+
+static wxString ruleSummary( const XSIGNAL_CLASS& aClass,
+                             const std::function<wxString( int64_t )>& aLength )
+{
+    wxString text;
+
+    switch( aClass.m_Match )
+    {
+    case XSIGNAL_MATCH::LONGEST:
+        text = wxString::Format( _( "longest -%s" ), aLength( aClass.m_Tolerance ) );
+        break;
+
+    case XSIGNAL_MATCH::MEMBER:
+        text = aClass.m_Reference + wxS( " +/-" ) + aLength( aClass.m_Tolerance );
+        break;
+
+    case XSIGNAL_MATCH::TARGET:
+        text = aLength( aClass.m_Target ) + wxS( " +/-" ) + aLength( aClass.m_Tolerance );
+        break;
+
+    default:
+        break;
+    }
+
+    if( aClass.m_MinLength > 0 || aClass.m_MaxLength > 0 )
+    {
+        if( !text.IsEmpty() )
+            text += wxS( ", " );
+
+        if( aClass.m_MinLength > 0 && aClass.m_MaxLength > 0 )
+            text += aLength( aClass.m_MinLength ) + wxS( " ... " ) + aLength( aClass.m_MaxLength );
+        else if( aClass.m_MinLength > 0 )
+            text += wxS( ">= " ) + aLength( aClass.m_MinLength );
+        else
+            text += wxS( "<= " ) + aLength( aClass.m_MaxLength );
+    }
+
+    return text;
+}
+
+
+void XSIGNAL_PANEL::rebuildClassList()
+{
+    XSIGNAL_STORE* s = store();
+
+    if( !s )
+        return;
+
+    wxString previous = selectedClass();
+    int      previousIndex = m_classList->GetSelection();
+
+    m_inRebuild = true;
+    m_classList->Clear();
+    m_classEntries.clear();
+
+    size_t noClass = 0;
+
+    for( const XSIGNAL& sig : s->Signals() )
+    {
+        if( sig.m_Class.IsEmpty() )
+            noClass++;
+    }
+
+    m_classList->Append( wxString::Format( _( "<All xSignals>  (%d)" ), (int) s->Signals().size() ) );
+    m_classList->Append( wxString::Format( _( "<No class>  (%d)" ), (int) noClass ) );
+
+    std::vector<const XSIGNAL_CLASS*> classes;
+
+    for( const XSIGNAL_CLASS& cls : s->Classes() )
+        classes.push_back( &cls );
+
+    std::sort( classes.begin(), classes.end(),
+               []( const XSIGNAL_CLASS* a, const XSIGNAL_CLASS* b )
+               {
+                   return StrNumCmp( a->m_Name, b->m_Name, true ) < 0;
+               } );
+
+    auto fmt = [this]( int64_t aValue )
+               {
+                   return length( aValue );
+               };
+
+    int select = previousIndex == 1 ? 1 : 0;
+
+    for( const XSIGNAL_CLASS* cls : classes )
+    {
+        int members = 0;
+        int bad = 0;
+
+        for( size_t ii = 0; ii < s->Signals().size(); ++ii )
+        {
+            if( s->Signals()[ii].m_Class != cls->m_Name )
+                continue;
+
+            members++;
+
+            if( ii < m_metrics.size() && m_metrics[ii].m_Status != XSIGNAL_STATUS::MATCHED
+                && m_metrics[ii].m_Status != XSIGNAL_STATUS::NO_RULE )
+            {
+                bad++;
+            }
+        }
+
+        wxString label = wxString::Format( wxS( "%s  (%d)" ), cls->m_Name, members );
+        wxString rule = ruleSummary( *cls, fmt );
+
+        if( !rule.IsEmpty() )
+            label += wxS( "  [" ) + rule + wxS( "]" );
+
+        if( bad > 0 )
+            label = wxS( "! " ) + label;
+
+        m_classList->Append( label );
+        m_classEntries.push_back( cls->m_Name );
+
+        if( !previous.IsEmpty() && cls->m_Name == previous )
+            select = (int) m_classEntries.size() + 1;
+    }
+
+    m_classList->SetSelection( select );
+    m_inRebuild = false;
+}
+
+
+wxString XSIGNAL_PANEL::cellText( size_t aIndex, int aColumn ) const
+{
+    XSIGNAL_STORE* s = store();
+
+    if( !s || aIndex >= s->Signals().size() || aIndex >= m_metrics.size() )
+        return wxEmptyString;
+
+    const XSIGNAL&         sig = s->Signals()[aIndex];
+    const XSIGNAL_METRICS& m = m_metrics[aIndex];
+
+    switch( aColumn )
+    {
+    case COL_NAME:  return sig.m_Name;
+    case COL_CLASS: return sig.m_Class;
+    case COL_NODES: return wxString::Format( wxS( "%d" ), m.m_NodeCount );
+    case COL_PATH:  return m.m_Problem.IsEmpty() ? sig.Description()
+                                                 : sig.Description() + wxS( "  -  " ) + m.m_Problem;
+    default:        break;
+    }
+
+    if( !m.m_Resolved )
+        return aColumn == COL_MARGIN ? wxString( _( "not found" ) ) : wxString();
+
+    switch( aColumn )
+    {
+    case COL_LENGTH:
+        return length( m.SignalLength() );
+
+    case COL_MARGIN:
+        switch( m.m_Status )
+        {
+        case XSIGNAL_STATUS::UNROUTED:  return _( "unrouted" );
+        case XSIGNAL_STATUS::MATCHED:        return _( "OK" );
+        case XSIGNAL_STATUS::TOO_SHORT:
+        case XSIGNAL_STATUS::TOO_LONG:
+        {
+            wxString text = length( m.Margin() );
+            return m.Margin() > 0 ? wxS( "+" ) + text : text;
+        }
+        default:                        return wxEmptyString;
+        }
+
+    case COL_ALLOWED:
+        if( !m.m_HasWindow )
+            return wxEmptyString;
+
+        if( m.m_WindowMax == std::numeric_limits<int64_t>::max() )
+            return wxS( ">= " ) + length( m.m_WindowMin );
+
+        if( m.m_WindowMin <= 0 )
+            return wxS( "<= " ) + length( m.m_WindowMax );
+
+        return length( m.m_WindowMin ) + wxS( " ... " ) + length( m.m_WindowMax );
+
+    case COL_ROUTED:
+        return length( m.m_TrackLength );
+
+    case COL_VIAS:
+        if( m.m_ViaCount == 0 )
+            return wxS( "0" );
+
+        return wxString::Format( wxS( "%d / %s" ), m.m_ViaCount, length( m.m_ViaLength ) );
+
+    case COL_PAD_TO_DIE:
+        return m.m_PadToDie ? length( m.m_PadToDie ) : wxString();
+
+    case COL_UNROUTED:
+        return m.m_Unrouted ? length( m.m_Unrouted ) : wxString();
+
+    case COL_DELAY:
+        return m.m_Delay ? m_frame->MessageTextFromValue( static_cast<double>( m.m_Delay ), true,
+                                                          EDA_DATA_TYPE::TIME )
+                         : wxString();
+
+    default:
+        return wxEmptyString;
+    }
+}
+
+
+void XSIGNAL_PANEL::rebuildSignalList()
+{
+    XSIGNAL_STORE* s = store();
+
+    if( !s )
+        return;
+
+    std::vector<wxString> previous = selectedSignals();
+    std::set<wxString>    keep( previous.begin(), previous.end() );
+
+    bool     all = false;
+    bool     noClass = false;
+    wxString filter = currentClassFilter( &all, &noClass );
+
+    m_rows.clear();
+
+    for( size_t ii = 0; ii < s->Signals().size(); ++ii )
+    {
+        const XSIGNAL& sig = s->Signals()[ii];
+
+        if( all || ( noClass && sig.m_Class.IsEmpty() ) || ( !noClass && !all && sig.m_Class == filter ) )
+            m_rows.push_back( ii );
+    }
+
+    auto numeric = [this]( size_t aIndex, int aColumn ) -> double
+                   {
+                       const XSIGNAL_METRICS& m = m_metrics[aIndex];
+
+                       switch( aColumn )
+                       {
+                       case COL_NODES:      return m.m_NodeCount;
+                       case COL_LENGTH:     return static_cast<double>( m.SignalLength() );
+                       case COL_MARGIN:     return static_cast<double>( m.Margin() );
+                       case COL_ALLOWED:    return static_cast<double>( m.m_WindowMin );
+                       case COL_ROUTED:     return static_cast<double>( m.m_TrackLength );
+                       case COL_VIAS:       return m.m_ViaCount;
+                       case COL_PAD_TO_DIE: return static_cast<double>( m.m_PadToDie );
+                       case COL_UNROUTED:   return static_cast<double>( m.m_Unrouted );
+                       case COL_DELAY:      return static_cast<double>( m.m_Delay );
+                       default:             return 0.0;
+                       }
+                   };
+
+    const int  column = m_sortColumn;
+    const bool ascending = m_sortAscending;
+
+    std::stable_sort( m_rows.begin(), m_rows.end(),
+                      [&]( size_t a, size_t b )
+                      {
+                          int cmp = 0;
+
+                          if( column == COL_NAME || column == COL_CLASS || column == COL_PATH )
+                          {
+                              cmp = StrNumCmp( cellText( a, column ), cellText( b, column ), true );
+                          }
+                          else
+                          {
+                              double va = numeric( a, column );
+                              double vb = numeric( b, column );
+                              cmp = va < vb ? -1 : ( va > vb ? 1 : 0 );
+                          }
+
+                          if( cmp == 0 )
+                              cmp = StrNumCmp( cellText( a, COL_NAME ), cellText( b, COL_NAME ), true );
+
+                          return ascending ? cmp < 0 : cmp > 0;
+                      } );
+
+    m_inRebuild = true;
+    m_signalList->Freeze();
+    m_signalList->DeleteAllItems();
+
+    int tooShort = 0;
+    int tooLong = 0;
+    int unrouted = 0;
+    int broken = 0;
+
+    for( size_t row = 0; row < m_rows.size(); ++row )
+    {
+        const size_t           idx = m_rows[row];
+        const XSIGNAL_METRICS& m = m_metrics[idx];
+
+        long item = m_signalList->InsertItem( (long) row, cellText( idx, COL_NAME ) );
+
+        for( int col = 1; col < COL_COUNT; ++col )
+            m_signalList->SetItem( item, col, cellText( idx, col ) );
+
+        m_signalList->SetItemData( item, (long) idx );
+
+        // Same meaning as in Altium: yellow = too short, red = too long; green = within limits
+        switch( m.m_Status )
+        {
+        case XSIGNAL_STATUS::TOO_SHORT:
+            m_signalList->SetItemBackgroundColour( item, wxColour( 255, 236, 140 ) );
+            m_signalList->SetItemTextColour( item, *wxBLACK );
+            tooShort++;
+            break;
+
+        case XSIGNAL_STATUS::TOO_LONG:
+            m_signalList->SetItemBackgroundColour( item, wxColour( 255, 170, 170 ) );
+            m_signalList->SetItemTextColour( item, *wxBLACK );
+            tooLong++;
+            break;
+
+        case XSIGNAL_STATUS::MATCHED:
+            m_signalList->SetItemBackgroundColour( item, wxColour( 198, 236, 198 ) );
+            m_signalList->SetItemTextColour( item, *wxBLACK );
+            break;
+
+        case XSIGNAL_STATUS::UNROUTED:
+            m_signalList->SetItemBackgroundColour( item, wxColour( 224, 224, 224 ) );
+            m_signalList->SetItemTextColour( item, *wxBLACK );
+            unrouted++;
+            break;
+
+        case XSIGNAL_STATUS::BROKEN:
+            m_signalList->SetItemTextColour( item, wxColour( 200, 0, 0 ) );
+            broken++;
+            break;
+
+        default:
+            break;
+        }
+
+        // Set the state explicitly: some platforms select the first row of a refilled list
+        m_signalList->SetItemState( item, keep.count( cellText( idx, COL_NAME ) ) ? wxLIST_STATE_SELECTED : 0,
+                                    wxLIST_STATE_SELECTED );
+    }
+
+    m_signalList->Thaw();
+    m_inRebuild = false;
+
+    wxString summary = wxString::Format( _( "%d xSignals" ), (int) m_rows.size() );
+
+    if( tooShort )
+        summary += wxString::Format( _( ", %d too short" ), tooShort );
+
+    if( tooLong )
+        summary += wxString::Format( _( ", %d too long" ), tooLong );
+
+    if( unrouted )
+        summary += wxString::Format( _( ", %d unrouted" ), unrouted );
+
+    if( broken )
+        summary += wxString::Format( _( ", %d not found" ), broken );
+
+    m_summary->SetLabel( summary );
+}
+
+
+std::vector<wxString> XSIGNAL_PANEL::selectedSignals() const
+{
+    std::vector<wxString> names;
+    XSIGNAL_STORE*        s = store();
+
+    if( !s )
+        return names;
+
+    long item = -1;
+
+    while( ( item = m_signalList->GetNextItem( item, wxLIST_NEXT_ALL, wxLIST_STATE_SELECTED ) ) != -1 )
+    {
+        if( item >= 0 && item < (long) m_rows.size() && m_rows[item] < s->Signals().size() )
+            names.push_back( s->Signals()[m_rows[item]].m_Name );
+    }
+
+    return names;
+}
+
+
+void XSIGNAL_PANEL::updateDetails()
+{
+    XSIGNAL_STORE*        s = store();
+    std::vector<wxString> names = selectedSignals();
+
+    if( !s || names.empty() )
+    {
+        m_details->SetLabel( _( "Select an xSignal to highlight it on the board. Double-click zooms to it." ) );
+        m_details->SetToolTip( wxEmptyString );
+        return;
+    }
+
+    if( names.size() > 1 )
+    {
+        m_details->SetLabel( wxString::Format( _( "%d xSignals selected" ), (int) names.size() ) );
+        m_details->SetToolTip( wxEmptyString );
+        return;
+    }
+
+    for( size_t ii = 0; ii < s->Signals().size() && ii < m_metrics.size(); ++ii )
+    {
+        const XSIGNAL& sig = s->Signals()[ii];
+
+        if( sig.m_Name != names[0] )
+            continue;
+
+        const XSIGNAL_METRICS& m = m_metrics[ii];
+        wxString               text = sig.m_Name + wxS( ":  " ) + sig.Description();
+
+        if( !m.m_Problem.IsEmpty() )
+        {
+            text += wxS( "  -  " ) + m.m_Problem;
+        }
+        else
+        {
+            text += wxString::Format( _( "  -  %s (tracks %s, vias %s, pad to die %s)" ),
+                                      length( m.SignalLength() ), length( m.m_TrackLength ),
+                                      length( m.m_ViaLength ), length( m.m_PadToDie ) );
+        }
+
+        if( m.m_HasWindow )
+        {
+            text += wxS( "  -  " ) + wxString::Format( _( "allowed %s" ), cellText( ii, COL_ALLOWED ) );
+
+            if( !m.m_ReferenceName.IsEmpty() )
+            {
+                text += wxString::Format( _( " (reference %s, %s)" ), m.m_ReferenceName,
+                                          length( m.m_ReferenceLength ) );
+            }
+
+            if( m.m_Status == XSIGNAL_STATUS::TOO_SHORT )
+                text += wxS( ":  " ) + wxString::Format( _( "%s too short" ), length( -m.Margin() ) );
+            else if( m.m_Status == XSIGNAL_STATUS::TOO_LONG )
+                text += wxS( ":  " ) + wxString::Format( _( "%s too long" ), length( m.Margin() ) );
+        }
+
+        m_details->SetLabel( text );
+        m_details->SetToolTip( text );
+        return;
+    }
+}
+
+
+void XSIGNAL_PANEL::selectOnBoard( bool aZoom )
+{
+    XSIGNAL_STORE*        s = store();
+    std::vector<wxString> names = selectedSignals();
+
+    if( !s || names.empty() || m_dirty )
+        return;
+
+    std::set<wxString> wanted( names.begin(), names.end() );
+    EDA_ITEMS          items;
+    std::set<EDA_ITEM*> seen;
+
+    for( size_t ii = 0; ii < s->Signals().size() && ii < m_metrics.size(); ++ii )
+    {
+        if( !wanted.count( s->Signals()[ii].m_Name ) )
+            continue;
+
+        for( BOARD_CONNECTED_ITEM* item : m_metrics[ii].m_Items )
+        {
+            if( seen.insert( item ).second )
+                items.push_back( item );
+        }
+
+        for( PAD* pad : m_metrics[ii].m_Pads )
+        {
+            if( seen.insert( pad ).second )
+                items.push_back( pad );
+        }
+    }
+
+    TOOL_MANAGER* mgr = m_frame->GetToolManager();
+
+    mgr->RunAction( ACTIONS::selectionClear );
+
+    if( !items.empty() )
+    {
+        mgr->RunAction<EDA_ITEMS*>( ACTIONS::selectItems, &items );
+
+        if( aZoom )
+            mgr->RunAction( ACTIONS::zoomFitSelection );
+    }
+
+    m_frame->GetCanvas()->Refresh();
+}
+
+
+void XSIGNAL_PANEL::ShowSignals( const std::vector<wxString>& aNames )
+{
+    RefreshNow();
+
+    if( aNames.empty() )
+        return;
+
+    m_inRebuild = true;
+    m_classList->SetSelection( 0 );
+    m_inRebuild = false;
+    rebuildSignalList();
+
+    std::set<wxString> wanted( aNames.begin(), aNames.end() );
+    XSIGNAL_STORE*     s = store();
+    long               first = -1;
+
+    m_inRebuild = true;
+
+    for( long row = 0; row < (long) m_rows.size(); ++row )
+    {
+        bool select = s && wanted.count( s->Signals()[m_rows[row]].m_Name );
+
+        m_signalList->SetItemState( row, select ? wxLIST_STATE_SELECTED : 0, wxLIST_STATE_SELECTED );
+
+        if( select && first < 0 )
+            first = row;
+    }
+
+    m_inRebuild = false;
+
+    if( first >= 0 )
+        m_signalList->EnsureVisible( first );
+
+    updateDetails();
+    selectOnBoard( false );
+}
