+void XSIGNAL_PANEL::onSignalContextMenu( wxListEvent& aEvent )
+{
+    XSIGNAL_STORE*        s = store();
+    std::vector<wxString> names = selectedSignals();
+
+    if( !s || names.empty() )
+        return;
+
+    wxMenu menu;
+    menu.Append( ID_XS_ZOOM, _( "Zoom to xSignal" ) );
+    menu.Append( ID_XS_RENAME, _( "Rename..." ) )->Enable( names.size() == 1 );
+
+    wxMenu* classMenu = new wxMenu;
+    classMenu->Append( ID_XS_MOVE_NONE, _( "<No class>" ) );
+
+    std::vector<wxString> classNames;
+
+    for( const XSIGNAL_CLASS& cls : s->Classes() )
+        classNames.push_back( cls.m_Name );
+
+    std::sort( classNames.begin(), classNames.end(),
+               []( const wxString& a, const wxString& b )
+               {
+                   return StrNumCmp( a, b, true ) < 0;
+               } );
+
+    for( size_t ii = 0; ii < classNames.size(); ++ii )
+        classMenu->Append( ID_XS_MOVE_FIRST + (int) ii, classNames[ii] );
+
+    classMenu->AppendSeparator();
+    classMenu->Append( ID_XS_MOVE_NEW, _( "New Class..." ) );
+    menu.AppendSubMenu( classMenu, _( "Move to Class" ) );
+
+    menu.AppendSeparator();
+    menu.Append( ID_XS_DELETE, _( "Delete" ) );
+
+    int id = GetPopupMenuSelectionFromUser( menu );
+
+    if( id == ID_XS_ZOOM )
+    {
+        selectOnBoard( true );
+    }
+    else if( id == ID_XS_RENAME )
+    {
+        renameSelectedSignal();
+    }
+    else if( id == ID_XS_DELETE )
+    {
+        deleteSelectedSignals();
+    }
+    else if( id == ID_XS_MOVE_NONE )
+    {
+        moveSelectedToClass( wxEmptyString );
+    }
+    else if( id == ID_XS_MOVE_NEW )
+    {
+        DIALOG_XSIGNAL_CLASS dlg( m_frame, s, wxEmptyString );
+
+        if( dlg.ShowModal() == wxID_OK )
+            moveSelectedToClass( dlg.ResultName() );
+    }
+    else if( id >= ID_XS_MOVE_FIRST && id < ID_XS_MOVE_FIRST + (int) classNames.size() )
+    {
+        moveSelectedToClass( classNames[id - ID_XS_MOVE_FIRST] );
+    }
+}
