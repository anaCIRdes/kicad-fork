+
+WORKSPACE_DOCK::WORKSPACE_DOCK( KICAD_MANAGER_FRAME* aFrame, wxAuiNotebook* aNotebook,
+                                WORKSPACE_PANE* aPane ) :
+        m_frame( aFrame ),
+        m_notebook( aNotebook ),
+        m_pane( aPane ),
+        m_timer( this ),
+        m_tabbed( false ),
+        m_inRefresh( false ),
+        m_pendingFrameType( -1 ),
+        m_pendingTicks( 0 )
+{
+    m_tabbed = IsAvailable() && WORKSPACE::LoadOption( "editor_tabs", true );
+
+    Bind( wxEVT_TIMER, &WORKSPACE_DOCK::onTimer, this, m_timer.GetId() );
+
+    m_notebook->Bind( wxEVT_AUINOTEBOOK_PAGE_CHANGED, &WORKSPACE_DOCK::onPageChanged, this );
+    m_notebook->Bind( wxEVT_AUINOTEBOOK_TAB_RIGHT_UP, &WORKSPACE_DOCK::onTabRightUp, this );
+    m_frame->Bind( wxEVT_MOVE, &WORKSPACE_DOCK::onFrameMove, this );
+
+    m_timer.Start( DOCK_TIMER_MS );
+}
+
+
+WORKSPACE_DOCK::~WORKSPACE_DOCK()
+{
+    m_timer.Stop();
+
+    m_notebook->Unbind( wxEVT_AUINOTEBOOK_PAGE_CHANGED, &WORKSPACE_DOCK::onPageChanged, this );
+    m_notebook->Unbind( wxEVT_AUINOTEBOOK_TAB_RIGHT_UP, &WORKSPACE_DOCK::onTabRightUp, this );
+    m_frame->Unbind( wxEVT_MOVE, &WORKSPACE_DOCK::onFrameMove, this );
+
+    // Never leave a frame of a helper process behind without title bar
+    for( WS_DOC_PAGE* page : m_pages )
+        WINDOW_EMBED::Detach( page->m_info.handle );
+}
+
+
+bool WORKSPACE_DOCK::IsAvailable() const
+{
+    return WINDOW_EMBED::IsSupported();
+}
+
+
+void WORKSPACE_DOCK::SetTabbed( bool aTabbed )
+{
+    aTabbed = aTabbed && IsAvailable();
+
+    if( aTabbed == m_tabbed )
+        return;
+
+    m_tabbed = aTabbed;
+    WORKSPACE::SaveOption( "editor_tabs", m_tabbed );
+    m_floating.clear();
+
+    if( !m_tabbed )
+    {
+        std::vector<WS_DOC_PAGE*> pages = m_pages;
+
+        for( WS_DOC_PAGE* page : pages )
+            removePage( page, true );
+    }
+
+    refreshWindows();
+    Sync();
+}
+
+
+void WORKSPACE_DOCK::ReleaseAll()
+{
+    m_timer.Stop();
+
+    std::vector<WS_DOC_PAGE*> pages = m_pages;
+
+    for( WS_DOC_PAGE* page : pages )
+        removePage( page, true );
+}
+
+
+bool WORKSPACE_DOCK::OwnsPage( wxWindow* aPage ) const
+{
+    for( WS_DOC_PAGE* page : m_pages )
+    {
+        if( page == aPage )
+            return true;
+    }
+
+    return false;
+}
+
+
+void WORKSPACE_DOCK::RequestClosePage( wxWindow* aPage )
+{
+    if( !OwnsPage( aPage ) )
+        return;
+
+    WS_DOC_PAGE* page = static_cast<WS_DOC_PAGE*>( aPage );
+
+    // Closing may ask to save changes, so the frame has to be visible and in front
+    selectPage( page );
+
+    if( page->m_info.inProcess )
+        m_frame->CloseEditorWindow( page->m_info.frameType );
+    else
+        m_pane->SendChildCommand( page->m_info.proFile, wxString::Format( wxS( "close:%d" ), page->m_info.frameType ) );
+}
+
+
+void WORKSPACE_DOCK::ShowChangedLanguage()
+{
+    for( WS_DOC_PAGE* page : m_pages )
+        updateLabel( page );
+}
