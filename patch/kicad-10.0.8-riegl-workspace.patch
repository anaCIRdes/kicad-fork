+
+wxString XSIGNAL_PANEL::length( int64_t aValue ) const
+{
+    return m_frame->MessageTextFromValue( static_cast<double>( aValue ) );
+}
+
+
+void XSIGNAL_PANEL::RefreshNow()
+{
+    m_board = m_frame->GetBoard();
+    m_dirty = false;
+
+    XSIGNAL_STORE* s = store();
+
+    if( !s )
+    {
+        m_metrics.clear();
+        m_classList->Clear();
+        m_signalList->DeleteAllItems();
+        return;
+    }
+
+    m_metrics = s->MeasureAll();
+
+    rebuildClassList();
+    rebuildSignalList();
+    updateDetails();
