+void XSIGNAL_PANEL::editClass( const wxString& aName )
+{
+    XSIGNAL_STORE* s = store();
+
+    if( !s || !s->FindClass( aName ) )
+        return;
+
+    DIALOG_XSIGNAL_CLASS dlg( m_frame, s, aName );
+
+    if( dlg.ShowModal() == wxID_OK )
+    {
+        // Keep the (possibly renamed) class selected
+        m_classEntries.clear();
+        modified();
+
+        for( size_t ii = 0; ii < m_classEntries.size(); ++ii )
+        {
+            if( m_classEntries[ii] == dlg.ResultName() )
+            {
+                m_classList->SetSelection( (int) ii + 2 );
+                rebuildSignalList();
+                break;
+            }
+        }
+    }
+}
+
+
+void XSIGNAL_PANEL::deleteClass( const wxString& aName )
+{
+    XSIGNAL_STORE* s = store();
+
+    if( !s || !s->FindClass( aName ) )
+        return;
+
+    int members = 0;
+
+    for( const XSIGNAL& sig : s->Signals() )
+    {
+        if( sig.m_Class == aName )
+            members++;
+    }
+
+    bool removeMembers = false;
+
+    if( members > 0 )
+    {
+        wxMessageDialog dlg( m_frame,
+                             wxString::Format( _( "Class '%s' has %d xSignals. Delete them together "
+                                                  "with the class?" ),
+                                               aName, members ),
+                             _( "Delete xSignal Class" ), wxYES_NO | wxCANCEL | wxICON_QUESTION );
+
+        dlg.SetYesNoLabels( _( "Delete xSignals too" ), _( "Keep xSignals" ) );
+
+        int answer = dlg.ShowModal();
+
+        if( answer == wxID_CANCEL )
+            return;
+
+        removeMembers = answer == wxID_YES;
+    }
+
+    s->RemoveClass( aName, removeMembers );
+    modified();
+}
+
+
+void XSIGNAL_PANEL::deleteSelectedSignals()
+{
+    XSIGNAL_STORE*        s = store();
+    std::vector<wxString> names = selectedSignals();
+
+    if( !s || names.empty() )
+        return;
+
+    if( names.size() > 1
+        && !IsOK( m_frame, wxString::Format( _( "Delete %d xSignals?" ), (int) names.size() ) ) )
+    {
+        return;
+    }
+
+    for( const wxString& name : names )
+        s->RemoveSignal( name );
+
+    modified();
+}
+
+
+void XSIGNAL_PANEL::renameSelectedSignal()
+{
+    XSIGNAL_STORE*        s = store();
+    std::vector<wxString> names = selectedSignals();
+
+    if( !s || names.size() != 1 )
+        return;
+
+    wxTextEntryDialog dlg( m_frame, _( "New name:" ), _( "Rename xSignal" ), names[0] );
+
+    if( dlg.ShowModal() != wxID_OK )
+        return;
+
+    wxString name = dlg.GetValue().Trim().Trim( false );
+
+    if( name == names[0] )
+        return;
+
+    if( !s->RenameSignal( names[0], name ) )
+    {
+        DisplayError( m_frame, wxString::Format( _( "The name '%s' is empty or already in use." ), name ) );
+        return;
+    }
+
+    modified();
+    ShowSignals( { name } );
+}
+
+
+void XSIGNAL_PANEL::moveSelectedToClass( const wxString& aClass )
+{
+    XSIGNAL_STORE*        s = store();
+    std::vector<wxString> names = selectedSignals();
+
+    if( !s || names.empty() )
+        return;
+
+    if( !aClass.IsEmpty() )
+        s->EnsureClass( aClass );
+
+    for( const wxString& name : names )
+    {
+        if( XSIGNAL* sig = s->FindSignal( name ) )
+            sig->m_Class = aClass;
+    }
+
+    modified();
+}
