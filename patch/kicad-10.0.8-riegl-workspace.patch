+// ---------------------------------------------------------------------------------------------
+
+/// Remembered for the next use of the dialog in this session
+static bool    s_lastMatch = false;
+static int64_t s_lastTolerance = pcbIUScale.mmToIU( 0.5 );
+static int     s_lastSeries = 1;
+
+DIALOG_XSIGNAL_ADD::DIALOG_XSIGNAL_ADD( PCB_EDIT_FRAME* aFrame, XSIGNAL_STORE* aStore,
+                                        const std::vector<XSIGNAL_PROPOSAL>& aProposals,
+                                        const wxString& aTitle ) :
+        DIALOG_SHIM( aFrame, wxID_ANY, aTitle, wxDefaultPosition, wxDefaultSize,
+                     wxDEFAULT_DIALOG_STYLE | wxRESIZE_BORDER ),
+        m_frame( aFrame ),
+        m_store( aStore ),
+        m_proposals( aProposals )
+{
+    // The list depends on the board; matching and tolerance are remembered below instead
+    OptOut( this );
+
+    wxBoxSizer* mainSizer = new wxBoxSizer( wxVERTICAL );
+
+    mainSizer->Add( new wxStaticText( this, wxID_ANY, _( "xSignals to create:" ) ), 0,
+                    wxLEFT | wxRIGHT | wxTOP, 10 );
+
+    // Give every proposal its final name now, so that the list shows what will be created
+    XSIGNAL_STORE scratch( aStore->GetBoard() );
+    scratch.Signals() = aStore->Signals();
+
+    wxArrayString items;
+
+    for( XSIGNAL_PROPOSAL& proposal : m_proposals )
+    {
+        if( proposal.m_Signal.m_Name.IsEmpty() )
+            proposal.m_Signal.m_Name = scratch.MakeName( proposal.m_Signal );
+
+        proposal.m_Signal.m_Name = scratch.AddSignal( proposal.m_Signal );
+
+        items.Add( proposal.m_Signal.m_Name + wxS( "    " ) + proposal.m_Signal.Description() );
+    }
+
+    m_list = new wxCheckListBox( this, wxID_ANY, wxDefaultPosition, FromDIP( wxSize( 520, 260 ) ), items );
+
+    for( unsigned ii = 0; ii < m_list->GetCount(); ++ii )
+        m_list->Check( ii, true );
+
+    mainSizer->Add( m_list, 1, wxEXPAND | wxALL, 10 );
+
+    wxBoxSizer* listButtons = new wxBoxSizer( wxHORIZONTAL );
+    wxButton*   all = new wxButton( this, wxID_ANY, _( "Select All" ) );
+    wxButton*   none = new wxButton( this, wxID_ANY, _( "Select None" ) );
+    m_count = new wxStaticText( this, wxID_ANY, wxEmptyString );
+    listButtons->Add( all, 0, wxRIGHT, 5 );
+    listButtons->Add( none, 0, wxRIGHT, 15 );
+    listButtons->Add( m_count, 1, wxALIGN_CENTER_VERTICAL );
+    mainSizer->Add( listButtons, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 10 );
+
+    wxFlexGridSizer* grid = new wxFlexGridSizer( 0, 3, 6, 0 );
+    grid->AddGrowableCol( 1, 1 );
+
+    grid->Add( new wxStaticText( this, wxID_ANY, _( "Add to class:" ) ), 0,
+               wxALIGN_CENTER_VERTICAL | wxRIGHT, 5 );
+    m_classCombo = new wxComboBox( this, wxID_ANY );
+    m_classCombo->Append( wxEmptyString );
+
+    for( const XSIGNAL_CLASS& cls : aStore->Classes() )
+        m_classCombo->Append( cls.m_Name );
+
+    m_classCombo->SetToolTip( _( "Choose an existing class or type a new name. Leave empty to "
+                                 "create the xSignals without a class." ) );
+    grid->Add( m_classCombo, 1, wxEXPAND );
+    grid->AddSpacer( 0 );
+
+    m_matchCheck = new wxCheckBox( this, wxID_ANY, _( "Match the lengths in this class" ) );
+    m_matchCheck->SetToolTip( _( "Every member of the class must be at most the tolerance shorter "
+                                 "than the longest member." ) );
+    grid->AddSpacer( 0 );
+    grid->Add( m_matchCheck, 0, wxALIGN_CENTER_VERTICAL );
+    grid->AddSpacer( 0 );
+
+    m_tolerance = addLengthRow( aFrame, this, grid, _( "Tolerance:" ) );
+    m_tolerance->SetValue( s_lastTolerance );
+    m_matchCheck->SetValue( s_lastMatch );
+    m_tolerance->Enable( s_lastMatch );
+
+    mainSizer->Add( grid, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 10 );
+
+    wxStdDialogButtonSizer* buttons = new wxStdDialogButtonSizer();
+    buttons->AddButton( new wxButton( this, wxID_OK ) );
+    buttons->AddButton( new wxButton( this, wxID_CANCEL ) );
+    buttons->Realize();
+    mainSizer->Add( buttons, 0, wxEXPAND | wxALL, 5 );
+
+    SetSizer( mainSizer );
+
+    all->Bind( wxEVT_BUTTON, &DIALOG_XSIGNAL_ADD::onCheckAll, this );
+    none->Bind( wxEVT_BUTTON, &DIALOG_XSIGNAL_ADD::onCheckNone, this );
+    m_matchCheck->Bind( wxEVT_CHECKBOX, &DIALOG_XSIGNAL_ADD::onMatchToggle, this );
+    m_classCombo->Bind( wxEVT_COMBOBOX, &DIALOG_XSIGNAL_ADD::onClassChanged, this );
+    m_list->Bind( wxEVT_CHECKLISTBOX,
+                  [this]( wxCommandEvent& )
+                  {
+                      updateCount();
+                  } );
+
+    updateCount();
+    SetupStandardButtons( { { wxID_OK, _( "Create" ) } } );
+    SetInitialFocus( m_classCombo );
+    finishDialogSettings();
+}
