+void DIALOG_XSIGNAL_ADD::updateCount()
+{
+    unsigned checked = 0;
+
+    for( unsigned ii = 0; ii < m_list->GetCount(); ++ii )
+    {
+        if( m_list->IsChecked( ii ) )
+            checked++;
+    }
+
+    m_count->SetLabel( wxString::Format( _( "%u of %u selected" ), checked, m_list->GetCount() ) );
+}
