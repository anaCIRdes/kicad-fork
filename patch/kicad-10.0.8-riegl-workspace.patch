+
+/// Nets with more pads than this are treated as supply nets by the automatic path searches
+static const size_t XSIGNAL_MAX_NET_PADS = 12;
+
+/// Upper limit for the number of paths one analysis may return
+static const size_t XSIGNAL_MAX_PROPOSALS = 5000;
+
+
+XSIGNAL_STORE* BOARD::XSignals() const
+{
+    if( !m_xsignals )
+        m_xsignals = std::make_shared<XSIGNAL_STORE>( const_cast<BOARD*>( this ) );
+
+    // The file name of a board is only known after it was loaded, so the side-car file is read
+    // on first use.  Never discard unsaved edits.
+    if( m_xsignals->LoadedFor() != GetFileName() && !m_xsignals->IsModified() )
+        m_xsignals->Load( GetFileName() );
+
+    return m_xsignals.get();
+}
+
+
+wxString XSIGNAL::Description() const
+{
+    if( m_WholeNet )
+        return m_Net;
+
+    wxString text;
+
+    for( size_t ii = 0; ii < m_Nodes.size(); ++ii )
+    {
+        if( ii == 0 || ii + 1 == m_Nodes.size() )
+        {
+            if( !text.IsEmpty() )
+                text += wxS( " > " );
+
+            text += m_Nodes[ii].Label();
+        }
+        else if( ii % 2 == 1 )
+        {
+            // a series component: show its reference once
+            text += wxS( " > " ) + m_Nodes[ii].m_Ref;
+        }
+    }
+
+    return text;
+}
+
+
+int64_t XSIGNAL_METRICS::Margin() const
+{
+    if( !m_HasWindow )
+        return 0;
+
+    int64_t len = SignalLength();
+
+    if( len < m_WindowMin )
+        return len - m_WindowMin;
+
+    if( len > m_WindowMax )
+        return len - m_WindowMax;
+
+    return 0;
+}
+
+
+XSIGNAL_STORE::XSIGNAL_STORE( BOARD* aBoard ) :
+        m_board( aBoard )
+{
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// Persistence
+// ---------------------------------------------------------------------------------------------
+
+wxString XSIGNAL_STORE::FileNameFor( const wxString& aBoardFileName )
+{
+    if( aBoardFileName.IsEmpty() )
+        return wxEmptyString;
+
+    wxFileName fn( aBoardFileName );
+    fn.SetExt( wxS( "kicad_xsignals" ) );
+    return fn.GetFullPath();
+}
+
+
+static std::string toUtf8( const wxString& aText )
+{
+    return std::string( aText.utf8_str() );
+}
+
+
+static wxString fromUtf8( const std::string& aText )
+{
+    return wxString::FromUTF8( aText.c_str() );
+}
+
+
+static const char* matchToString( XSIGNAL_MATCH aMatch )
+{
+    switch( aMatch )
+    {
+    case XSIGNAL_MATCH::LONGEST: return "longest";
+    case XSIGNAL_MATCH::MEMBER:  return "member";
+    case XSIGNAL_MATCH::TARGET:   return "fixed";
+    default:                     return "none";
+    }
+}
+
+
+static XSIGNAL_MATCH matchFromString( const std::string& aText )
+{
+    if( aText == "longest" )
+        return XSIGNAL_MATCH::LONGEST;
+
+    if( aText == "member" )
+        return XSIGNAL_MATCH::MEMBER;
+
+    if( aText == "fixed" )
+        return XSIGNAL_MATCH::TARGET;
+
+    return XSIGNAL_MATCH::NONE;
+}
+
+
+static double iuToMm( int64_t aValue )
+{
+    return static_cast<double>( aValue ) / pcbIUScale.IU_PER_MM;
+}
+
+
+static int64_t mmToIu( double aValue )
+{
+    return static_cast<int64_t>( std::llround( aValue * pcbIUScale.IU_PER_MM ) );
+}
+
+
+bool XSIGNAL_STORE::Load( const wxString& aBoardFileName )
+{
+    m_signals.clear();
+    m_classes.clear();
+    m_loadedFor = aBoardFileName;
+    m_modified = false;
+
+    wxString fileName = FileNameFor( aBoardFileName );
+
+    if( fileName.IsEmpty() || !wxFileName::FileExists( fileName ) )
+        return true;
+
+    wxFFile file( fileName, wxS( "rb" ) );
+    wxString content;
+
+    if( !file.IsOpened() || !file.ReadAll( &content, wxConvUTF8 ) )
+        return false;
+
+    try
+    {
+        nlohmann::json j = nlohmann::json::parse( toUtf8( content ) );
+
+        if( j.contains( "classes" ) )
+        {
+            for( const nlohmann::json& entry : j.at( "classes" ) )
+            {
+                XSIGNAL_CLASS cls;
+                cls.m_Name = fromUtf8( entry.value( "name", std::string() ) );
+                cls.m_Match = matchFromString( entry.value( "match", std::string( "none" ) ) );
+                cls.m_Tolerance = mmToIu( entry.value( "tolerance_mm", 0.0 ) );
+                cls.m_Reference = fromUtf8( entry.value( "reference", std::string() ) );
+                cls.m_Target = mmToIu( entry.value( "target_mm", 0.0 ) );
+                cls.m_MinLength = mmToIu( entry.value( "min_mm", 0.0 ) );
+                cls.m_MaxLength = mmToIu( entry.value( "max_mm", 0.0 ) );
+
+                if( !cls.m_Name.IsEmpty() && !FindClass( cls.m_Name ) )
+                    m_classes.push_back( cls );
+            }
+        }
+
+        if( j.contains( "xsignals" ) )
+        {
+            for( const nlohmann::json& entry : j.at( "xsignals" ) )
+            {
+                XSIGNAL sig;
+                sig.m_Name = fromUtf8( entry.value( "name", std::string() ) );
+                sig.m_Class = fromUtf8( entry.value( "class", std::string() ) );
+                sig.m_WholeNet = entry.value( "whole_net", false );
+                sig.m_Net = fromUtf8( entry.value( "net", std::string() ) );
+
+                if( entry.contains( "nodes" ) )
+                {
+                    for( const nlohmann::json& n : entry.at( "nodes" ) )
+                    {
+                        XSIGNAL_NODE node;
+                        node.m_Ref = fromUtf8( n.value( "ref", std::string() ) );
+                        node.m_Pad = fromUtf8( n.value( "pad", std::string() ) );
+
+                        std::string uuid = n.value( "uuid", std::string() );
+                        node.m_Uuid = uuid.empty() ? niluuid : KIID( uuid );
+                        sig.m_Nodes.push_back( node );
+                    }
+                }
+
+                if( sig.m_Name.IsEmpty() || FindSignal( sig.m_Name ) )
+                    continue;
+
+                if( !sig.m_Class.IsEmpty() )
+                    EnsureClass( sig.m_Class );
+
+                m_signals.push_back( sig );
+            }
+        }
+    }
+    catch( const std::exception& )
+    {
+        m_signals.clear();
+        m_classes.clear();
+        return false;
+    }
+
+    m_modified = false;
+    return true;
+}
+
+
+bool XSIGNAL_STORE::Save( const wxString& aBoardFileName )
+{
+    wxString fileName = FileNameFor( aBoardFileName );
+
+    if( fileName.IsEmpty() )
+        return false;
+
+    if( m_signals.empty() && m_classes.empty() )
+    {
+        if( wxFileName::FileExists( fileName ) )
+            wxRemoveFile( fileName );
+
+        m_loadedFor = aBoardFileName;
+        m_modified = false;
+        return true;
+    }
+
+    nlohmann::json j;
+    j["version"] = 1;
+    j["classes"] = nlohmann::json::array();
+    j["xsignals"] = nlohmann::json::array();
+
+    for( const XSIGNAL_CLASS& cls : m_classes )
+    {
+        nlohmann::json entry;
+        entry["name"] = toUtf8( cls.m_Name );
+        entry["match"] = matchToString( cls.m_Match );
+        entry["tolerance_mm"] = iuToMm( cls.m_Tolerance );
+        entry["reference"] = toUtf8( cls.m_Reference );
+        entry["target_mm"] = iuToMm( cls.m_Target );
+        entry["min_mm"] = iuToMm( cls.m_MinLength );
+        entry["max_mm"] = iuToMm( cls.m_MaxLength );
+        j["classes"].push_back( entry );
+    }
+
+    for( const XSIGNAL& sig : m_signals )
+    {
+        nlohmann::json entry;
+        entry["name"] = toUtf8( sig.m_Name );
+        entry["class"] = toUtf8( sig.m_Class );
+        entry["whole_net"] = sig.m_WholeNet;
+        entry["net"] = toUtf8( sig.m_Net );
+        entry["nodes"] = nlohmann::json::array();
+
+        for( const XSIGNAL_NODE& node : sig.m_Nodes )
+        {
+            nlohmann::json n;
+            n["ref"] = toUtf8( node.m_Ref );
+            n["pad"] = toUtf8( node.m_Pad );
+            n["uuid"] = toUtf8( node.m_Uuid.AsString() );
+            entry["nodes"].push_back( n );
+        }
+
+        j["xsignals"].push_back( entry );
+    }
+
+    std::string text = j.dump( 2 );
+    text += "\n";
+
+    wxFFile file( fileName, wxS( "wb" ) );
+
+    if( !file.IsOpened() || file.Write( text.data(), text.size() ) != text.size() )
+        return false;
+
+    file.Close();
+    m_loadedFor = aBoardFileName;
+    m_modified = false;
+    return true;
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// Data
+// ---------------------------------------------------------------------------------------------
+
+XSIGNAL* XSIGNAL_STORE::FindSignal( const wxString& aName )
+{
+    for( XSIGNAL& sig : m_signals )
+    {
+        if( sig.m_Name == aName )
+            return &sig;
+    }
+
+    return nullptr;
+}
+
+
+XSIGNAL_CLASS* XSIGNAL_STORE::FindClass( const wxString& aName )
+{
+    for( XSIGNAL_CLASS& cls : m_classes )
+    {
+        if( cls.m_Name == aName )
+            return &cls;
+    }
+
+    return nullptr;
+}
+
+
+wxString XSIGNAL_STORE::uniqueName( const wxString& aBase ) const
+{
+    auto used = [this]( const wxString& aName )
+                {
+                    for( const XSIGNAL& sig : m_signals )
+                    {
+                        if( sig.m_Name == aName )
+                            return true;
+                    }
+
+                    return false;
+                };
+
+    if( !used( aBase ) )
+        return aBase;
+
+    for( int n = 2; ; ++n )
+    {
+        wxString candidate = wxString::Format( wxS( "%s_%d" ), aBase, n );
+
+        if( !used( candidate ) )
+            return candidate;
+    }
+}
+
+
+wxString XSIGNAL_STORE::AddSignal( XSIGNAL aSignal )
+{
+    if( aSignal.m_Name.IsEmpty() )
+        aSignal.m_Name = MakeName( aSignal );
+
+    aSignal.m_Name = uniqueName( aSignal.m_Name );
+
+    if( !aSignal.m_Class.IsEmpty() )
+        EnsureClass( aSignal.m_Class );
+
+    m_signals.push_back( aSignal );
+    m_modified = true;
+    return aSignal.m_Name;
+}
+
+
+bool XSIGNAL_STORE::RemoveSignal( const wxString& aName )
+{
+    for( auto it = m_signals.begin(); it != m_signals.end(); ++it )
+    {
+        if( it->m_Name == aName )
+        {
+            m_signals.erase( it );
+            m_modified = true;
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+bool XSIGNAL_STORE::RenameSignal( const wxString& aOldName, const wxString& aNewName )
+{
+    if( aNewName.IsEmpty() || FindSignal( aNewName ) )
+        return false;
+
+    XSIGNAL* sig = FindSignal( aOldName );
+
+    if( !sig )
+        return false;
+
+    sig->m_Name = aNewName;
+
+    for( XSIGNAL_CLASS& cls : m_classes )
+    {
+        if( cls.m_Reference == aOldName )
+            cls.m_Reference = aNewName;
+    }
+
+    m_modified = true;
+    return true;
+}
+
+
+XSIGNAL_CLASS* XSIGNAL_STORE::EnsureClass( const wxString& aName )
+{
+    if( aName.IsEmpty() )
+        return nullptr;
+
+    if( XSIGNAL_CLASS* cls = FindClass( aName ) )
+        return cls;
+
+    XSIGNAL_CLASS cls;
+    cls.m_Name = aName;
+    m_classes.push_back( cls );
+    m_modified = true;
+    return &m_classes.back();
+}
+
+
+bool XSIGNAL_STORE::RemoveClass( const wxString& aName, bool aRemoveMembers )
+{
+    bool found = false;
+
+    for( auto it = m_classes.begin(); it != m_classes.end(); ++it )
+    {
+        if( it->m_Name == aName )
+        {
+            m_classes.erase( it );
+            found = true;
+            break;
+        }
+    }
+
+    if( !found )
+        return false;
+
+    if( aRemoveMembers )
+    {
+        m_signals.erase( std::remove_if( m_signals.begin(), m_signals.end(),
+                                         [&]( const XSIGNAL& aSig )
+                                         {
+                                             return aSig.m_Class == aName;
+                                         } ),
+                         m_signals.end() );
+    }
+    else
+    {
+        for( XSIGNAL& sig : m_signals )
+        {
+            if( sig.m_Class == aName )
+                sig.m_Class.clear();
+        }
+    }
+
+    m_modified = true;
+    return true;
+}
+
+
+bool XSIGNAL_STORE::RenameClass( const wxString& aOldName, const wxString& aNewName )
+{
+    if( aNewName.IsEmpty() || FindClass( aNewName ) )
+        return false;
+
+    XSIGNAL_CLASS* cls = FindClass( aOldName );
+
+    if( !cls )
+        return false;
+
+    cls->m_Name = aNewName;
+
+    for( XSIGNAL& sig : m_signals )
+    {
+        if( sig.m_Class == aOldName )
+            sig.m_Class = aNewName;
+    }
+
+    m_modified = true;
+    return true;
+}
+
+
+bool XSIGNAL_STORE::Exists( const XSIGNAL& aSignal ) const
+{
+    for( const XSIGNAL& sig : m_signals )
+    {
+        if( sig.m_WholeNet != aSignal.m_WholeNet )
+            continue;
+
+        if( sig.m_WholeNet )
+        {
+            if( sig.m_Net == aSignal.m_Net )
+                return true;
+
+            continue;
+        }
+
+        if( sig.m_Nodes.size() != aSignal.m_Nodes.size() || sig.m_Nodes.empty() )
+            continue;
+
+        const size_t count = sig.m_Nodes.size();
+        bool         forward = true;
+        bool         backward = true;
+
+        for( size_t ii = 0; ii < count; ++ii )
+        {
+            if( sig.m_Nodes[ii].Label() != aSignal.m_Nodes[ii].Label() )
+                forward = false;
+
+            if( sig.m_Nodes[ii].Label() != aSignal.m_Nodes[count - 1 - ii].Label() )
+                backward = false;
+        }
+
+        if( forward || backward )
+            return true;
+    }
+
+    return false;
+}
+
+
+static wxString shortNetName( const PAD* aPad )
+{
+    if( !aPad || !aPad->GetNet() )
+        return wxS( "N" );
+
+    wxString name = aPad->GetNet()->GetShortNetname();
+
+    if( name.IsEmpty() )
+        name = wxS( "N" );
+
+    return name;
+}
+
+
+wxString XSIGNAL_STORE::MakeName( const XSIGNAL& aSignal ) const
+{
+    if( aSignal.m_WholeNet )
+    {
+        wxString name = aSignal.m_Net.AfterLast( '/' );
+        return name.IsEmpty() ? aSignal.m_Net : name;
+    }
+
+    if( aSignal.m_Nodes.size() < 2 )
+        return wxS( "xSignal" );
+
+    wxString first = shortNetName( ResolveNode( aSignal.m_Nodes.front() ) );
+    wxString last = shortNetName( ResolveNode( aSignal.m_Nodes.back() ) );
+    wxString base = first == last ? first : first + wxS( "_" ) + last;
+
+    for( int n = 1; ; ++n )
+    {
+        wxString candidate = wxString::Format( wxS( "%s_PP%d" ), base, n );
+        bool     used = false;
+
+        for( const XSIGNAL& sig : m_signals )
+        {
+            if( sig.m_Name == candidate )
+            {
+                used = true;
+                break;
+            }
+        }
+
+        if( !used )
+            return candidate;
+    }
+}
+
+
+XSIGNAL_NODE XSIGNAL_STORE::NodeFor( const PAD* aPad )
+{
+    XSIGNAL_NODE node;
+
+    if( aPad )
+    {
+        if( const FOOTPRINT* fp = aPad->GetParentFootprint() )
+            node.m_Ref = fp->GetReference();
+
+        node.m_Pad = aPad->GetNumber();
+        node.m_Uuid = aPad->m_Uuid;
+    }
+
+    return node;
+}
+
+
+PAD* XSIGNAL_STORE::ResolveNode( const XSIGNAL_NODE& aNode ) const
+{
+    if( !m_board )
+        return nullptr;
+
+    if( aNode.m_Uuid != niluuid )
+    {
+        BOARD_ITEM* item = m_board->ResolveItem( aNode.m_Uuid, true );
+
+        if( item && item->Type() == PCB_PAD_T )
+            return static_cast<PAD*>( item );
+    }
+
+    if( FOOTPRINT* fp = m_board->FindFootprintByReference( aNode.m_Ref ) )
+        return fp->FindPadByNumber( aNode.m_Pad );
+
+    return nullptr;
+}
