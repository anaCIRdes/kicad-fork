+/**
+ * RIEGL fork: if the tuned track is part of an xSignal whose class has a length requirement,
+ * take the target from there.  It has priority over the length rules of the net.
+ */
+static bool applyXSignalTarget( BOARD* aBoard, const BOARD_CONNECTED_ITEM* aItem,
+                                PNS::MEANDER_SETTINGS& aSettings )
+{
+    if( !aBoard || !aItem )
+        return false;
+
+    int lo = 0;
+    int opt = 0;
+    int hi = 0;
+
+    if( !aBoard->XSignals()->TuningTarget( aItem, lo, opt, hi ) )
+        return false;
+
+    MINOPTMAX<int> target;
+    target.SetMin( lo );
+    target.SetOpt( opt );
+    target.SetMax( hi );
+
+    aSettings.SetTargetLengthDelay( MINOPTMAX<int>() );
+    aSettings.SetTargetLength( target );
+    aSettings.m_isTimeDomain = false;
+    return true;
+}
