+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef KIPLATFORM_WINDOW_EMBED_H_
+#define KIPLATFORM_WINDOW_EMBED_H_
+
+#include <wx/gdicmn.h>
+
+class wxWindow;
+
+namespace KIPLATFORM
+{
+/**
+ * Functions to dock editor frames into the document area of the project manager.
+ *
+ * The docked frames stay real top level windows (so their menu bars, keyboard focus, modal
+ * dialogs and OpenGL canvases keep working); they are merely stripped of their decorations,
+ * owned by the manager window and moved exactly over a placeholder inside it.  All functions
+ * take a native window handle (HWND on Windows, X11 window id on Linux) and therefore work
+ * for frames of this process and for frames of the workspace helper processes alike.
+ *
+ * Every function is a harmless no-op for a handle whose window no longer exists.
+ */
+namespace WINDOW_EMBED
+{
+    typedef unsigned long long HANDLE_T;
+
+    /// Docking needs Windows or an X11 display (also XWayland); not available on Wayland/macOS.
+    bool IsSupported();
+
+    /// Native handle of the top level window \a aWindow lives in, 0 if not (yet) realized.
+    HANDLE_T GetHandle( wxWindow* aWindow );
+
+    /// Does the window still exist?
+    bool IsAlive( HANDLE_T aWindow );
+
+    /// Remove title bar and borders, hide from the task bar and keep above \a aOwner.
+    void Attach( HANDLE_T aWindow, wxWindow* aOwner );
+
+    /// Undo Attach(): the window becomes an ordinary free floating window again.
+    void Detach( HANDLE_T aWindow );
+
+    /// Move/resize to \a aScreenRect (wx screen coordinates of \a aOwner's display).
+    void SetGeometry( HANDLE_T aWindow, wxWindow* aOwner, const wxRect& aScreenRect );
+
+    /// Show without taking the focus, or hide.
+    void Show( HANDLE_T aWindow, bool aShow );
+
+    /// Bring to front and give it the keyboard focus (restores a minimized window).
+    void Activate( HANDLE_T aWindow, wxWindow* aOwner );
+}
+}
+
+#endif // KIPLATFORM_WINDOW_EMBED_H_
diff --git a/libs/kiplatform/port/wxgtk/window_embed.cpp b/libs/kiplatform/port/wxgtk/window_embed.cpp
new file mode 100644
index 00000000..9f2c9bb6
--- /dev/null
+++ b/libs/kiplatform/port/wxgtk/window_embed.cpp
@@ -0,0 +1,371 @@
+/*
+ * This program source code file is part of KiCad, a free EDA CAD application.
+ *
+ * Workspace fork: control of native top level windows (GTK / X11 implementation).
+ *
+ * This program is free software: you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or (at your
+ * option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <kiplatform/window_embed.h>
+
+#include <wx/window.h>
+#include <wx/toplevel.h>
+
+#include <algorithm>
+#include <cstring>
+
+#include <gtk/gtk.h>
+#include <gdk/gdk.h>
+
+#ifdef GDK_WINDOWING_X11
+#include <gdk/gdkx.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <X11/Xatom.h>
+#endif
+
+// The windows handled here may belong to another process and can vanish at any moment.  X
+// answers a request on a vanished window with a BadWindow error, which GDK's default handler
+// turns into a program abort - hence every block of requests sits inside an error trap.
+
+#ifdef GDK_WINDOWING_X11
+
+namespace
+{
+GdkDisplay* x11Display()
+{
+    GdkDisplay* display = gdk_display_get_default();
+
+    return ( display && GDK_IS_X11_DISPLAY( display ) ) ? display : nullptr;
+}
+
+
+/// RAII error trap, also flushes the requests issued inside it.
+class X_TRAP
+{
+public:
+    X_TRAP( GdkDisplay* aDisplay ) : m_display( aDisplay )
+    {
+        gdk_x11_display_error_trap_push( m_display );
+    }
+
+    ~X_TRAP()
+    {
+        XSync( gdk_x11_display_get_xdisplay( m_display ), False );
+        gdk_x11_display_error_trap_pop_ignored( m_display );
+    }
+
+private:
+    GdkDisplay* m_display;
+};
+
+
+Atom atom( Display* aDpy, const char* aName )
+{
+    return XInternAtom( aDpy, aName, False );
+}
+
+
+GdkWindow* topLevelGdkWindow( wxWindow* aWindow )
+{
+    if( !aWindow )
+        return nullptr;
+
+    wxWindow* top = wxGetTopLevelParent( aWindow );
+
+    if( !top || !top->GetHandle() )
+        return nullptr;
+
+    return gtk_widget_get_window( static_cast<GtkWidget*>( top->GetHandle() ) );
+}
+
+
+/// Device pixels per logical (wx) pixel on the owner's monitor.
+int scaleOf( wxWindow* aOwner )
+{
+    GdkWindow* gdkWindow = topLevelGdkWindow( aOwner );
+
+    return gdkWindow ? gdk_window_get_scale_factor( gdkWindow ) : 1;
+}
+
+
+/// Send an EWMH request to the window manager.
+void sendToRoot( Display* aDpy, Window aWindow, const char* aMessage, long a0, long a1, long a2, long a3 )
+{
+    XEvent ev;
+    memset( &ev, 0, sizeof( ev ) );
+
+    ev.xclient.type = ClientMessage;
+    ev.xclient.window = aWindow;
+    ev.xclient.message_type = atom( aDpy, aMessage );
+    ev.xclient.format = 32;
+    ev.xclient.data.l[0] = a0;
+    ev.xclient.data.l[1] = a1;
+    ev.xclient.data.l[2] = a2;
+    ev.xclient.data.l[3] = a3;
+    ev.xclient.data.l[4] = 0;
+
+    XSendEvent( aDpy, DefaultRootWindow( aDpy ), False, SubstructureRedirectMask | SubstructureNotifyMask,
+                &ev );
+}
+
+
+/// Motif hints are the portable way to ask a window manager for an undecorated window.
+void setDecorated( Display* aDpy, Window aWindow, bool aDecorated )
+{
+    Atom hintsAtom = atom( aDpy, "_MOTIF_WM_HINTS" );
+
+    if( aDecorated )
+    {
+        XDeleteProperty( aDpy, aWindow, hintsAtom );
+        return;
+    }
+
+    // flags, functions, decorations, input_mode, status
+    unsigned long hints[5] = { 2 /* MWM_HINTS_DECORATIONS */, 0, 0 /* no decorations */, 0, 0 };
+
+    XChangeProperty( aDpy, aWindow, hintsAtom, hintsAtom, 32, PropModeReplace,
+                     reinterpret_cast<unsigned char*>( hints ), 5 );
+}
+
+
+/// The window manager drops _NET_WM_STATE of a withdrawn window; set it again before mapping.
+void setSkipTaskbarProperty( Display* aDpy, Window aWindow )
+{
+    Atom states[2] = { atom( aDpy, "_NET_WM_STATE_SKIP_TASKBAR" ), atom( aDpy, "_NET_WM_STATE_SKIP_PAGER" ) };
+
+    XChangeProperty( aDpy, aWindow, atom( aDpy, "_NET_WM_STATE" ), XA_ATOM, 32, PropModeReplace,
+                     reinterpret_cast<unsigned char*>( states ), 2 );
+}
+
+
+bool isViewable( Display* aDpy, Window aWindow )
+{
+    XWindowAttributes attrs;
+
+    return XGetWindowAttributes( aDpy, aWindow, &attrs ) && attrs.map_state != IsUnmapped;
+}
+} // namespace
+
+#endif // GDK_WINDOWING_X11
+
+
+namespace KIPLATFORM
+{
+namespace WINDOW_EMBED
+{
+
+bool IsSupported()
+{
+#ifdef GDK_WINDOWING_X11
+    return x11Display() != nullptr;
+#else
+    return false;
+#endif
+}
+
+
+HANDLE_T GetHandle( wxWindow* aWindow )
+{
+#ifdef GDK_WINDOWING_X11
+    if( !x11Display() )
+        return 0;
+
+    GdkWindow* gdkWindow = topLevelGdkWindow( aWindow );
+
+    if( !gdkWindow || !GDK_IS_X11_WINDOW( gdkWindow ) )
+        return 0;
+
+    return static_cast<HANDLE_T>( gdk_x11_window_get_xid( gdkWindow ) );
+#else
+    return 0;
+#endif
+}
+
+
+bool IsAlive( HANDLE_T aWindow )
+{
+#ifdef GDK_WINDOWING_X11
+    GdkDisplay* display = x11Display();
+
+    if( !display || !aWindow )
+        return false;
+
+    Display*          dpy = gdk_x11_display_get_xdisplay( display );
+    XWindowAttributes attrs;
+
+    gdk_x11_display_error_trap_push( display );
+    Status ok = XGetWindowAttributes( dpy, static_cast<Window>( aWindow ), &attrs );
+
+    return gdk_x11_display_error_trap_pop( display ) == 0 && ok != 0;
+#else
+    return false;
+#endif
+}
+
+
+void Attach( HANDLE_T aWindow, wxWindow* aOwner )
+{
+#ifdef GDK_WINDOWING_X11
+    GdkDisplay* display = x11Display();
+    HANDLE_T    owner = GetHandle( aOwner );
+
+    if( !display || !aWindow || !owner || aWindow == owner )
+        return;
+
+    Display* dpy = gdk_x11_display_get_xdisplay( display );
+    Window   win = static_cast<Window>( aWindow );
+    X_TRAP   trap( display );
+
+    // A maximized or full screen window cannot be placed freely
+    sendToRoot( dpy, win, "_NET_WM_STATE", 0 /* remove */, atom( dpy, "_NET_WM_STATE_MAXIMIZED_VERT" ),
+                atom( dpy, "_NET_WM_STATE_MAXIMIZED_HORZ" ), 2 );
+    sendToRoot( dpy, win, "_NET_WM_STATE", 0 /* remove */, atom( dpy, "_NET_WM_STATE_FULLSCREEN" ), 0, 2 );
+
+    setDecorated( dpy, win, false );
+
+    // A transient window is kept above its parent by the window manager and is iconified
+    // together with it.
+    XSetTransientForHint( dpy, win, static_cast<Window>( owner ) );
+
+    sendToRoot( dpy, win, "_NET_WM_STATE", 1 /* add */, atom( dpy, "_NET_WM_STATE_SKIP_TASKBAR" ),
+                atom( dpy, "_NET_WM_STATE_SKIP_PAGER" ), 2 );
+#endif
+}
+
+
+void Detach( HANDLE_T aWindow )
+{
+#ifdef GDK_WINDOWING_X11
+    GdkDisplay* display = x11Display();
+
+    if( !display || !aWindow )
+        return;
+
+    Display* dpy = gdk_x11_display_get_xdisplay( display );
+    Window   win = static_cast<Window>( aWindow );
+    X_TRAP   trap( display );
+
+    bool viewable = isViewable( dpy, win );
+
+    // Window managers evaluate these hints when a window gets mapped; withdraw and map again
+    // so that the change takes effect everywhere.
+    if( viewable )
+        XWithdrawWindow( dpy, win, DefaultScreen( dpy ) );
+
+    setDecorated( dpy, win, true );
+    XDeleteProperty( dpy, win, XA_WM_TRANSIENT_FOR );
+    XDeleteProperty( dpy, win, atom( dpy, "_NET_WM_STATE" ) );
+
+    XSync( dpy, False );
+    XMapWindow( dpy, win );
+#endif
+}
+
+
+void SetGeometry( HANDLE_T aWindow, wxWindow* aOwner, const wxRect& aScreenRect )
+{
+#ifdef GDK_WINDOWING_X11
+    GdkDisplay* display = x11Display();
+
+    if( !display || !aWindow || aScreenRect.width < 1 || aScreenRect.height < 1 )
+        return;
+
+    Display* dpy = gdk_x11_display_get_xdisplay( display );
+    Window   win = static_cast<Window>( aWindow );
+    int      scale = scaleOf( aOwner );
+    int      width = aScreenRect.width * scale;
+    int      height = aScreenRect.height * scale;
+    X_TRAP   trap( display );
+
+    // The frame announces a minimum size to the window manager, which would then refuse to
+    // make it as small as a narrow half of a split view.  Lower that minimum where needed.
+    XSizeHints hints;
+    long       supplied = 0;
+
+    if( XGetWMNormalHints( dpy, win, &hints, &supplied ) && ( hints.flags & PMinSize )
+        && ( hints.min_width > width || hints.min_height > height ) )
+    {
+        hints.min_width = std::min( hints.min_width, width );
+        hints.min_height = std::min( hints.min_height, height );
+        XSetWMNormalHints( dpy, win, &hints );
+    }
+
+    XMoveResizeWindow( dpy, win, aScreenRect.x * scale, aScreenRect.y * scale,
+                       static_cast<unsigned>( width ), static_cast<unsigned>( height ) );
+#endif
+}
+
+
+void Show( HANDLE_T aWindow, bool aShow )
+{
+#ifdef GDK_WINDOWING_X11
+    GdkDisplay* display = x11Display();
+
+    if( !display || !aWindow )
+        return;
+
+    Display* dpy = gdk_x11_display_get_xdisplay( display );
+    Window   win = static_cast<Window>( aWindow );
+    X_TRAP   trap( display );
+
+    bool viewable = isViewable( dpy, win );
+
+    if( aShow && !viewable )
+    {
+        setSkipTaskbarProperty( dpy, win );
+        XMapWindow( dpy, win );
+    }
+    else if( !aShow && viewable )
+    {
+        XWithdrawWindow( dpy, win, DefaultScreen( dpy ) );
+    }
+#endif
+}
+
+
+void Activate( HANDLE_T aWindow, wxWindow* aOwner )
+{
+#ifdef GDK_WINDOWING_X11
+    GdkDisplay* display = x11Display();
+
+    if( !display || !aWindow )
+        return;
+
+    Display* dpy = gdk_x11_display_get_xdisplay( display );
+    Window   win = static_cast<Window>( aWindow );
+
+    // A current time stamp proves to the window manager that the request stems from a user
+    // action; without it focus stealing prevention would only flash the task bar entry.
+    guint32    timestamp = gtk_get_current_event_time();
+    GdkWindow* ownerWindow = topLevelGdkWindow( aOwner );
+
+    if( timestamp == GDK_CURRENT_TIME && ownerWindow && GDK_IS_X11_WINDOW( ownerWindow ) )
+        timestamp = gdk_x11_get_server_time( ownerWindow );
+
+    X_TRAP trap( display );
+
+    if( !isViewable( dpy, win ) )
+    {
+        setSkipTaskbarProperty( dpy, win );
+        XMapWindow( dpy, win );
+    }
+
+    // source indication 2 = "pager": honoured by window managers regardless of who has focus
+    sendToRoot( dpy, win, "_NET_ACTIVE_WINDOW", 2, static_cast<long>( timestamp ), 0, 0 );
+#endif
+}
+
+}
+}
diff --git a/libs/kiplatform/port/wxmsw/window_embed.cpp b/libs/kiplatform/port/wxmsw/window_embed.cpp
new file mode 100644
index 00000000..3e6222aa
--- /dev/null
+++ b/libs/kiplatform/port/wxmsw/window_embed.cpp
@@ -0,0 +1,187 @@
+/*
+ * This program source code file is part of KiCad, a free EDA CAD application.
+ *
+ * Workspace fork: control of native top level windows (Windows implementation).
+ *
+ * This program is free software: you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or (at your
+ * option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <kiplatform/window_embed.h>
+
+#include <wx/window.h>
+#include <wx/toplevel.h>
+
+#include <windows.h>
+
+namespace
+{
+/// Window property holding the style bits the window had before it was docked.
+const wchar_t* const PROP_STYLE = L"KiCadWorkspaceStyle";
+
+/// Style bits that make up title bar and resizable border.
+const LONG_PTR DECORATION = WS_CAPTION | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SYSMENU;
+
+HWND toHwnd( KIPLATFORM::WINDOW_EMBED::HANDLE_T aWindow )
+{
+    return reinterpret_cast<HWND>( static_cast<UINT_PTR>( aWindow ) );
+}
+
+HWND ownerHwnd( wxWindow* aOwner )
+{
+    if( !aOwner )
+        return nullptr;
+
+    wxWindow* top = wxGetTopLevelParent( aOwner );
+
+    return top ? static_cast<HWND>( top->GetHWND() ) : nullptr;
+}
+} // namespace
+
+
+namespace KIPLATFORM
+{
+namespace WINDOW_EMBED
+{
+
+bool IsSupported()
+{
+    return true;
+}
+
+
+HANDLE_T GetHandle( wxWindow* aWindow )
+{
+    if( !aWindow )
+        return 0;
+
+    wxWindow* top = wxGetTopLevelParent( aWindow );
+
+    if( !top || !top->GetHWND() )
+        return 0;
+
+    return static_cast<HANDLE_T>( reinterpret_cast<UINT_PTR>( top->GetHWND() ) );
+}
+
+
+bool IsAlive( HANDLE_T aWindow )
+{
+    return aWindow != 0 && ::IsWindow( toHwnd( aWindow ) );
+}
+
+
+void Attach( HANDLE_T aWindow, wxWindow* aOwner )
+{
+    HWND hwnd = toHwnd( aWindow );
+    HWND owner = ownerHwnd( aOwner );
+
+    if( !::IsWindow( hwnd ) || !owner || hwnd == owner )
+        return;
+
+    // A maximized or minimized window cannot be placed freely
+    if( ::IsZoomed( hwnd ) || ::IsIconic( hwnd ) )
+        ::ShowWindow( hwnd, SW_RESTORE );
+
+    LONG_PTR style = ::GetWindowLongPtrW( hwnd, GWL_STYLE );
+
+    // Remember the original decoration once (the property survives until Detach)
+    if( !::GetPropW( hwnd, PROP_STYLE ) )
+        ::SetPropW( hwnd, PROP_STYLE, reinterpret_cast<HANDLE>( ( style & DECORATION ) | 1 ) );
+
+    ::SetWindowLongPtrW( hwnd, GWL_STYLE, style & ~DECORATION );
+
+    // An owned window always stays above its owner, has no task bar button and is minimized
+    // and restored together with it.
+    ::SetWindowLongPtrW( hwnd, GWLP_HWNDPARENT, reinterpret_cast<LONG_PTR>( owner ) );
+
+    ::SetWindowPos( hwnd, nullptr, 0, 0, 0, 0,
+                    SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
+}
+
+
+void Detach( HANDLE_T aWindow )
+{
+    HWND hwnd = toHwnd( aWindow );
+
+    if( !::IsWindow( hwnd ) )
+        return;
+
+    LONG_PTR saved = reinterpret_cast<LONG_PTR>( ::GetPropW( hwnd, PROP_STYLE ) );
+
+    if( !saved )
+        return;     // was never docked
+
+    ::RemovePropW( hwnd, PROP_STYLE );
+
+    LONG_PTR style = ::GetWindowLongPtrW( hwnd, GWL_STYLE );
+    ::SetWindowLongPtrW( hwnd, GWL_STYLE, ( style & ~DECORATION ) | ( saved & DECORATION ) );
+    ::SetWindowLongPtrW( hwnd, GWLP_HWNDPARENT, 0 );
+
+    ::SetWindowPos( hwnd, nullptr, 0, 0, 0, 0,
+                    SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE );
+
+    // Make sure a window that was hidden as an inactive tab does not stay invisible
+    ::ShowWindowAsync( hwnd, SW_SHOWNA );
+}
+
+
+void SetGeometry( HANDLE_T aWindow, wxWindow* aOwner, const wxRect& aScreenRect )
+{
+    HWND hwnd = toHwnd( aWindow );
+
+    if( !::IsWindow( hwnd ) )
+        return;
+
+    // SWP_ASYNCWINDOWPOS: never block on a busy helper process
+    ::SetWindowPos( hwnd, nullptr, aScreenRect.x, aScreenRect.y, aScreenRect.width, aScreenRect.height,
+                    SWP_NOZORDER | SWP_NOACTIVATE | SWP_ASYNCWINDOWPOS );
+}
+
+
+void Show( HANDLE_T aWindow, bool aShow )
+{
+    HWND hwnd = toHwnd( aWindow );
+
+    if( !::IsWindow( hwnd ) )
+        return;
+
+    ::ShowWindowAsync( hwnd, aShow ? SW_SHOWNA : SW_HIDE );
+}
+
+
+void Activate( HANDLE_T aWindow, wxWindow* aOwner )
+{
+    HWND hwnd = toHwnd( aWindow );
+
+    if( !::IsWindow( hwnd ) )
+        return;
+
+    if( ::IsIconic( hwnd ) )
+        ::ShowWindowAsync( hwnd, SW_RESTORE );
+    else if( !::IsWindowVisible( hwnd ) )
+        ::ShowWindowAsync( hwnd, SW_SHOW );
+
+    // The manager is the foreground process at this moment (the user just clicked in it),
+    // which is what entitles it to hand the foreground to a window of another process.
+    DWORD pid = 0;
+    ::GetWindowThreadProcessId( hwnd, &pid );
+
+    if( pid && pid != ::GetCurrentProcessId() )
+        ::AllowSetForegroundWindow( pid );
+
+    ::BringWindowToTop( hwnd );
+    ::SetForegroundWindow( hwnd );
+}
+
+}
+}
