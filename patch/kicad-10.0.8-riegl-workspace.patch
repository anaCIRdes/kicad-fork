+
+void XSIGNAL_PANEL::onTimer( wxTimerEvent& aEvent )
+{
+    if( aEvent.GetId() == m_selectTimer.GetId() )
+    {
+        updateDetails();
+        selectOnBoard( false );
+    }
+    else if( aEvent.GetId() == m_timer.GetId() )
+    {
+        if( m_dirty && IsShownOnScreen() )
+            RefreshNow();
+    }
+    else
+    {
+        aEvent.Skip();
+    }
+}
