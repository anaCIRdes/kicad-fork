     images.push_back( KiBitmapBundleDef( BITMAPS::unknown, 22 ) );          // WS_ICON_MISSING
     m_tree->SetImages( images );
 
-    m_activity = new wxListBox( splitter, wxID_ANY, wxDefaultPosition, wxDefaultSize, 0, nullptr,
+    // Below the tree: details of the selected entry, then the activity list.
+    //
+    // The details used to be a tool tip of the tree item.  A tool tip pops up right below the
+    // mouse pointer, i.e. on top of the next row, and swallowed the first click of a double
+    // click on that row - "double click does not always open the file".
+    wxPanel*    bottom = new wxPanel( splitter, wxID_ANY );
+    wxBoxSizer* bottomSizer = new wxBoxSizer( wxVERTICAL );
+
+    m_details = new wxStaticText( bottom, wxID_ANY, wxEmptyString, wxDefaultPosition, wxDefaultSize,
+                                  wxST_NO_AUTORESIZE | wxST_ELLIPSIZE_END );
+    m_details->SetFont( KIUI::GetInfoFont( this ) );
+    m_details->SetMinSize( wxSize( -1, m_details->GetCharHeight() * 2 + FromDIP( 4 ) ) );
+    bottomSizer->Add( m_details, 0, wxEXPAND | wxLEFT | wxRIGHT | wxTOP, 3 );
+
+    m_activity = new wxListBox( bottom, wxID_ANY, wxDefaultPosition, wxDefaultSize, 0, nullptr,
                                 wxLB_SINGLE | wxLB_HSCROLL | wxBORDER_NONE );
     m_activity->SetToolTip( _( "Activity of other users in the workspace projects" ) );
+    bottomSizer->Add( m_activity, 1, wxEXPAND | wxTOP, 2 );
 
-    splitter->SplitHorizontally( m_tree, m_activity, -FromDIP( 80 ) );
+    bottom->SetSizer( bottomSizer );
+
+    splitter->SplitHorizontally( m_tree, bottom, -FromDIP( 110 ) );
     mainSizer->Add( splitter, 1, wxEXPAND );
 
     SetSizer( mainSizer );
 
     m_tree->Bind( wxEVT_TREE_ITEM_ACTIVATED, &WORKSPACE_PANE::onItemActivated, this );
+
+    // Carry out a double click once its second click is complete (see onItemActivated)
+    m_tree->Bind( wxEVT_LEFT_UP,
+                  [this]( wxMouseEvent& aEvent )
+                  {
+                      aEvent.Skip();
+
+                      if( !m_deferredProFile.IsEmpty() )
+                      {
+                          CallAfter(
+                                  [this]()
+                                  {
+                                      runDeferredOpen();
+                                  } );
+                      }
+                  } );
     m_tree->Bind( wxEVT_TREE_ITEM_MENU, &WORKSPACE_PANE::onItemMenu, this );
-    m_tree->Bind( wxEVT_TREE_ITEM_GETTOOLTIP, &WORKSPACE_PANE::onItemTooltip, this );
+    m_tree->Bind( wxEVT_TREE_SEL_CHANGED,
+                  [this]( wxTreeEvent& aEvent )
+                  {
+                      aEvent.Skip();
+                      updateDetails();
+                  } );
 
     m_tree->Bind( wxEVT_TREE_ITEM_COLLAPSED,
                   [this]( wxTreeEvent& aEvent )
@@ -495,6 +536,10 @@ const WS_PROJECT* WORKSPACE_PANE::findProject( const wxString& aProFile ) const
 
 void WORKSPACE_PANE::onTimer( wxTimerEvent& aEvent )
 {
+    // Safety net should the release of a double click never have reached the tree
+    if( !m_deferredProFile.IsEmpty() && !wxGetMouseState().LeftIsDown() )
+        runDeferredOpen();
+
     if( m_scan.valid() )
     {
         if( m_scan.wait_for( std::chrono::seconds( 0 ) ) != std::future_status::ready )
@@ -720,33 +765,34 @@ wxColour WORKSPACE_PANE::lockColour( const WS_LOCK_INFO& aLock ) const
 
 wxString WORKSPACE_PANE::lockTooltip( const wxString& aPath, const WS_LOCK_INFO& aLock ) const
 {
-    wxString tip = aPath;
+    // Line 1: who and since when; line 2: the file.  Shown below the tree for the selection.
+    wxString line;
 
     if( !aLock.locked )
-        return tip + wxS( "\n" ) + _( "Not open anywhere." );
-
-    wxString since = aLock.since;
-    since.Replace( wxS( "T" ), wxS( " " ) );
+    {
+        line = _( "Not open anywhere." );
+    }
+    else
+    {
+        wxString since = aLock.since;
+        since.Replace( wxS( "T" ), wxS( " " ) );
 
-    tip << wxS( "\n" ) << _( "User:" ) << wxS( " " ) << ( aLock.user.IsEmpty() ? _( "unknown" ) : aLock.user );
-    tip << wxS( "\n" ) << _( "Computer:" ) << wxS( " " ) << ( aLock.host.IsEmpty() ? _( "unknown" ) : aLock.host );
+        line = aLock.Owner().IsEmpty() ? _( "Unknown user" ) : aLock.Owner();
 
-    if( !since.IsEmpty() )
-        tip << wxS( "\n" ) << _( "Since:" ) << wxS( " " ) << since;
+        if( !since.IsEmpty() )
+            line << wxS( "  \u00B7  " ) << _( "Since:" ) << wxS( " " ) << since;
 
-    if( !aLock.app.IsEmpty() )
-        tip << wxS( "\n" ) << _( "Application:" ) << wxS( " " ) << aLock.app;
+        if( !aLock.app.IsEmpty() )
+            line << wxS( "  \u00B7  " ) << aLock.app;
 
-    if( aLock.pid > 0 )
-        tip << wxS( "\n" ) << wxS( "PID: " ) << aLock.pid;
+        if( aLock.pid > 0 )
+            line << wxS( " (PID " ) << aLock.pid << wxS( ")" );
 
-    if( aLock.stale )
-    {
-        tip << wxS( "\n" ) << _( "The process that created this lock no longer exists. The lock is "
-                                 "removed automatically when the file is opened." );
+        if( aLock.stale )
+            line << wxS( "  \u00B7  " ) << _( "stale lock (crashed session)" );
     }
 
-    return tip;
+    return line + wxS( "\n" ) + aPath;
 }
 
 
@@ -883,34 +929,46 @@ void WORKSPACE_PANE::updateLabels()
             m_tree->SetItemTextColour( fileIt->second, lockColour( file.lock ) );
         }
     }
+
+    updateDetails();
 }
 
 
-void WORKSPACE_PANE::onItemTooltip( wxTreeEvent& aEvent )
+void WORKSPACE_PANE::updateDetails()
 {
-    WS_ITEM_DATA* data = dynamic_cast<WS_ITEM_DATA*>( m_tree->GetItemData( aEvent.GetItem() ) );
+    wxString text;
 
-    if( !data )
-        return;
+    wxTreeItemId  sel = m_tree->GetSelection();
+    WS_ITEM_DATA* data = sel.IsOk() ? dynamic_cast<WS_ITEM_DATA*>( m_tree->GetItemData( sel ) ) : nullptr;
 
-    const WS_PROJECT* prj = findProject( data->m_proFile );
-
-    if( !prj )
-        return;
-
-    if( data->IsProject() )
+    if( data )
     {
-        aEvent.SetToolTip( lockTooltip( prj->proFile, prj->lock ) );
-        return;
+        if( const WS_PROJECT* prj = findProject( data->m_proFile ) )
+        {
+            if( data->IsProject() )
+            {
+                text = lockTooltip( prj->proFile, prj->lock );
+            }
+            else
+            {
+                for( const WS_FILE& file : prj->files )
+                {
+                    if( file.path == data->m_file )
+                    {
+                        text = lockTooltip( file.path, file.lock );
+                        break;
+                    }
+                }
+            }
+        }
     }
 
-    for( const WS_FILE& file : prj->files )
+    if( m_details->GetLabel() != text )
     {
-        if( file.path == data->m_file )
-        {
-            aEvent.SetToolTip( lockTooltip( file.path, file.lock ) );
-            return;
-        }
+        // First line: who has it open; the full text (with path) is the tool tip of the label,
+        // which sits well away from the tree rows.
+        m_details->SetLabel( text );
+        m_details->SetToolTip( text );
     }
 }
 
@@ -930,7 +988,28 @@ void WORKSPACE_PANE::onItemActivated( wxTreeEvent& aEvent )
 
     bool isSch = wxFileName( data->m_file ).GetExt().Lower() == FILEEXT::KiCadSchematicFileExtension;
 
-    openInProject( data->m_proFile, isSch ? OPEN_WHAT::SCHEMATIC : OPEN_WHAT::PCB );
+    m_deferredProFile = data->m_proFile;
+    m_deferredWhat = isSch ? OPEN_WHAT::SCHEMATIC : OPEN_WHAT::PCB;
+
+    // A double click activates the item while the mouse button is still held down.  Opening
+    // (or bringing to the front) another window at that moment takes the focus away in the
+    // middle of the click and the toolkit then loses a click of the next double click.  So
+    // wait for the button to be released; activation by keyboard is carried out at once.
+    if( !wxGetMouseState().LeftIsDown() )
+        runDeferredOpen();
+}
+
+
+void WORKSPACE_PANE::runDeferredOpen()
+{
+    if( m_deferredProFile.IsEmpty() )
+        return;
+
+    wxString  proFile = m_deferredProFile;
+    OPEN_WHAT what = m_deferredWhat;
+
+    m_deferredProFile.clear();
+    openInProject( proFile, what );
 }
 
 
