+void DIALOG_XSIGNAL_ADD::onCheckAll( wxCommandEvent& aEvent )
+{
+    for( unsigned ii = 0; ii < m_list->GetCount(); ++ii )
+        m_list->Check( ii, true );
+
+    updateCount();
