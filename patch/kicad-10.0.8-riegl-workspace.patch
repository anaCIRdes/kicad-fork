+
+bool DIALOG_XSIGNAL_CLASS::TransferDataToWindow()
+{
+    XSIGNAL_CLASS cls;
+
+    if( XSIGNAL_CLASS* existing = m_store->FindClass( m_className ) )
+        cls = *existing;
+
+    m_nameCtrl->SetValue( cls.m_Name );
+    m_matchChoice->SetSelection( static_cast<int>( cls.m_Match ) );
+
+    m_referenceChoice->Clear();
+
+    for( const XSIGNAL& sig : m_store->Signals() )
+    {
+        if( !m_className.IsEmpty() && sig.m_Class == m_className )
+            m_referenceChoice->Append( sig.m_Name );
+    }
+
+    if( !cls.m_Reference.IsEmpty() )
+        m_referenceChoice->SetStringSelection( cls.m_Reference );
+
+    if( m_referenceChoice->GetSelection() == wxNOT_FOUND && m_referenceChoice->GetCount() > 0 )
+        m_referenceChoice->SetSelection( 0 );
+
+    m_target->SetValue( cls.m_Target );
+    m_tolerance->SetValue( cls.m_Tolerance );
+    m_minLength->SetValue( cls.m_MinLength );
+    m_maxLength->SetValue( cls.m_MaxLength );
+
+    updateEnables();
+    return true;
+}
+
+
+void DIALOG_XSIGNAL_CLASS::onMatchChoice( wxCommandEvent& aEvent )
+{
+    updateEnables();
+}
+
+
+void DIALOG_XSIGNAL_CLASS::updateEnables()
+{
+    const int match = m_matchChoice->GetSelection();
+
+    m_referenceChoice->Enable( match == static_cast<int>( XSIGNAL_MATCH::MEMBER ) );
+    m_referenceLabel->Enable( match == static_cast<int>( XSIGNAL_MATCH::MEMBER ) );
+    m_target->Enable( match == static_cast<int>( XSIGNAL_MATCH::TARGET ) );
+    m_tolerance->Enable( match != static_cast<int>( XSIGNAL_MATCH::NONE ) );
+
+    switch( static_cast<XSIGNAL_MATCH>( match ) )
+    {
+    case XSIGNAL_MATCH::LONGEST:
+        m_hint->SetLabel( _( "Every member must be at most the tolerance shorter than the longest "
+                             "member." ) );
+        break;
+
+    case XSIGNAL_MATCH::MEMBER:
+        m_hint->SetLabel( _( "Every member must be within plus/minus the tolerance of the reference "
+                             "member." ) );
+        break;
+
+    case XSIGNAL_MATCH::TARGET:
+        m_hint->SetLabel( _( "Every member must be within plus/minus the tolerance of the target "
+                             "length." ) );
+        break;
+
+    default:
+        m_hint->SetLabel( _( "Only the minimum and maximum length are checked." ) );
+        break;
+    }
+
+    m_hint->Wrap( FromDIP( 480 ) );
+    Layout();
+}
+
+
+bool DIALOG_XSIGNAL_CLASS::TransferDataFromWindow()
+{
+    wxString name = m_nameCtrl->GetValue().Trim().Trim( false );
+
+    if( name.IsEmpty() )
+    {
+        DisplayError( this, _( "The class name must not be empty." ) );
+        return false;
+    }
+
+    if( name != m_className && m_store->FindClass( name ) )
+    {
+        DisplayError( this, wxString::Format( _( "A class named '%s' already exists." ), name ) );
+        return false;
+    }
+
+    XSIGNAL_MATCH match = static_cast<XSIGNAL_MATCH>( std::max( 0, m_matchChoice->GetSelection() ) );
+
+    if( match == XSIGNAL_MATCH::MEMBER && m_referenceChoice->GetSelection() == wxNOT_FOUND )
+    {
+        DisplayError( this, _( "Choose the reference member, or use another matching mode. A new "
+                               "class has no members yet." ) );
+        return false;
+    }
+
+    if( m_tolerance->GetValue() < 0 || m_minLength->GetValue() < 0 || m_maxLength->GetValue() < 0
+        || m_target->GetValue() < 0 )
+    {
+        DisplayError( this, _( "Lengths must not be negative." ) );
+        return false;
+    }
+
+    if( m_maxLength->GetValue() > 0 && m_minLength->GetValue() > m_maxLength->GetValue() )
+    {
+        DisplayError( this, _( "The minimum length is larger than the maximum length." ) );
+        return false;
+    }
+
+    if( m_className.IsEmpty() )
+        m_store->EnsureClass( name );
+    else if( name != m_className )
+        m_store->RenameClass( m_className, name );
+
+    XSIGNAL_CLASS* cls = m_store->FindClass( name );
+
+    if( !cls )
+        return false;
+
+    cls->m_Match = match;
+    cls->m_Tolerance = m_tolerance->GetValue();
+    cls->m_Target = m_target->GetValue();
+    cls->m_MinLength = m_minLength->GetValue();
+    cls->m_MaxLength = m_maxLength->GetValue();
+    cls->m_Reference = match == XSIGNAL_MATCH::MEMBER ? m_referenceChoice->GetStringSelection()
+                                                      : wxString();
+
+    m_className = name;
+    m_store->SetModified();
+    return true;
+}
