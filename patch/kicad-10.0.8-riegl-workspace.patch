+/// Notifies the pane when a helper process ends.
+class WS_CHILD_PROCESS : public wxProcess
+{
+public:
+    WS_CHILD_PROCESS( WORKSPACE_PANE* aPane, const wxString& aProFile ) :
+            wxProcess( wxPROCESS_DEFAULT ),
+            m_pane( aPane ),
+            m_proFile( aProFile )
+    {
+    }
+
+    void OnTerminate( int aPid, int aStatus ) override
+    {
+        if( m_pane )
+            m_pane->OnChildTerminated( m_proFile );
+
+        delete this;
+    }
+
+    /// The pane is going away: the process keeps running, nobody is notified anymore.
+    void Orphan() { m_pane = nullptr; }
+
+private:
+    WORKSPACE_PANE* m_pane;
+    wxString        m_proFile;
+};
