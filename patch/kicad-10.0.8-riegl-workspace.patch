+
+DIALOG_XSIGNAL_WIZARD::DIALOG_XSIGNAL_WIZARD( PCB_EDIT_FRAME* aFrame, XSIGNAL_STORE* aStore,
+                                              FOOTPRINT* aSource,
+                                              const std::vector<FOOTPRINT*>& aDestinations ) :
+        DIALOG_SHIM( aFrame, wxID_ANY, _( "Create xSignals Between Components" ), wxDefaultPosition,
+                     wxDefaultSize, wxDEFAULT_DIALOG_STYLE | wxRESIZE_BORDER ),
+        m_frame( aFrame ),
+        m_store( aStore ),
+        m_preselected( aDestinations )
+{
+    // Everything in this dialog depends on the board
+    OptOut( this );
+
+    FOOTPRINT* largest = nullptr;
+
+    for( FOOTPRINT* fp : aFrame->GetBoard()->Footprints() )
+    {
+        if( fp->Pads().size() >= 1 )
+            m_footprints.push_back( fp );
+
+        if( !XSIGNAL_STORE::IsSeriesComponent( fp )
+            && ( !largest || fp->Pads().size() > largest->Pads().size() ) )
+        {
+            largest = fp;
+        }
+    }
+
+    // Without a selection, start from the component with the most pads
+    if( !aSource )
+        aSource = largest;
+
+    std::sort( m_footprints.begin(), m_footprints.end(),
+               []( const FOOTPRINT* a, const FOOTPRINT* b )
+               {
+                   return StrNumCmp( a->GetReference(), b->GetReference(), true ) < 0;
+               } );
+
+    wxBoxSizer* mainSizer = new wxBoxSizer( wxVERTICAL );
+
+    wxFlexGridSizer* grid = new wxFlexGridSizer( 0, 2, 6, 5 );
+    grid->AddGrowableCol( 1, 1 );
+
+    grid->Add( new wxStaticText( this, wxID_ANY, _( "Source component:" ) ), 0, wxALIGN_CENTER_VERTICAL );
+    m_sourceChoice = new wxChoice( this, wxID_ANY );
+
+    int sourceIndex = wxNOT_FOUND;
+
+    // Series components are passed through; they are neither source nor destination
+    m_footprints.erase( std::remove_if( m_footprints.begin(), m_footprints.end(),
+                                        []( FOOTPRINT* aFp )
+                                        {
+                                            return XSIGNAL_STORE::IsSeriesComponent( aFp );
+                                        } ),
+                        m_footprints.end() );
+
+    for( size_t ii = 0; ii < m_footprints.size(); ++ii )
+    {
+        FOOTPRINT* fp = m_footprints[ii];
+
+        m_sourceChoice->Append( wxString::Format( _( "%s  (%s, %d pads)" ), fp->GetReference(), fp->GetValue(),
+                                                  (int) fp->Pads().size() ) );
+
+        if( fp == aSource )
+            sourceIndex = (int) ii;
+    }
+
+    if( sourceIndex != wxNOT_FOUND )
+        m_sourceChoice->SetSelection( sourceIndex );
+
+    grid->Add( m_sourceChoice, 1, wxEXPAND );
+
+    grid->Add( new wxStaticText( this, wxID_ANY, _( "Search:" ) ), 0, wxALIGN_CENTER_VERTICAL );
+    m_seriesChoice = new wxChoice( this, wxID_ANY );
+    m_seriesChoice->Append( _( "Direct connections only" ) );
+    m_seriesChoice->Append( _( "Through up to 1 series component" ) );
+    m_seriesChoice->Append( _( "Through up to 2 series components" ) );
+    m_seriesChoice->Append( _( "Through up to 3 series components" ) );
+    m_seriesChoice->SetSelection( std::clamp( s_lastSeries, 0, 3 ) );
+    grid->Add( m_seriesChoice, 1, wxEXPAND );
+
+    mainSizer->Add( grid, 0, wxEXPAND | wxALL, 10 );
+
+    wxBoxSizer* lists = new wxBoxSizer( wxHORIZONTAL );
+
+    wxBoxSizer* destSizer = new wxBoxSizer( wxVERTICAL );
+    destSizer->Add( new wxStaticText( this, wxID_ANY, _( "Destination components:" ) ), 0, wxBOTTOM, 3 );
+    m_destList = new wxCheckListBox( this, wxID_ANY, wxDefaultPosition, FromDIP( wxSize( 240, 260 ) ) );
+    destSizer->Add( m_destList, 1, wxEXPAND );
+
+    wxBoxSizer* destButtons = new wxBoxSizer( wxHORIZONTAL );
+    wxButton*   destAll = new wxButton( this, wxID_ANY, _( "Select All" ) );
+    wxButton*   destNone = new wxButton( this, wxID_ANY, _( "Select None" ) );
+    destButtons->Add( destAll, 0, wxRIGHT, 5 );
+    destButtons->Add( destNone, 0 );
+    destSizer->Add( destButtons, 0, wxTOP, 3 );
+
+    destAll->Bind( wxEVT_BUTTON,
+                   [this]( wxCommandEvent& )
+                   {
+                       for( unsigned ii = 0; ii < m_destList->GetCount(); ++ii )
+                           m_destList->Check( ii, true );
+                   } );
+
+    destNone->Bind( wxEVT_BUTTON,
+                    [this]( wxCommandEvent& )
+                    {
+                        for( unsigned ii = 0; ii < m_destList->GetCount(); ++ii )
+                            m_destList->Check( ii, false );
+                    } );
+    lists->Add( destSizer, 1, wxEXPAND | wxRIGHT, 10 );
+
+    wxBoxSizer* netSizer = new wxBoxSizer( wxVERTICAL );
+    netSizer->Add( new wxStaticText( this, wxID_ANY, _( "Source nets:" ) ), 0, wxBOTTOM, 3 );
+    m_netFilter = new wxTextCtrl( this, wxID_ANY );
+    m_netFilter->SetHint( _( "Filter, e.g. DDR_D*" ) );
+    netSizer->Add( m_netFilter, 0, wxEXPAND | wxBOTTOM, 3 );
+    m_netList = new wxCheckListBox( this, wxID_ANY, wxDefaultPosition, FromDIP( wxSize( 240, 200 ) ) );
+    netSizer->Add( m_netList, 1, wxEXPAND );
+
+    wxBoxSizer* netButtons = new wxBoxSizer( wxHORIZONTAL );
+    wxButton*   all = new wxButton( this, wxID_ANY, _( "Select All" ) );
+    wxButton*   none = new wxButton( this, wxID_ANY, _( "Select None" ) );
+    netButtons->Add( all, 0, wxRIGHT, 5 );
+    netButtons->Add( none, 0 );
+    netSizer->Add( netButtons, 0, wxTOP, 3 );
+    lists->Add( netSizer, 1, wxEXPAND );
+
+    mainSizer->Add( lists, 1, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 10 );
+
+    wxStdDialogButtonSizer* buttons = new wxStdDialogButtonSizer();
+    buttons->AddButton( new wxButton( this, wxID_OK ) );
+    buttons->AddButton( new wxButton( this, wxID_CANCEL ) );
+    buttons->Realize();
+    mainSizer->Add( buttons, 0, wxEXPAND | wxALL, 5 );
+
+    SetSizer( mainSizer );
+
+    m_sourceChoice->Bind( wxEVT_CHOICE, &DIALOG_XSIGNAL_WIZARD::onSourceChanged, this );
+    m_netFilter->Bind( wxEVT_TEXT, &DIALOG_XSIGNAL_WIZARD::onFilterChanged, this );
+    all->Bind( wxEVT_BUTTON, &DIALOG_XSIGNAL_WIZARD::onNetsAll, this );
+    none->Bind( wxEVT_BUTTON, &DIALOG_XSIGNAL_WIZARD::onNetsNone, this );
+
+    fillDestinations();
+    fillNets();
+
+    SetupStandardButtons( { { wxID_OK, _( "Analyze" ) } } );
+    finishDialogSettings();
+}
+
+
+FOOTPRINT* DIALOG_XSIGNAL_WIZARD::source() const
+{
+    int sel = m_sourceChoice->GetSelection();
+
+    if( sel == wxNOT_FOUND || sel >= (int) m_footprints.size() )
+        return nullptr;
+
+    return m_footprints[sel];
+}
+
+
+void DIALOG_XSIGNAL_WIZARD::fillDestinations()
+{
+    // Keep what is checked across a change of the source
+    std::set<FOOTPRINT*> checked( m_preselected.begin(), m_preselected.end() );
+
+    for( unsigned ii = 0; ii < m_destList->GetCount() && ii < m_destFootprints.size(); ++ii )
+    {
+        if( m_destList->IsChecked( ii ) )
+            checked.insert( m_destFootprints[ii] );
+    }
+
+    m_preselected.clear();
+    m_destList->Clear();
+    m_destFootprints.clear();
+
+    FOOTPRINT* src = source();
+
+    for( FOOTPRINT* fp : m_footprints )
+    {
+        // Single-pad parts (test points, branch points) are valid destinations
+        if( fp == src )
+            continue;
+
+        m_destFootprints.push_back( fp );
+        m_destList->Append( wxString::Format( wxS( "%s  (%s)" ), fp->GetReference(), fp->GetValue() ) );
+
+        if( checked.count( fp ) )
+            m_destList->Check( m_destList->GetCount() - 1, true );
+    }
+}
+
+
+void DIALOG_XSIGNAL_WIZARD::fillNets()
+{
+    m_netList->Clear();
+    m_netCodes.clear();
+
+    FOOTPRINT* src = source();
+
+    if( !src )
+        return;
+
+    wxString filter = m_netFilter->GetValue().Trim().Trim( false ).Upper();
+
+    if( !filter.IsEmpty() && !filter.Contains( wxS( "*" ) ) && !filter.Contains( wxS( "?" ) ) )
+        filter = wxS( "*" ) + filter + wxS( "*" );
+
+    // Count the pads of every net: nets with many pads are supplies and start unchecked
+    std::map<int, int> padCount;
+
+    for( FOOTPRINT* fp : m_frame->GetBoard()->Footprints() )
+    {
+        for( PAD* pad : fp->Pads() )
+            padCount[pad->GetNetCode()]++;
+    }
+
+    std::map<wxString, int> nets;
+
+    for( PAD* pad : src->Pads() )
+    {
+        if( pad->GetNetCode() > 0 && pad->GetNet() )
+            nets[pad->GetNetname()] = pad->GetNetCode();
+    }
+
+    for( const auto& [name, code] : nets )
+    {
+        if( !filter.IsEmpty() && !name.Upper().Matches( filter ) )
+            continue;
+
+        m_netCodes.push_back( code );
+        m_netList->Append( name );
+        m_netList->Check( m_netList->GetCount() - 1, padCount[code] <= 12 );
+    }
+}
+
+
+void DIALOG_XSIGNAL_WIZARD::onSourceChanged( wxCommandEvent& aEvent )
+{
+    fillDestinations();
+    fillNets();
+}
+
+
+void DIALOG_XSIGNAL_WIZARD::onFilterChanged( wxCommandEvent& aEvent )
+{
+    fillNets();
+}
+
+
+void DIALOG_XSIGNAL_WIZARD::onNetsAll( wxCommandEvent& aEvent )
+{
+    for( unsigned ii = 0; ii < m_netList->GetCount(); ++ii )
+        m_netList->Check( ii, true );
+}
+
+
+void DIALOG_XSIGNAL_WIZARD::onNetsNone( wxCommandEvent& aEvent )
+{
+    for( unsigned ii = 0; ii < m_netList->GetCount(); ++ii )
+        m_netList->Check( ii, false );
+}
+
+
+bool DIALOG_XSIGNAL_WIZARD::TransferDataFromWindow()
+{
+    FOOTPRINT* src = source();
+
+    if( !src )
+    {
+        DisplayError( this, _( "Choose the source component." ) );
+        return false;
+    }
+
+    std::set<FOOTPRINT*> destinations;
+
+    for( unsigned ii = 0; ii < m_destList->GetCount() && ii < m_destFootprints.size(); ++ii )
+    {
+        if( m_destList->IsChecked( ii ) )
+            destinations.insert( m_destFootprints[ii] );
+    }
+
+    if( destinations.empty() )
+    {
+        DisplayError( this, _( "Check at least one destination component." ) );
+        return false;
+    }
+
+    std::set<int> nets;
+
+    for( unsigned ii = 0; ii < m_netList->GetCount() && ii < m_netCodes.size(); ++ii )
+    {
+        if( m_netList->IsChecked( ii ) )
+            nets.insert( m_netCodes[ii] );
+    }
+
+    if( nets.empty() )
+    {
+        DisplayError( this, _( "Check at least one source net." ) );
+        return false;
+    }
+
+    s_lastSeries = m_seriesChoice->GetSelection();
+
+    std::vector<XSIGNAL_PROPOSAL> found = m_store->PathsBetweenComponents( src, destinations,
+                                                                           m_seriesChoice->GetSelection(),
+                                                                           nets );
+    m_proposals.clear();
+
+    for( const XSIGNAL_PROPOSAL& proposal : found )
+    {
+        if( !m_store->Exists( proposal.m_Signal ) )
+            m_proposals.push_back( proposal );
+    }
+
+    if( m_proposals.empty() )
+    {
+        if( found.empty() )
+        {
+            DisplayError( this, _( "No connection found between the source and the destination "
+                                   "components on the checked nets." ) );
+        }
+        else
+        {
+            DisplayError( this, _( "All connections that were found already exist as xSignals." ) );
+        }
+
+        return false;
+    }
+
+    return true;
+}
