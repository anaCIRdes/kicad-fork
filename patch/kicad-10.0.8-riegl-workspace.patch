+
+void KICAD_MANAGER_FRAME::OnWorkspaceMenu( wxCommandEvent& aEvent )
+{
+    if( !m_workspacePane )
+        return;
+
+    switch( aEvent.GetId() )
+    {
+    case ID_WORKSPACE_NEW:         m_workspacePane->NewWorkspace();     break;
+    case ID_WORKSPACE_OPEN:        m_workspacePane->OpenWorkspace();    break;
+    case ID_WORKSPACE_SAVE_AS:     m_workspacePane->SaveWorkspaceAs();  break;
+    case ID_WORKSPACE_ADD_PROJECT: m_workspacePane->AddProjectDialog(); break;
+    case ID_WORKSPACE_ADD_ACTIVE:  m_workspacePane->AddActiveProject(); break;
+    case ID_WORKSPACE_REFRESH:     m_workspacePane->RequestScan();      break;
+
+    case ID_WORKSPACE_TOGGLE_PANE:
+    {
+        wxAuiPaneInfo& pane = m_auimgr.GetPane( m_workspacePane );
+        pane.Show( !pane.IsShown() );
+        m_auimgr.Update();
+        break;
+    }
+
+    default:
+        break;
+    }
+}
+
+
+void KICAD_MANAGER_FRAME::StartWorkspaceChild( const wxString& aOpen, bool aProjectLoaded )
+{
+    // Never restore the editors that were open in the last session of this project: the
+    // workspace asked for exactly one editor.
+    m_openSavedWindows = false;
+
+    if( !aProjectLoaded )
+    {
+        // Loading failed or the user declined to open a project that is in use elsewhere.
+        CallAfter(
+                [this]()
+                {
+                    Close( true );
+                } );
+        return;
+    }
+
+    m_wsChildTimer.SetOwner( this );
+    Bind( wxEVT_TIMER, &KICAD_MANAGER_FRAME::onWorkspaceChildTimer, this, m_wsChildTimer.GetId() );
+
+    CallAfter(
+            [this, aOpen]()
+            {
+                runWorkspaceChildCommand( aOpen );
+                m_wsChildStarted = true;
+                m_wsChildTimer.Start( 400 );
+            } );
+}
+
+
+void KICAD_MANAGER_FRAME::runWorkspaceChildCommand( const wxString& aCommand )
+{
+    if( aCommand == wxS( "quit" ) )
+    {
+        Close( false );
+        return;
+    }
+
+    if( m_wsChildBusy )
+        return;
+
+    m_wsChildBusy = true;
+
+    if( aCommand == wxS( "sch" ) )
+        GetToolManager()->RunAction( KICAD_MANAGER_ACTIONS::editSchematic );
+    else if( aCommand == wxS( "pcb" ) )
+        GetToolManager()->RunAction( KICAD_MANAGER_ACTIONS::editPCB );
+
+    m_wsChildBusy = false;
+}
+
+
+void KICAD_MANAGER_FRAME::onWorkspaceChildTimer( wxTimerEvent& aEvent )
+{
+    if( m_wsChildBusy || m_isClosing || !m_wsChildStarted )
+        return;
+
+    int  visibleWindows = 0;
+    bool modalActive = false;
+
+    for( wxWindowList::compatibility_iterator node = wxTopLevelWindows.GetFirst(); node;
+         node = node->GetNext() )
+    {
+        wxWindow* win = node->GetData();
+
+        if( win == this || !win->IsShown() )
+            continue;
+
+        visibleWindows++;
+
+        if( wxDialog* dlg = dynamic_cast<wxDialog*>( win ) )
+            modalActive |= dlg->IsModal();
+    }
+
+    // Commands of the workspace manager: one small file per command, processed in order.
+    if( !modalActive && wxDir::Exists( s_WorkspaceChildDir ) )
+    {
+        wxArrayString files;
+
+        {
+            wxLogNull noLog;
+            wxDir::GetAllFiles( s_WorkspaceChildDir, &files, wxS( "*.cmd" ), wxDIR_FILES );
+        }
+
+        files.Sort();
+
+        for( const wxString& file : files )
+        {
+            wxString command;
+
+            {
+                wxLogNull noLog;
+                wxFFile   in( file, wxS( "rb" ) );
+
+                if( in.IsOpened() )
+                    in.ReadAll( &command, wxConvUTF8 );
+            }
+
+            wxRemoveFile( file );
+            command.Trim().Trim( false );
+
+            if( command.IsEmpty() )
+                continue;
+
+            runWorkspaceChildCommand( command );
+
+            // Anything may have happened while the editor was opening; start over next tick.
+            return;
+        }
+    }
+
+    // The helper ends together with its last editor window.
+    if( visibleWindows == 0 )
+    {
+        if( ++m_wsChildIdleTicks >= 3 )
+        {
+            m_wsChildTimer.Stop();
+            Close( false );
+        }
+    }
+    else
+    {
+        m_wsChildIdleTicks = 0;
+    }
+}
+
