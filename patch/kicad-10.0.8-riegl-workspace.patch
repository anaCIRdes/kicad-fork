+void XSIGNAL_TOOL::create( const std::vector<XSIGNAL_PROPOSAL>& aProposals, const wxString& aTitle )
+{
+    XSIGNAL_STORE* store = m_frame->GetBoard()->XSignals();
+
+    DIALOG_XSIGNAL_ADD dlg( m_frame, store, aProposals, aTitle );
+
+    if( dlg.ShowModal() != wxID_OK )
+        return;
+
+    m_frame->OnModify();
+    showPanel();
+
+    if( XSIGNAL_PANEL* panel = m_frame->GetXSignalsPanel() )
+        panel->ShowSignals( dlg.GetCreated() );
+}
