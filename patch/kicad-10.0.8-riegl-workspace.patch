+
+// ---------------------------------------------------------------------------------------------
+// Measuring
+// ---------------------------------------------------------------------------------------------
+
+XSIGNAL_STORE::SECTION_RESULT XSIGNAL_STORE::measureSection( PAD* aFrom, PAD* aTo ) const
+{
+    SECTION_RESULT result;
+
+    std::shared_ptr<CONNECTIVITY_DATA> connectivity = m_board->GetConnectivity();
+
+    if( !connectivity || !aFrom || !aTo )
+        return result;
+
+    std::shared_ptr<CN_CONNECTIVITY_ALGO> algo = connectivity->GetConnectivityAlgo();
+
+    if( !algo || !algo->ItemExists( aFrom ) || !algo->ItemExists( aTo ) )
+        return result;
+
+    const int net = aFrom->GetNetCode();
+
+    // Shortest path over the items of the net.  Tracks cost their length, everything else is
+    // (nearly) free, so the search follows the copper and passes through intermediate pads.
+    using QUEUE_ENTRY = std::pair<double, BOARD_CONNECTED_ITEM*>;
+
+    std::unordered_map<BOARD_CONNECTED_ITEM*, double>                cost;
+    std::unordered_map<BOARD_CONNECTED_ITEM*, BOARD_CONNECTED_ITEM*> previous;
+    std::priority_queue<QUEUE_ENTRY, std::vector<QUEUE_ENTRY>, std::greater<QUEUE_ENTRY>> queue;
+
+    cost[aFrom] = 0.0;
+    queue.push( { 0.0, aFrom } );
+
+    bool found = false;
+
+    while( !queue.empty() )
+    {
+        auto [currentCost, current] = queue.top();
+        queue.pop();
+
+        if( currentCost > cost[current] )
+            continue;
+
+        if( current == aTo )
+        {
+            found = true;
+            break;
+        }
+
+        if( !algo->ItemExists( current ) )
+            continue;
+
+        for( CN_ITEM* cnItem : algo->ItemEntry( current ).GetItems() )
+        {
+            for( CN_ITEM* connected : cnItem->ConnectedItems() )
+            {
+                if( !connected || !connected->Valid() )
+                    continue;
+
+                BOARD_CONNECTED_ITEM* next = connected->Parent();
+
+                if( !next || next == current || next->GetNetCode() != net )
+                    continue;
+
+                double step = 0.0;
+
+                switch( next->Type() )
+                {
+                case PCB_TRACE_T:
+                case PCB_ARC_T:
+                    step = static_cast<PCB_TRACK*>( next )->GetLength();
+                    break;
+
+                case PCB_VIA_T:
+                    step = 1.0;
+                    break;
+
+                case PCB_PAD_T:
+                    step = 0.0;
+                    break;
+
+                default:
+                    continue;   // zones and copper shapes are not followed
+                }
+
+                double nextCost = currentCost + step;
+                auto   it = cost.find( next );
+
+                if( it == cost.end() || nextCost < it->second )
+                {
+                    cost[next] = nextCost;
+                    previous[next] = current;
+                    queue.push( { nextCost, next } );
+                }
+            }
+        }
+    }
+
+    if( !found )
+        return result;
+
+    for( BOARD_CONNECTED_ITEM* item = aTo; item; )
+    {
+        result.items.push_back( item );
+
+        auto it = previous.find( item );
+        item = it == previous.end() ? nullptr : it->second;
+    }
+
+    std::reverse( result.items.begin(), result.items.end() );
+
+    LENGTH_DELAY_CALCULATION* calc = m_board->GetLengthCalculation();
+
+    if( !calc )
+        return result;
+
+    std::vector<LENGTH_DELAY_CALCULATION_ITEM> lengthItems;
+    lengthItems.reserve( result.items.size() );
+
+    for( BOARD_CONNECTED_ITEM* item : result.items )
+    {
+        // Pads in the middle of the path only pass the signal on
+        if( item->Type() == PCB_PAD_T && item != aFrom && item != aTo )
+            continue;
+
+        LENGTH_DELAY_CALCULATION_ITEM lengthItem = calc->GetLengthCalculationItem( item );
+
+        if( lengthItem.Type() != LENGTH_DELAY_CALCULATION_ITEM::TYPE::UNKNOWN )
+            lengthItems.emplace_back( lengthItem );
+    }
+
+    constexpr PATH_OPTIMISATIONS opts = {
+        .OptimiseVias = true, .MergeTracks = true, .OptimiseTracesInPads = true, .InferViaInPad = false
+    };
+
+    LENGTH_DELAY_STATS stats = calc->CalculateLengthDetails( lengthItems, opts, aFrom, aTo,
+                                                             LENGTH_DELAY_LAYER_OPT::NO_LAYER_DETAIL,
+                                                             LENGTH_DELAY_DOMAIN_OPT::WITH_DELAY_DETAIL );
+
+    result.routed = true;
+    result.track = stats.TrackLength;
+    result.via = stats.ViaLength;
+    result.padToDie = stats.PadToDieLength;
+    result.delay = stats.TotalDelay();
+    result.viaCount = stats.NumVias;
+    return result;
+}
+
+
+XSIGNAL_METRICS XSIGNAL_STORE::Measure( const XSIGNAL& aSignal ) const
+{
+    XSIGNAL_METRICS m;
+
+    if( !m_board )
+        return m;
+
+    if( aSignal.m_WholeNet )
+    {
+        NETINFO_ITEM* net = m_board->FindNet( aSignal.m_Net );
+
+        if( !net || net->GetNetCode() <= 0 )
+        {
+            m.m_Status = XSIGNAL_STATUS::BROKEN;
+            m.m_Problem = wxString::Format( _( "Net '%s' not found" ), aSignal.m_Net );
+            return m;
+        }
+
+        std::shared_ptr<CONNECTIVITY_DATA> connectivity = m_board->GetConnectivity();
+        LENGTH_DELAY_CALCULATION*          calc = m_board->GetLengthCalculation();
+
+        if( !connectivity || !calc )
+            return m;
+
+        m.m_Resolved = true;
+
+        std::vector<LENGTH_DELAY_CALCULATION_ITEM> lengthItems;
+
+        for( BOARD_CONNECTED_ITEM* item : connectivity->GetNetItems( net->GetNetCode(),
+                                                  { PCB_PAD_T, PCB_TRACE_T, PCB_ARC_T, PCB_VIA_T } ) )
+        {
+            m.m_Items.push_back( item );
+
+            if( item->Type() == PCB_PAD_T )
+            {
+                m.m_Pads.push_back( static_cast<PAD*>( item ) );
+                m.m_NodeCount++;
+            }
+
+            LENGTH_DELAY_CALCULATION_ITEM lengthItem = calc->GetLengthCalculationItem( item );
+
+            if( lengthItem.Type() != LENGTH_DELAY_CALCULATION_ITEM::TYPE::UNKNOWN )
+                lengthItems.emplace_back( lengthItem );
+        }
+
+        constexpr PATH_OPTIMISATIONS opts = {
+            .OptimiseVias = true, .MergeTracks = true, .OptimiseTracesInPads = true, .InferViaInPad = false
+        };
+
+        LENGTH_DELAY_STATS stats = calc->CalculateLengthDetails( lengthItems, opts, nullptr, nullptr,
+                                                                 LENGTH_DELAY_LAYER_OPT::NO_LAYER_DETAIL,
+                                                                 LENGTH_DELAY_DOMAIN_OPT::WITH_DELAY_DETAIL );
+
+        m.m_TrackLength = stats.TrackLength;
+        m.m_ViaLength = stats.ViaLength;
+        m.m_PadToDie = stats.PadToDieLength;
+        m.m_Delay = stats.TotalDelay();
+        m.m_ViaCount = stats.NumVias;
+        m.m_Routed = true;
+
+        if( RN_NET* ratsnest = connectivity->GetRatsnestForNet( net->GetNetCode() ) )
+        {
+            for( const CN_EDGE& edge : ratsnest->GetEdges() )
+            {
+                VECTOR2I delta = edge.GetTargetPos() - edge.GetSourcePos();
+                m.m_Unrouted += std::abs( (int64_t) delta.x ) + std::abs( (int64_t) delta.y );
+                m.m_Routed = false;
+            }
+        }
+
+        if( !m.m_Routed )
+            m.m_Problem = _( "Net is not completely routed" );
+
+        m.m_Sections.push_back( { net->GetNetCode(), m.SignalLength() } );
+        return m;
+    }
+
+    if( aSignal.m_Nodes.size() < 2 || aSignal.m_Nodes.size() % 2 != 0 )
+    {
+        m.m_Status = XSIGNAL_STATUS::BROKEN;
+        m.m_Problem = _( "Invalid path definition" );
+        return m;
+    }
+
+    std::vector<PAD*> pads;
+
+    for( const XSIGNAL_NODE& node : aSignal.m_Nodes )
+    {
+        PAD* pad = ResolveNode( node );
+
+        if( !pad )
+        {
+            m.m_Status = XSIGNAL_STATUS::BROKEN;
+            m.m_Problem = wxString::Format( _( "Pad %s not found" ), node.Label() );
+            return m;
+        }
+
+        pads.push_back( pad );
+    }
+
+    m.m_Pads = pads;
+    m.m_NodeCount = static_cast<int>( pads.size() );
+    m.m_Resolved = true;
+    m.m_Routed = true;
+
+    for( size_t ii = 0; ii + 1 < pads.size(); ii += 2 )
+    {
+        PAD* from = pads[ii];
+        PAD* to = pads[ii + 1];
+
+        if( from->GetNetCode() != to->GetNetCode() || from->GetNetCode() <= 0 )
+        {
+            m.m_Status = XSIGNAL_STATUS::BROKEN;
+            m.m_Resolved = false;
+            m.m_Routed = false;
+            m.m_Problem = wxString::Format( _( "Pads %s and %s are not in the same net" ),
+                                            aSignal.m_Nodes[ii].Label(), aSignal.m_Nodes[ii + 1].Label() );
+            return m;
+        }
+
+        SECTION_RESULT section = measureSection( from, to );
+
+        if( section.routed )
+        {
+            m.m_TrackLength += section.track;
+            m.m_ViaLength += section.via;
+            m.m_PadToDie += section.padToDie;
+            m.m_Delay += section.delay;
+            m.m_ViaCount += section.viaCount;
+            m.m_Sections.push_back( { from->GetNetCode(), section.track + section.via + section.padToDie } );
+
+            for( BOARD_CONNECTED_ITEM* item : section.items )
+                m.m_Items.push_back( item );
+        }
+        else
+        {
+            VECTOR2I delta = to->GetPosition() - from->GetPosition();
+            int64_t  estimate = std::abs( (int64_t) delta.x ) + std::abs( (int64_t) delta.y );
+
+            m.m_Unrouted += estimate;
+            m.m_Routed = false;
+            m.m_Sections.push_back( { from->GetNetCode(), estimate } );
+            m.m_Items.push_back( from );
+            m.m_Items.push_back( to );
+
+            if( m.m_Problem.IsEmpty() )
+            {
+                m.m_Problem = wxString::Format( _( "No track path between %s and %s" ),
+                                                aSignal.m_Nodes[ii].Label(),
+                                                aSignal.m_Nodes[ii + 1].Label() );
+            }
+        }
+    }
+
+    return m;
+}
+
+
+void XSIGNAL_STORE::evaluate( std::vector<XSIGNAL_METRICS>& aMetrics ) const
+{
+    const int64_t unlimited = std::numeric_limits<int64_t>::max();
+
+    for( size_t ii = 0; ii < m_signals.size(); ++ii )
+    {
+        XSIGNAL_METRICS& m = aMetrics[ii];
+
+        if( !m.m_Resolved )
+            m.m_Status = XSIGNAL_STATUS::BROKEN;
+        else if( !m.m_Routed )
+            m.m_Status = XSIGNAL_STATUS::UNROUTED;
+        else
+            m.m_Status = XSIGNAL_STATUS::NO_RULE;
+    }
+
+    for( const XSIGNAL_CLASS& cls : m_classes )
+    {
+        if( !cls.HasConstraint() )
+            continue;
+
+        std::vector<size_t> members;
+
+        for( size_t ii = 0; ii < m_signals.size(); ++ii )
+        {
+            if( m_signals[ii].m_Class == cls.m_Name )
+                members.push_back( ii );
+        }
+
+        bool     haveReference = false;
+        int64_t  reference = 0;
+        wxString referenceName;
+
+        if( cls.m_Match == XSIGNAL_MATCH::LONGEST )
+        {
+            for( size_t idx : members )
+            {
+                const XSIGNAL_METRICS& m = aMetrics[idx];
+
+                if( m.m_Resolved && m.m_Routed && ( !haveReference || m.SignalLength() > reference ) )
+                {
+                    haveReference = true;
+                    reference = m.SignalLength();
+                    referenceName = m_signals[idx].m_Name;
+                }
+            }
+        }
+        else if( cls.m_Match == XSIGNAL_MATCH::MEMBER )
+        {
+            for( size_t idx : members )
+            {
+                const XSIGNAL_METRICS& m = aMetrics[idx];
+
+                if( m_signals[idx].m_Name == cls.m_Reference && m.m_Resolved && m.m_Routed )
+                {
+                    haveReference = true;
+                    reference = m.SignalLength();
+                    referenceName = m_signals[idx].m_Name;
+                }
+            }
+        }
+        else if( cls.m_Match == XSIGNAL_MATCH::TARGET )
+        {
+            haveReference = true;
+            reference = cls.m_Target;
+        }
+
+        for( size_t idx : members )
+        {
+            XSIGNAL_METRICS& m = aMetrics[idx];
+            int64_t          lo = 0;
+            int64_t          hi = unlimited;
+            bool             window = false;
+
+            if( haveReference )
+            {
+                window = true;
+                lo = reference - cls.m_Tolerance;
+                hi = cls.m_Match == XSIGNAL_MATCH::LONGEST ? reference : reference + cls.m_Tolerance;
+                m.m_ReferenceLength = reference;
+                m.m_ReferenceName = referenceName;
+            }
+
+            if( cls.m_MinLength > 0 )
+            {
+                window = true;
+                lo = std::max( lo, cls.m_MinLength );
+            }
+
+            if( cls.m_MaxLength > 0 )
+            {
+                window = true;
+                hi = std::min( hi, cls.m_MaxLength );
+            }
+
+            if( !window )
+                continue;
+
+            m.m_HasWindow = true;
+            m.m_WindowMin = std::max<int64_t>( lo, 0 );
+            m.m_WindowMax = hi;
+
+            if( !m.m_Resolved || !m.m_Routed )
+                continue;
+
+            int64_t len = m.SignalLength();
+
+            if( len < m.m_WindowMin )
+                m.m_Status = XSIGNAL_STATUS::TOO_SHORT;
+            else if( len > m.m_WindowMax )
+                m.m_Status = XSIGNAL_STATUS::TOO_LONG;
+            else
+                m.m_Status = XSIGNAL_STATUS::MATCHED;
+        }
+    }
+}
+
+
+std::vector<XSIGNAL_METRICS> XSIGNAL_STORE::MeasureAll() const
+{
+    std::vector<XSIGNAL_METRICS> metrics;
+    metrics.reserve( m_signals.size() );
+
+    for( const XSIGNAL& sig : m_signals )
+        metrics.push_back( Measure( sig ) );
+
+    evaluate( metrics );
+    return metrics;
+}
+
+
+std::vector<wxString> XSIGNAL_STORE::SignalsContaining( const BOARD_CONNECTED_ITEM* aItem ) const
+{
+    std::vector<wxString> names;
+
+    if( !aItem )
+        return names;
+
+    for( const XSIGNAL& sig : m_signals )
+    {
+        XSIGNAL_METRICS m = Measure( sig );
+
+        if( std::find( m.m_Items.begin(), m.m_Items.end(), aItem ) != m.m_Items.end() )
+            names.push_back( sig.m_Name );
+    }
+
+    return names;
+}
+
+
+bool XSIGNAL_STORE::TuningTarget( const BOARD_CONNECTED_ITEM* aItem, int& aMin, int& aOpt, int& aMax,
+                                  wxString* aInfo ) const
+{
+    if( !aItem || m_signals.empty() )
+        return false;
+
+    // Cheap rejection before measuring everything: is there a constrained signal at all?
+    bool anyConstraint = false;
+
+    for( const XSIGNAL_CLASS& cls : m_classes )
+        anyConstraint |= cls.HasConstraint();
+
+    if( !anyConstraint )
+        return false;
+
+    const int64_t                unlimited = std::numeric_limits<int64_t>::max();
+    std::vector<XSIGNAL_METRICS> metrics = MeasureAll();
+
+    // Prefer pad-to-pad signals over whole-net members
+    for( int pass = 0; pass < 2; ++pass )
+    {
+        for( size_t ii = 0; ii < m_signals.size(); ++ii )
+        {
+            const XSIGNAL&         sig = m_signals[ii];
+            const XSIGNAL_METRICS& m = metrics[ii];
+
+            if( sig.m_WholeNet != ( pass == 1 ) || sig.m_Class.IsEmpty() || !m.m_Resolved || !m.m_Routed )
+                continue;
+
+            if( std::find( m.m_Items.begin(), m.m_Items.end(), aItem ) == m.m_Items.end() )
+                continue;
+
+            const XSIGNAL_CLASS* cls = const_cast<XSIGNAL_STORE*>( this )->FindClass( sig.m_Class );
+
+            if( !cls || !cls->HasConstraint() )
+                continue;
+
+            int64_t lo = 0;
+            int64_t hi = unlimited;
+            int64_t opt = 0;
+            bool    haveOpt = false;
+
+            if( cls->m_Match == XSIGNAL_MATCH::LONGEST )
+            {
+                // What this signal may be, given all the *other* members as they are now
+                bool    haveOthers = false;
+                int64_t maxOthers = 0;
+                int64_t minOthers = unlimited;
+
+                for( size_t jj = 0; jj < m_signals.size(); ++jj )
+                {
+                    if( jj == ii || m_signals[jj].m_Class != sig.m_Class )
+                        continue;
+
+                    if( !metrics[jj].m_Resolved || !metrics[jj].m_Routed )
+                        continue;
+
+                    haveOthers = true;
+                    maxOthers = std::max( maxOthers, metrics[jj].SignalLength() );
+                    minOthers = std::min( minOthers, metrics[jj].SignalLength() );
+                }
+
+                if( haveOthers )
+                {
+                    lo = maxOthers - cls->m_Tolerance;
+                    hi = minOthers + cls->m_Tolerance;
+
+                    if( hi < maxOthers )
+                        hi = maxOthers;
+
+                    opt = maxOthers;
+                    haveOpt = true;
+                }
+            }
+            else if( cls->m_Match == XSIGNAL_MATCH::MEMBER )
+            {
+                if( sig.m_Name != cls->m_Reference && m.m_HasWindow && m.m_ReferenceLength > 0 )
+                {
+                    lo = m.m_ReferenceLength - cls->m_Tolerance;
+                    hi = m.m_ReferenceLength + cls->m_Tolerance;
+                    opt = m.m_ReferenceLength;
+                    haveOpt = true;
+                }
+            }
+            else if( cls->m_Match == XSIGNAL_MATCH::TARGET )
+            {
+                lo = cls->m_Target - cls->m_Tolerance;
+                hi = cls->m_Target + cls->m_Tolerance;
+                opt = cls->m_Target;
+                haveOpt = true;
+            }
+
+            if( cls->m_MinLength > 0 )
+            {
+                lo = std::max( lo, cls->m_MinLength );
+
+                if( !haveOpt )
+                {
+                    opt = cls->m_MinLength;
+                    haveOpt = true;
+                }
+            }
+
+            if( cls->m_MaxLength > 0 )
+                hi = std::min( hi, cls->m_MaxLength );
+
+            if( !haveOpt )
+                continue;
+
+            opt = std::clamp( opt, lo, std::max( lo, hi ) );
+
+            // The tuning tool measures only the routed section it works on; the rest of the
+            // xSignal (other sections behind series components) is constant.
+            int64_t sectionLength = 0;
+
+            for( const auto& [netCode, length] : m.m_Sections )
+            {
+                if( netCode == aItem->GetNetCode() )
+                    sectionLength += length;
+            }
+
+            const int64_t rest = m.SignalLength() - sectionLength;
+            const int64_t intMax = std::numeric_limits<int>::max();
+
+            lo = std::max<int64_t>( lo - rest, 0 );
+            opt = opt - rest;
+            hi = hi == unlimited ? intMax : hi - rest;
+
+            if( opt <= 0 || hi <= 0 || opt > intMax )
+                continue;
+
+            aMin = static_cast<int>( std::min( lo, intMax ) );
+            aOpt = static_cast<int>( opt );
+            aMax = static_cast<int>( std::min( hi, intMax ) );
+
+            if( aInfo )
+                *aInfo = wxString::Format( _( "xSignal %s, class %s" ), sig.m_Name, sig.m_Class );
+
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// Creating
+// ---------------------------------------------------------------------------------------------
+
+/// Pads of a footprint that take part in the circuit, one per pad number
+static std::vector<PAD*> electricalPads( const FOOTPRINT* aFootprint )
+{
+    std::vector<PAD*>  pads;
+    std::set<wxString> numbers;
+
+    if( !aFootprint )
+        return pads;
+
+    for( PAD* pad : aFootprint->Pads() )
+    {
+        if( pad->GetNumber().IsEmpty() || !pad->IsOnCopperLayer() )
+            continue;
+
+        if( numbers.insert( pad->GetNumber() ).second )
+            pads.push_back( pad );
+    }
+
+    return pads;
+}
+
+
+PAD* XSIGNAL_STORE::SeriesPartner( const PAD* aPad )
+{
+    if( !aPad )
+        return nullptr;
+
+    const FOOTPRINT* fp = aPad->GetParentFootprint();
+
+    if( !fp )
+        return nullptr;
+
+    std::vector<PAD*> pads = electricalPads( fp );
+
+    // Two-terminal part: resistor, capacitor, inductor, ferrite bead, ...
+    if( pads.size() == 2 )
+    {
+        if( pads[0]->GetNumber() == aPad->GetNumber() )
+            return pads[1];
+
+        if( pads[1]->GetNumber() == aPad->GetNumber() )
+            return pads[0];
+
+        return nullptr;
+    }
+
+    // Arrays of two-terminal parts with the usual numbering: pad k is opposite pad N+1-k
+    const size_t count = pads.size();
+
+    if( count < 4 || count > 16 || count % 2 != 0 )
+        return nullptr;
+
+    wxString ref = fp->GetReference().Upper();
+    bool     isArray = false;
+
+    for( const wxString& prefix : { wxString( wxS( "RN" ) ), wxString( wxS( "RP" ) ), wxString( wxS( "RA" ) ),
+                                    wxString( wxS( "FB" ) ), wxString( wxS( "R" ) ),  wxString( wxS( "C" ) ) } )
+    {
+        if( ref.StartsWith( prefix ) )
+        {
+            wxString rest = ref.Mid( prefix.length() );
+
+            // "R12" is an array of resistors, "RJ1" or "CON3" is something else
+            if( rest.IsEmpty() || wxIsdigit( rest[0] ) )
+            {
+                isArray = true;
+                break;
+            }
+        }
+    }
+
+    if( !isArray )
+        return nullptr;
+
+    long number = 0;
+
+    if( !aPad->GetNumber().ToLong( &number ) || number < 1 || number > (long) count )
+        return nullptr;
+
+    wxString partnerNumber = wxString::Format( wxS( "%ld" ), (long) count + 1 - number );
+
+    for( PAD* pad : pads )
+    {
+        long n = 0;
+
+        if( !pad->GetNumber().ToLong( &n ) || n < 1 || n > (long) count )
+            return nullptr;     // not a plainly numbered array
+    }
+
+    for( PAD* pad : pads )
+    {
+        if( pad->GetNumber() == partnerNumber )
+            return pad;
+    }
+
+    return nullptr;
+}
+
+
+bool XSIGNAL_STORE::IsSeriesComponent( const FOOTPRINT* aFootprint )
+{
+    for( PAD* pad : electricalPads( aFootprint ) )
+    {
+        if( SeriesPartner( pad ) )
+            return true;
+    }
+
+    return false;
+}
+
+
+/// net code -> pads, one entry per footprint pad number
+static std::map<int, std::vector<PAD*>> padsByNet( const BOARD* aBoard )
+{
+    std::map<int, std::vector<PAD*>> map;
+
+    for( FOOTPRINT* fp : aBoard->Footprints() )
+    {
+        for( PAD* pad : electricalPads( fp ) )
+        {
+            if( pad->GetNetCode() > 0 )
+                map[pad->GetNetCode()].push_back( pad );
+        }
+    }
+
+    return map;
+}
+
+
+bool XSIGNAL_STORE::PathBetweenPads( PAD* aStart, PAD* aEnd, int aMaxSeries, XSIGNAL& aSignal ) const
+{
+    if( !m_board || !aStart || !aEnd || aStart == aEnd )
+        return false;
+
+    if( aStart->GetNetCode() <= 0 || aEnd->GetNetCode() <= 0 )
+        return false;
+
+    aSignal.m_WholeNet = false;
+    aSignal.m_Net.clear();
+    aSignal.m_Nodes.clear();
+
+    if( aStart->GetNetCode() == aEnd->GetNetCode() )
+    {
+        aSignal.m_Nodes.push_back( NodeFor( aStart ) );
+        aSignal.m_Nodes.push_back( NodeFor( aEnd ) );
+        return true;
+    }
+
+    // Breadth-first search over nets; an edge is a series component
+    struct STEP
+    {
+        int  net;
+        int  parent;      // index into steps, -1 for the start
+        PAD* in;          // pad of the series component in the parent net
+        PAD* out;         // its partner in this net
+        int  depth;
+    };
+
+    std::map<int, std::vector<PAD*>> netPads = padsByNet( m_board );
+    std::vector<STEP>                steps;
+    std::set<int>                    visited;
+
+    steps.push_back( { aStart->GetNetCode(), -1, nullptr, nullptr, 0 } );
+    visited.insert( aStart->GetNetCode() );
+
+    int goal = -1;
+
+    for( size_t ii = 0; ii < steps.size() && goal < 0; ++ii )
+    {
+        const STEP step = steps[ii];
+
+        if( step.depth >= aMaxSeries )
+            continue;
+
+        for( PAD* pad : netPads[step.net] )
+        {
+            if( pad == aStart || pad == aEnd )
+                continue;
+
+            PAD* partner = SeriesPartner( pad );
+
+            if( !partner || partner->GetNetCode() <= 0 || visited.count( partner->GetNetCode() ) )
+                continue;
+
+            const bool isGoal = partner->GetNetCode() == aEnd->GetNetCode();
+
+            if( !isGoal && netPads[partner->GetNetCode()].size() > XSIGNAL_MAX_NET_PADS )
+                continue;       // do not wander through supply nets
+
+            visited.insert( partner->GetNetCode() );
+            steps.push_back( { partner->GetNetCode(), (int) ii, pad, partner, step.depth + 1 } );
+
+            if( isGoal )
+            {
+                goal = (int) steps.size() - 1;
+                break;
+            }
+        }
+    }
+
+    if( goal < 0 )
+        return false;
+
+    std::vector<XSIGNAL_NODE> reversed;
+    reversed.push_back( NodeFor( aEnd ) );
+
+    for( int idx = goal; idx >= 0 && steps[idx].parent >= 0; idx = steps[idx].parent )
+    {
+        reversed.push_back( NodeFor( steps[idx].out ) );
+        reversed.push_back( NodeFor( steps[idx].in ) );
+    }
+
+    reversed.push_back( NodeFor( aStart ) );
+
+    aSignal.m_Nodes.assign( reversed.rbegin(), reversed.rend() );
+    return true;
+}
+
+
+std::vector<XSIGNAL_PROPOSAL>
+XSIGNAL_STORE::PathsThroughComponents( const std::vector<FOOTPRINT*>& aSeries, wxString* aSkipped ) const
+{
+    std::vector<XSIGNAL_PROPOSAL> proposals;
+
+    if( !m_board )
+        return proposals;
+
+    std::map<int, std::vector<PAD*>> netPads = padsByNet( m_board );
+
+    for( FOOTPRINT* fp : aSeries )
+    {
+        std::set<const PAD*> done;
+
+        for( PAD* pad : electricalPads( fp ) )
+        {
+            PAD* partner = SeriesPartner( pad );
+
+            if( !partner || done.count( pad ) || done.count( partner ) )
+                continue;
+
+            done.insert( pad );
+            done.insert( partner );
+
+            if( pad->GetNetCode() <= 0 || partner->GetNetCode() <= 0
+                || pad->GetNetCode() == partner->GetNetCode() )
+            {
+                continue;
+            }
+
+            std::vector<PAD*> sideA;
+            std::vector<PAD*> sideB;
+
+            for( PAD* other : netPads[pad->GetNetCode()] )
+            {
+                if( other->GetParentFootprint() != fp )
+                    sideA.push_back( other );
+            }
+
+            for( PAD* other : netPads[partner->GetNetCode()] )
+            {
+                if( other->GetParentFootprint() != fp )
+                    sideB.push_back( other );
+            }
+
+            if( sideA.empty() || sideB.empty() )
+                continue;
+
+            if( sideA.size() > XSIGNAL_MAX_NET_PADS || sideB.size() > XSIGNAL_MAX_NET_PADS )
+            {
+                if( aSkipped )
+                {
+                    if( !aSkipped->IsEmpty() )
+                        *aSkipped += wxS( ", " );
+
+                    *aSkipped += fp->GetReference() + wxS( "." ) + pad->GetNumber();
+                }
+
+                continue;
+            }
+
+            for( PAD* a : sideA )
+            {
+                for( PAD* b : sideB )
+                {
+                    XSIGNAL_PROPOSAL proposal;
+                    proposal.m_Signal.m_Nodes = { NodeFor( a ), NodeFor( pad ), NodeFor( partner ), NodeFor( b ) };
+                    proposal.m_SourceNet = a->GetNetname();
+                    proposals.push_back( proposal );
+
+                    if( proposals.size() >= XSIGNAL_MAX_PROPOSALS )
+                        return proposals;
+                }
+            }
+        }
+    }
+
+    return proposals;
+}
+
+
+std::vector<XSIGNAL_PROPOSAL>
+XSIGNAL_STORE::PathsBetweenComponents( FOOTPRINT* aSource, const std::set<FOOTPRINT*>& aDestinations,
+                                       int aMaxSeries, const std::set<int>& aNets ) const
+{
+    std::vector<XSIGNAL_PROPOSAL> proposals;
+
+    if( !m_board || !aSource || aDestinations.empty() )
+        return proposals;
+
+    std::map<int, std::vector<PAD*>> netPads = padsByNet( m_board );
+
+    for( PAD* start : electricalPads( aSource ) )
+    {
+        const int startNet = start->GetNetCode();
+
+        if( startNet <= 0 )
+            continue;
+
+        if( !aNets.empty() )
+        {
+            if( !aNets.count( startNet ) )
+                continue;
+        }
+        else if( netPads[startNet].size() > XSIGNAL_MAX_NET_PADS )
+        {
+            continue;
+        }
+
+        std::vector<XSIGNAL_NODE> chain;
+        std::set<int>             visited;
+
+        chain.push_back( NodeFor( start ) );
+        visited.insert( startNet );
+
+        std::function<void( int, int )> walk =
+                [&]( int aNet, int aDepth )
+                {
+                    for( PAD* pad : netPads[aNet] )
+                    {
+                        if( pad == start || proposals.size() >= XSIGNAL_MAX_PROPOSALS )
+                            continue;
+
+                        FOOTPRINT* fp = pad->GetParentFootprint();
+
+                        if( aDestinations.count( fp ) )
+                        {
+                            XSIGNAL_PROPOSAL proposal;
+                            proposal.m_Signal.m_Nodes = chain;
+                            proposal.m_Signal.m_Nodes.push_back( NodeFor( pad ) );
+                            proposal.m_SourceNet = start->GetNetname();
+                            proposals.push_back( proposal );
+                        }
+                    }
+
+                    if( aDepth >= aMaxSeries )
+                        return;
+
+                    for( PAD* pad : netPads[aNet] )
+                    {
+                        FOOTPRINT* fp = pad->GetParentFootprint();
+
+                        if( pad == start || fp == aSource || aDestinations.count( fp ) )
+                            continue;
+
+                        PAD* partner = SeriesPartner( pad );
+
+                        if( !partner || partner->GetNetCode() <= 0 || visited.count( partner->GetNetCode() ) )
+                            continue;
+
+                        if( netPads[partner->GetNetCode()].size() > XSIGNAL_MAX_NET_PADS )
+                            continue;
+
+                        visited.insert( partner->GetNetCode() );
+                        chain.push_back( NodeFor( pad ) );
+                        chain.push_back( NodeFor( partner ) );
+
+                        walk( partner->GetNetCode(), aDepth + 1 );
+
+                        chain.pop_back();
+                        chain.pop_back();
+                        visited.erase( partner->GetNetCode() );
+                    }
+                };
+
+        walk( startNet, 0 );
+    }
+
+    return proposals;
+}
+
+
+XSIGNAL XSIGNAL_STORE::SignalForNet( int aNetCode ) const
+{
+    XSIGNAL sig;
+
+    if( !m_board )
+        return sig;
+
+    NETINFO_ITEM* net = m_board->FindNet( aNetCode );
+
+    if( !net || aNetCode <= 0 )
+        return sig;
+
+    std::vector<PAD*> pads;
+
+    for( FOOTPRINT* fp : m_board->Footprints() )
+    {
+        for( PAD* pad : electricalPads( fp ) )
+        {
+            if( pad->GetNetCode() == aNetCode )
+                pads.push_back( pad );
+        }
+    }
+
+    if( pads.size() == 2 )
+    {
+        sig.m_Nodes.push_back( NodeFor( pads[0] ) );
+        sig.m_Nodes.push_back( NodeFor( pads[1] ) );
+    }
+    else
+    {
+        sig.m_WholeNet = true;
+        sig.m_Net = net->GetNetname();
+    }
+
+    return sig;
+}
