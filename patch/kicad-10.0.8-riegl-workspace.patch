+     */
+    bool OwnerProcessGone() const
+    {
+        if( m_fileCreated || m_pid <= 0 )
+            return false;
+
+        if( m_username != wxGetUserId() || m_hostname != wxGetHostName() )
+            return false;
+
+        return !wxProcess::Exists( static_cast<int>( m_pid ) );
