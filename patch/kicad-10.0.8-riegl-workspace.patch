+
+void WORKSPACE_PANE::removeProject( const wxString& aProFile )
+{
+    if( HasRunningChild( aProFile ) )
+    {
+        DisplayInfoMessage( m_frame, _( "This project is still open in an editor. Close its editors "
+                                        "before removing it from the workspace." ) );
+        return;
+    }
+
+    if( m_workspace.RemoveProject( aProFile ) )
+        workspaceChanged( true );
