+std::vector<WS_WINDOW_INFO> KICAD_MANAGER_FRAME::CollectEditorWindows()
+{
+    // The frames worth a tab; everything else (choosers, viewers, ...) stays a free window.
+    static const FRAME_T types[] = { FRAME_SCH, FRAME_PCB_EDITOR, FRAME_SCH_SYMBOL_EDITOR,
+                                     FRAME_FOOTPRINT_EDITOR, FRAME_SIMULATOR };
+
+    std::vector<WS_WINDOW_INFO> windows;
+    wxString                    proFile = Prj().IsNullProject() ? wxString() : Prj().GetProjectFullName();
+
+    for( FRAME_T type : types )
+    {
+        KIWAY_PLAYER* player = Kiway().Player( type, false );
+
+        if( !player || !player->IsShown() || player->IsModal() )
+            continue;
+
+        WS_WINDOW_INFO info;
+        info.handle = KIPLATFORM::WINDOW_EMBED::GetHandle( player );
+        info.frameType = type;
+        info.title = player->GetTitle();
+        info.proFile = proFile;
+        info.inProcess = true;
+
+        if( info.handle != 0 )
+            windows.push_back( info );
+    }
+
+    return windows;
+}
