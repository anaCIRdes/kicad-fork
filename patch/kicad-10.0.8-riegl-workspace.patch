+/// Milliseconds between two looks at the open editor frames.
+static const int DOCK_TIMER_MS = 150;
+
+/// Every that many timer ticks the geometry of the visible frames is applied again, in case a
+/// window manager ignored or reverted an earlier request.
+static const int DOCK_REAPPLY_TICKS = 14;
+
+/// Give up waiting for a frame that was requested to open after that many ticks (about 90 s).
+static const int DOCK_PENDING_TICKS = 600;
