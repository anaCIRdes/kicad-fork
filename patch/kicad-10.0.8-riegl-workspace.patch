+#ifndef KICAD_WORKSPACE_PANE_H
+#define KICAD_WORKSPACE_PANE_H
+
+#include <future>
+#include <map>
+#include <set>
+#include <vector>
+
+#include <wx/panel.h>
+#include <wx/timer.h>
+#include <wx/treectrl.h>
+
+#include "workspace.h"
+
+class KICAD_MANAGER_FRAME;
+class WS_CHILD_PROCESS;
+class wxListBox;
+class wxStaticText;
+
+
+/**
+ * The "Workspace" pane of the project manager: several projects side by side (similar to the
+ * Projects panel of Altium Designer), with a live overview of who has which file open.
+ *
+ * The project that is active in this manager window is edited in-process exactly like in stock
+ * KiCad.  Every other workspace project is edited in its own helper process (a KiCad manager
+ * started with --ws-child whose manager window stays hidden), so that schematic and board of
+ * that project still talk to each other (cross probing, update PCB from schematic, ...).
+ */
+class WORKSPACE_PANE : public wxPanel
+{
+public:
+    WORKSPACE_PANE( KICAD_MANAGER_FRAME* aParent );
+    ~WORKSPACE_PANE() override;
+
+    // Workspace file handling (File > Workspace menu)
+    void NewWorkspace();
+    void OpenWorkspace();
+    void SaveWorkspaceAs();
+    void AddProjectDialog();
+    void AddActiveProject();
+
+    /// The manager loaded (or closed) its active project.
+    void OnProjectLoaded( const wxString& aProFile );
+    void ActiveProjectChanged();
+
+    /// Is this project currently edited by one of our helper processes?
+    bool HasRunningChild( const wxString& aProFile ) const;
+
+    /// Ask all helper processes to close (they prompt for unsaved changes themselves).
+    void CloseChildren();
+
+    /// Trigger a rescan of files and locks as soon as possible.
+    void RequestScan() { m_scanRequested = true; }
+
+    /// Called by WS_CHILD_PROCESS when a helper process ended.
+    void OnChildTerminated( const wxString& aProFile );
+
+    /// Re-apply all translated texts.
+    void ShowChangedLanguage();
+
+private:
+    enum class OPEN_WHAT { SCHEMATIC, PCB };
+
+    struct CHILD
+    {
+        long              pid = 0;
+        wxString          cmdDir;
+        int               seq = 0;
+        WS_CHILD_PROCESS* process = nullptr;
+    };
+
+    void buildUi();
+    void loadInitialWorkspace();
+    void workspaceChanged( bool aSave );
+    void updateCaption();
+
+    void onTimer( wxTimerEvent& aEvent );
+    void startScan();
+    void applySnapshot( std::vector<WS_PROJECT>&& aSnapshot );
+    void rebuildTree();
+    void updateLabels();
+    void reportLockChanges( const std::map<wxString, WS_LOCK_INFO>& aOld,
+                            const std::map<wxString, WS_LOCK_INFO>& aNew );
+    void addActivity( const wxString& aText );
+
+    wxString projectLabel( const WS_PROJECT& aProject ) const;
+    wxString fileLabel( const WS_PROJECT& aProject, const WS_FILE& aFile ) const;
+    wxString lockSuffix( const WS_LOCK_INFO& aLock ) const;
+    wxColour lockColour( const WS_LOCK_INFO& aLock ) const;
+    wxString lockTooltip( const wxString& aPath, const WS_LOCK_INFO& aLock ) const;
+
+    bool isActiveProject( const wxString& aProFile ) const;
+
+    void openInProject( const wxString& aProFile, OPEN_WHAT aWhat );
+    bool launchChild( const wxString& aProFile, OPEN_WHAT aWhat );
+    bool sendCommand( CHILD& aChild, const wxString& aCommand );
+    void setActiveProject( const wxString& aProFile );
+    void removeProject( const wxString& aProFile );
+
+    void onItemActivated( wxTreeEvent& aEvent );
+    void onItemMenu( wxTreeEvent& aEvent );
+    void onItemTooltip( wxTreeEvent& aEvent );
+
+    const WS_PROJECT* findProject( const wxString& aProFile ) const;
+
+private:
+    KICAD_MANAGER_FRAME* m_frame;
+    WORKSPACE            m_workspace;
+
+    wxStaticText*        m_title;
+    wxTreeCtrl*          m_tree;
+    wxListBox*           m_activity;
+    wxTimer              m_timer;
+
+    std::vector<WS_PROJECT>             m_snapshot;
+    std::future<std::vector<WS_PROJECT>> m_scan;
+    std::vector<wxString>               m_scanProjects;   ///< project list the running scan uses
+    bool                                m_scanRequested;
+    bool                                m_firstScanDone;
+    int                                 m_ticksSinceScan;
+    wxString                            m_treeSignature;
+
+    std::map<wxString, wxTreeItemId>    m_projectItems;
+    std::map<wxString, wxTreeItemId>    m_fileItems;
+    std::set<wxString>                  m_collapsed;      ///< projects the user collapsed
+
+    std::map<wxString, CHILD>           m_children;
+    int                                 m_childCounter;
+};
+
+#endif // KICAD_WORKSPACE_PANE_H
