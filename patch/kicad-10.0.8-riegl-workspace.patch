+void XSIGNAL_PANEL::OnBoardChanged()
+{
+    BOARD* board = m_frame->GetBoard();
+
+    // The previous board has been deleted by now; never touch the old pointer
+    m_board = board;
+
+    if( m_board )
+    {
+        m_board->RemoveListener( this );
+        m_board->AddListener( this );
+    }
+
+    m_metrics.clear();
+    m_dirty = true;
+
+    if( IsShownOnScreen() )
+        RefreshNow();
+}
