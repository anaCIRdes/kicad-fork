+void WORKSPACE_PANE::loadInitialWorkspace()
+{
+    wxString last = WORKSPACE::LoadLastUsed();
+
+    if( last.IsEmpty() || !m_workspace.Load( last ) )
+    {
+        wxString def = WORKSPACE::DefaultFileName();
+
+        if( !m_workspace.Load( def ) )
+            m_workspace.SetFileName( def );
+    }
+
+    updateCaption();
+}
+
+
+void WORKSPACE_PANE::updateCaption()
+{
+    wxFileName fn( m_workspace.GetFileName() );
+    wxString   name;
+
+    if( wxFileName( WORKSPACE::DefaultFileName() ).SameAs( fn ) )
+        name = _( "Default workspace" );
+    else
+        name = fn.GetName();
+
+    m_title->SetLabel( wxString::Format( _( "%s (%d projects)" ), name,
+                                         (int) m_workspace.GetProjects().size() ) );
+    m_title->SetToolTip( fn.GetFullPath() );
+}
+
+
+void WORKSPACE_PANE::workspaceChanged( bool aSave )
+{
+    if( aSave && !m_workspace.Save() )
+    {
+        DisplayErrorMessage( m_frame, wxString::Format( _( "Could not write workspace file '%s'." ),
+                                                        m_workspace.GetFileName() ) );
+    }
+
+    WORKSPACE::SaveLastUsed( m_workspace.GetFileName() );
+    updateCaption();
+
+    // Show added / removed projects immediately; files and locks follow with the next scan.
+    std::vector<WS_PROJECT> snapshot;
+
+    for( const wxString& proFile : m_workspace.GetProjects() )
+    {
+        if( const WS_PROJECT* known = findProject( proFile ) )
+        {
+            snapshot.push_back( *known );
+        }
+        else
+        {
+            WS_PROJECT prj;
+            prj.proFile = proFile;
+            prj.exists = true;
+            snapshot.push_back( prj );
+        }
+    }
+
+    m_snapshot = std::move( snapshot );
+    rebuildTree();
+    RequestScan();
+}
