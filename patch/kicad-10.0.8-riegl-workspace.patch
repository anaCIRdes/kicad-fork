+
+// ---------------------------------------------------------------------------------------------
+// Tracking the open editor frames
+// ---------------------------------------------------------------------------------------------
+
+std::vector<WS_WINDOW_INFO> WORKSPACE_DOCK::collect() const
+{
+    // Editors of the active project live in this process ...
+    std::vector<WS_WINDOW_INFO> all = m_frame->CollectEditorWindows();
+
+    // ... those of the other workspace projects in helper processes, which publish their frames.
+    for( const auto& [proFile, commandDir] : m_pane->GetChildDirs() )
+    {
+        std::vector<WS_WINDOW_INFO> windows;
+
+        if( !WS_WINDOW_INFO::Read( commandDir, windows ) )
+            continue;
+
+        for( WS_WINDOW_INFO& win : windows )
+        {
+            win.proFile = proFile;
+            win.inProcess = false;
+            all.push_back( win );
+        }
+    }
+
+    return all;
+}
+
+
+void WORKSPACE_DOCK::refreshWindows()
+{
+    if( m_inRefresh )
+        return;
+
+    m_inRefresh = true;
+
+    std::map<unsigned long long, WS_WINDOW_INFO> now;
+
+    for( const WS_WINDOW_INFO& win : collect() )
+    {
+        if( win.handle != 0 && WINDOW_EMBED::IsAlive( win.handle ) )
+            now[win.handle] = win;
+    }
+
+    // Frames that were closed
+    std::vector<WS_DOC_PAGE*> pages = m_pages;
+
+    for( WS_DOC_PAGE* page : pages )
+    {
+        if( !now.count( page->m_info.handle ) )
+            removePage( page, false );
+    }
+
+    for( auto it = m_floating.begin(); it != m_floating.end(); )
+    {
+        if( now.count( *it ) )
+            ++it;
+        else
+            it = m_floating.erase( it );
+    }
+
+    // New frames and changed titles
+    for( const auto& [handle, win] : now )
+    {
+        if( WS_DOC_PAGE* page = findPage( handle ) )
+        {
+            if( page->m_info.title != win.title )
+            {
+                page->m_info.title = win.title;
+                updateLabel( page );
+            }
+        }
+        else if( m_tabbed && !m_floating.count( handle ) )
+        {
+            // A frame that just opened is what the user wants to see
+            addPage( win, true );
+        }
+    }
+
+    m_known = now;
+
+    if( !m_pendingProFile.IsEmpty() )
+    {
+        wxString proFile = m_pendingProFile;
+        int      frameType = m_pendingFrameType;
+
+        if( Activate( proFile, frameType ) || ++m_pendingTicks > DOCK_PENDING_TICKS )
+        {
+            m_pendingProFile.clear();
+            m_pendingTicks = 0;
+        }
+    }
+
+    m_inRefresh = false;
+}
+
+
+WS_DOC_PAGE* WORKSPACE_DOCK::findPage( unsigned long long aHandle ) const
+{
+    for( WS_DOC_PAGE* page : m_pages )
+    {
+        if( page->m_info.handle == aHandle )
+            return page;
+    }
+
+    return nullptr;
+}
+
+
+static bool sameProject( const wxString& aLeft, const wxString& aRight )
+{
+    if( aLeft == aRight )
+        return true;
+
+    if( aLeft.IsEmpty() || aRight.IsEmpty() )
+        return false;
+
+    return wxFileName( aLeft ).SameAs( wxFileName( aRight ) );
+}
+
+
+WS_DOC_PAGE* WORKSPACE_DOCK::findPage( const wxString& aProFile, int aFrameType ) const
+{
+    for( WS_DOC_PAGE* page : m_pages )
+    {
+        if( page->m_info.frameType == aFrameType && sameProject( page->m_info.proFile, aProFile ) )
+            return page;
+    }
+
+    return nullptr;
+}
+
+
+bool WORKSPACE_DOCK::Activate( const wxString& aProFile, int aFrameType )
+{
+    if( WS_DOC_PAGE* page = findPage( aProFile, aFrameType ) )
+    {
+        selectPage( page );
+        return true;
+    }
+
+    // Free floating frames (tabs switched off, or undocked by the user)
+    for( const auto& [handle, win] : m_known )
+    {
+        if( win.frameType == aFrameType && sameProject( win.proFile, aProFile ) )
+        {
+            WINDOW_EMBED::Activate( handle, m_frame );
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+void WORKSPACE_DOCK::ActivateWhenOpened( const wxString& aProFile, int aFrameType )
+{
+    m_pendingProFile = aProFile;
+    m_pendingFrameType = aFrameType;
+    m_pendingTicks = 0;
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// Pages
+// ---------------------------------------------------------------------------------------------
+
+wxString WORKSPACE_DOCK::labelFor( const WS_WINDOW_INFO& aInfo ) const
+{
+    wxString kind;
+
+    switch( aInfo.frameType )
+    {
+    case FRAME_SCH:               kind = _( "Schematic" );        break;
+    case FRAME_PCB_EDITOR:        kind = _( "PCB" );              break;
+    case FRAME_SCH_SYMBOL_EDITOR: kind = _( "Symbol Editor" );    break;
+    case FRAME_FOOTPRINT_EDITOR:  kind = _( "Footprint Editor" ); break;
+    case FRAME_SIMULATOR:         kind = _( "Simulator" );        break;
+    default:                      kind = _( "Editor" );           break;
+    }
+
+    wxString label = wxFileName( aInfo.proFile ).GetName();
+
+    if( label.IsEmpty() )
+        label = kind;
+    else
+        label += wxS( " – " ) + kind;
+
+    // KiCad marks unsaved changes with a leading asterisk in the frame title
+    if( aInfo.title.StartsWith( wxS( "*" ) ) )
+        label = wxS( "*" ) + label;
+
+    return label;
+}
+
+
+static BITMAPS bitmapFor( int aFrameType )
+{
+    switch( aFrameType )
+    {
+    case FRAME_SCH:               return BITMAPS::icon_eeschema_24;
+    case FRAME_PCB_EDITOR:        return BITMAPS::icon_pcbnew_24;
+    case FRAME_SCH_SYMBOL_EDITOR: return BITMAPS::icon_libedit_24;
+    case FRAME_FOOTPRINT_EDITOR:  return BITMAPS::icon_modedit_24;
+    default:                      return BITMAPS::icon_eeschema_24;
+    }
+}
+
+
+void WORKSPACE_DOCK::addPage( const WS_WINDOW_INFO& aInfo, bool aSelect )
+{
+    WINDOW_EMBED::Attach( aInfo.handle, m_frame );
+
+    WS_DOC_PAGE* page = new WS_DOC_PAGE( m_notebook, aInfo );
+    m_pages.push_back( page );
+
+    page->Bind( wxEVT_SIZE,
+                [this]( wxSizeEvent& aEvent )
+                {
+                    aEvent.Skip();
+
+                    // Let the notebook finish its layout before reading screen positions
+                    CallAfter(
+                            [this]()
+                            {
+                                Sync();
+                            } );
+                } );
+
+    m_notebook->AddPage( page, labelFor( aInfo ), false, KiBitmapBundleDef( bitmapFor( aInfo.frameType ), 16 ) );
+    m_notebook->SetPageToolTip( m_notebook->GetPageIndex( page ), aInfo.title );
+    m_frame->HideTabsIfNeeded();
+
+    if( aSelect )
+        selectPage( page );
+    else
+        Sync();
+}
+
+
+void WORKSPACE_DOCK::removePage( WS_DOC_PAGE* aPage, bool aDetach )
+{
+    auto it = std::find( m_pages.begin(), m_pages.end(), aPage );
+
+    if( it == m_pages.end() )
+        return;
+
+    m_pages.erase( it );
+
+    if( aDetach )
+        WINDOW_EMBED::Detach( aPage->m_info.handle );
+
+    int index = m_notebook->GetPageIndex( aPage );
+
+    if( index != wxNOT_FOUND )
+        m_notebook->DeletePage( index );
+
+    m_frame->HideTabsIfNeeded();
+}
+
+
+void WORKSPACE_DOCK::updateLabel( WS_DOC_PAGE* aPage )
+{
+    int index = m_notebook->GetPageIndex( aPage );
+
+    if( index == wxNOT_FOUND )
+        return;
+
+    wxString label = labelFor( aPage->m_info );
+
+    if( m_notebook->GetPageText( index ) != label )
+        m_notebook->SetPageText( index, label );
+
+    m_notebook->SetPageToolTip( index, aPage->m_info.title );
+}
+
+
+void WORKSPACE_DOCK::selectPage( WS_DOC_PAGE* aPage )
+{
+    int index = m_notebook->GetPageIndex( aPage );
+
+    if( index == wxNOT_FOUND )
+        return;
+
+    if( m_notebook->GetSelection() != index )
+        m_notebook->SetSelection( index );
+
+    Sync();
+    WINDOW_EMBED::Activate( aPage->m_info.handle, m_frame );
+}
+
+
+void WORKSPACE_DOCK::detachPage( WS_DOC_PAGE* aPage )
+{
+    m_floating.insert( aPage->m_info.handle );
+    removePage( aPage, true );
+}
+
+
+void WORKSPACE_DOCK::splitPage( wxWindow* aWindow, int aDirection )
+{
+    int index = m_notebook->GetPageIndex( aWindow );
+
+    if( index == wxNOT_FOUND )
+        return;
+
+    // The page that stays behind should keep showing what it showed before the split
+    wxWindow* previous = m_notebook->GetCurrentPage();
+
+    if( previous == aWindow )
+        previous = nullptr;
+
+    m_notebook->Split( index, aDirection );
+
+    if( previous )
+    {
+        int previousIndex = m_notebook->GetPageIndex( previous );
+
+        if( previousIndex != wxNOT_FOUND )
+            m_notebook->SetSelection( previousIndex );
+    }
+
+    index = m_notebook->GetPageIndex( aWindow );
+
+    if( index != wxNOT_FOUND )
+        m_notebook->SetSelection( index );
+
+    Sync();
+}
+
+
+void WORKSPACE_DOCK::unsplit()
+{
+    // wxAuiNotebook (3.2) has no call to merge its tab controls again; removing all pages and
+    // adding them back puts them into a single tab control.
+    struct ENTRY
+    {
+        wxWindow*      window;
+        wxString       text;
+        wxString       tip;
+        wxBitmapBundle bitmap;
+    };
+
+    std::vector<ENTRY> entries;
+    wxWindow*          selected = m_notebook->GetCurrentPage();
+
+    for( size_t i = 0; i < m_notebook->GetPageCount(); i++ )
+    {
+        ENTRY entry;
+        entry.window = m_notebook->GetPage( i );
+        entry.text = m_notebook->GetPageText( i );
+        entry.tip = m_notebook->GetPageToolTip( i );
+        entry.bitmap = wxBitmapBundle( m_notebook->GetPageBitmap( i ) );
+        entries.push_back( entry );
+    }
+
+    if( entries.size() < 2 )
+        return;
+
+    m_inRefresh = true;     // no page bookkeeping while the notebook is taken apart
+    m_notebook->Freeze();
+
+    while( m_notebook->GetPageCount() > 0 )
+        m_notebook->RemovePage( 0 );
+
+    for( const ENTRY& entry : entries )
+    {
+        m_notebook->AddPage( entry.window, entry.text, false, entry.bitmap );
+
+        if( !entry.tip.IsEmpty() )
+            m_notebook->SetPageToolTip( m_notebook->GetPageCount() - 1, entry.tip );
+    }
+
+    int index = selected ? m_notebook->GetPageIndex( selected ) : 0;
+    m_notebook->SetSelection( index == wxNOT_FOUND ? 0 : index );
+
+    m_notebook->Thaw();
+    m_inRefresh = false;
+
+    m_frame->HideTabsIfNeeded();
+    Sync();
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// Keeping the frames over their pages
+// ---------------------------------------------------------------------------------------------
+
+void WORKSPACE_DOCK::Sync()
+{
+    if( m_pages.empty() )
+        return;
+
+    // A minimized manager takes its docked frames along (owner / transient relation)
+    if( m_frame->IsIconized() )
+        return;
+
+    for( WS_DOC_PAGE* page : m_pages )
+    {
+        bool visible = m_tabbed && m_frame->IsShown() && page->IsShownOnScreen();
+
+        if( visible )
+        {
+            wxRect rect( page->GetScreenPosition(), page->GetSize() );
+
+            if( rect.width < 20 || rect.height < 20 )
+                continue;
+
+            if( rect != page->m_lastRect || page->m_shown != 1 )
+            {
+                WINDOW_EMBED::SetGeometry( page->m_info.handle, m_frame, rect );
+                page->m_lastRect = rect;
+            }
+
+            if( page->m_shown != 1 )
+            {
+                WINDOW_EMBED::Show( page->m_info.handle, true );
+                page->m_shown = 1;
+            }
+        }
+        else if( page->m_shown != 0 )
+        {
+            WINDOW_EMBED::Show( page->m_info.handle, false );
+            page->m_shown = 0;
+        }
+    }
+}
+
+
+void WORKSPACE_DOCK::onTimer( wxTimerEvent& aEvent )
+{
+    static int tick = 0;
+
+    refreshWindows();
+
+    if( ++tick % DOCK_REAPPLY_TICKS == 0 )
+    {
+        // Apply the geometry of the visible frames again
+        for( WS_DOC_PAGE* page : m_pages )
+            page->m_lastRect = wxRect();
+    }
+
+    Sync();
+}
+
+
+void WORKSPACE_DOCK::onFrameMove( wxMoveEvent& aEvent )
+{
+    aEvent.Skip();
+    Sync();
+}
+
+
+void WORKSPACE_DOCK::onPageChanged( wxAuiNotebookEvent& aEvent )
+{
+    aEvent.Skip();
+
+    if( m_inRefresh && m_pages.empty() )
+        return;
+
+    CallAfter(
+            [this]()
+            {
+                Sync();
+
+                // Typing should go to the editor whose tab was just selected
+                wxWindow* current = m_notebook->GetCurrentPage();
+
+                if( OwnsPage( current ) )
+                    WINDOW_EMBED::Activate( static_cast<WS_DOC_PAGE*>( current )->m_info.handle, m_frame );
+            } );
+}
+
+
+void WORKSPACE_DOCK::onTabRightUp( wxAuiNotebookEvent& aEvent )
+{
+    int index = aEvent.GetSelection();
+
+    if( index < 0 || index >= (int) m_notebook->GetPageCount() )
+    {
+        aEvent.Skip();
+        return;
+    }
+
+    wxWindow* window = m_notebook->GetPage( index );
+    bool      isDoc = OwnsPage( window );
+
+    wxMenu menu;
+
+    auto add = [&]( const wxString& aLabel, bool aEnable, std::function<void()> aHandler )
+    {
+        wxMenuItem* item = menu.Append( wxID_ANY, aLabel );
+        item->Enable( aEnable );
+        menu.Bind( wxEVT_MENU,
+                   [aHandler]( wxCommandEvent& )
+                   {
+                       aHandler();
+                   },
+                   item->GetId() );
+    };
+
+    bool canSplit = m_notebook->GetPageCount() > 1;
+
+    add( _( "Show Beside (Split Right)" ), canSplit,
+         [this, window]()
+         {
+             splitPage( window, wxRIGHT );
+         } );
+
+    add( _( "Show Below (Split Down)" ), canSplit,
+         [this, window]()
+         {
+             splitPage( window, wxBOTTOM );
+         } );
+
+    add( _( "Remove Split" ), canSplit,
+         [this]()
+         {
+             unsplit();
+         } );
+
+    if( isDoc )
+    {
+        menu.AppendSeparator();
+
+        add( _( "Undock as Separate Window" ), true,
+             [this, window]()
+             {
+                 if( OwnsPage( window ) )
+                     detachPage( static_cast<WS_DOC_PAGE*>( window ) );
+             } );
+
+        add( _( "Close Editor" ), true,
+             [this, window]()
+             {
+                 RequestClosePage( window );
+             } );
+    }
+
+    m_notebook->PopupMenu( &menu );
+}
