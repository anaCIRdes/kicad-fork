+
+// ---------------------------------------------------------------------------------------------
+// Tree
+// ---------------------------------------------------------------------------------------------
+
+wxString WORKSPACE_PANE::lockSuffix( const WS_LOCK_INFO& aLock ) const
+{
+    if( !aLock.locked )
+        return wxEmptyString;
+
+    if( aLock.stale )
+        return wxS( "  —  " ) + _( "stale lock (crashed session)" );
+
+    if( aLock.mine )
+        return wxS( "  —  " ) + _( "open on this computer" );
+
+    wxString owner = aLock.Owner().IsEmpty() ? _( "Unknown user" ) : aLock.Owner();
+    wxString since;
+
+    // "2026-11-11T09:41:07" -> "11.11. 09:41" would need locale handling; keep date + time short
+    if( aLock.since.length() >= 16 )
+    {
+        wxString today = wxDateTime::Now().FormatISODate();
+
+        if( aLock.since.StartsWith( today ) )
+            since = aLock.since.Mid( 11, 5 );
+        else
+            since = aLock.since.Left( 10 ) + wxS( " " ) + aLock.since.Mid( 11, 5 );
+    }
+
+    if( since.IsEmpty() )
+        return wxS( "  —  " ) + wxString::Format( _( "in use by %s" ), owner );
+
+    return wxS( "  —  " ) + wxString::Format( _( "in use by %s since %s" ), owner, since );
+}
+
+
+wxColour WORKSPACE_PANE::lockColour( const WS_LOCK_INFO& aLock ) const
+{
+    if( !aLock.locked )
+        return wxNullColour;
+
+    bool dark = wxSystemSettings::GetAppearance().IsDark();
+
+    if( aLock.stale )
+        return dark ? wxColour( 255, 170, 60 ) : wxColour( 190, 100, 0 );
+
+    if( aLock.mine )
+        return dark ? wxColour( 110, 210, 130 ) : wxColour( 0, 120, 50 );
+
+    return dark ? wxColour( 255, 110, 110 ) : wxColour( 195, 30, 30 );
+}
+
+
+wxString WORKSPACE_PANE::lockTooltip( const wxString& aPath, const WS_LOCK_INFO& aLock ) const
+{
+    wxString tip = aPath;
+
+    if( !aLock.locked )
+        return tip + wxS( "\n" ) + _( "Not open anywhere." );
+
+    wxString since = aLock.since;
+    since.Replace( wxS( "T" ), wxS( " " ) );
+
+    tip << wxS( "\n" ) << _( "User:" ) << wxS( " " ) << ( aLock.user.IsEmpty() ? _( "unknown" ) : aLock.user );
+    tip << wxS( "\n" ) << _( "Computer:" ) << wxS( " " ) << ( aLock.host.IsEmpty() ? _( "unknown" ) : aLock.host );
+
+    if( !since.IsEmpty() )
+        tip << wxS( "\n" ) << _( "Since:" ) << wxS( " " ) << since;
+
+    if( !aLock.app.IsEmpty() )
+        tip << wxS( "\n" ) << _( "Application:" ) << wxS( " " ) << aLock.app;
+
+    if( aLock.pid > 0 )
+        tip << wxS( "\n" ) << wxS( "PID: " ) << aLock.pid;
+
+    if( aLock.stale )
+    {
+        tip << wxS( "\n" ) << _( "The process that created this lock no longer exists. The lock is "
+                                 "removed automatically when the file is opened." );
+    }
+
+    return tip;
+}
+
+
+wxString WORKSPACE_PANE::projectLabel( const WS_PROJECT& aProject ) const
+{
+    wxString label = wxFileName( aProject.proFile ).GetName();
+
+    if( !aProject.exists )
+        return label + wxS( "  —  " ) + _( "not found" );
+
+    if( isActiveProject( aProject.proFile ) )
+        label += wxS( "  [" ) + _( "active" ) + wxS( "]" );
+    else if( HasRunningChild( aProject.proFile ) )
+        label += wxS( "  [" ) + _( "open" ) + wxS( "]" );
+
+    // Our own project lock is implied by [active] / [open]; only mention foreign or stale ones.
+    if( aProject.lock.locked && ( !aProject.lock.mine || aProject.lock.stale ) )
+        label += lockSuffix( aProject.lock );
+
+    return label;
+}
+
+
+wxString WORKSPACE_PANE::fileLabel( const WS_PROJECT& aProject, const WS_FILE& aFile ) const
+{
+    wxFileName fn( aFile.path );
+    fn.MakeRelativeTo( wxFileName( aProject.proFile ).GetPath() );
+
+    return fn.GetFullPath() + lockSuffix( aFile.lock );
+}
+
+
+void WORKSPACE_PANE::rebuildTree()
+{
+    wxString selected;
+
+    if( m_tree->GetSelection().IsOk() )
+    {
+        if( WS_ITEM_DATA* data = dynamic_cast<WS_ITEM_DATA*>( m_tree->GetItemData( m_tree->GetSelection() ) ) )
+            selected = data->IsProject() ? data->m_proFile : data->m_file;
+    }
+
+    // Collapse / expand events fired while rebuilding must not alter the remembered state
+    std::set<wxString> collapsed = m_collapsed;
+
+    m_tree->Freeze();
+    m_tree->DeleteAllItems();
+    m_projectItems.clear();
+    m_fileItems.clear();
+
+    wxTreeItemId root = m_tree->AddRoot( wxS( "workspace" ), WS_ICON_WORKSPACE );
+    wxString     signature;
+
+    for( const WS_PROJECT& prj : m_snapshot )
+    {
+        signature << prj.proFile << ( prj.exists ? wxS( "|1\n" ) : wxS( "|0\n" ) );
+
+        wxTreeItemId prjItem = m_tree->AppendItem( root, wxEmptyString,
+                                                   prj.exists ? WS_ICON_PROJECT : WS_ICON_MISSING, -1,
+                                                   new WS_ITEM_DATA( prj.proFile, wxEmptyString ) );
+        m_projectItems[prj.proFile] = prjItem;
+
+        for( const WS_FILE& file : prj.files )
+        {
+            signature << wxS( " " ) << file.path << wxS( "\n" );
+
+            bool isSch = wxFileName( file.path ).GetExt().Lower() == FILEEXT::KiCadSchematicFileExtension;
+
+            wxTreeItemId fileItem = m_tree->AppendItem( prjItem, wxEmptyString,
+                                                        isSch ? WS_ICON_SCHEMATIC : WS_ICON_PCB, -1,
+                                                        new WS_ITEM_DATA( prj.proFile, file.path ) );
+            m_fileItems[file.path] = fileItem;
+        }
+    }
+
+    m_treeSignature = signature;
+    updateLabels();
+
+    for( const auto& [proFile, item] : m_projectItems )
+    {
+        if( !collapsed.count( proFile ) )
+            m_tree->Expand( item );
+    }
+
+    m_collapsed = collapsed;
+
+    if( !selected.IsEmpty() )
+    {
+        if( m_fileItems.count( selected ) )
+            m_tree->SelectItem( m_fileItems[selected] );
+        else if( m_projectItems.count( selected ) )
+            m_tree->SelectItem( m_projectItems[selected] );
+    }
+
+    m_tree->Thaw();
+}
+
+
+void WORKSPACE_PANE::updateLabels()
+{
+    for( const WS_PROJECT& prj : m_snapshot )
+    {
+        auto prjIt = m_projectItems.find( prj.proFile );
+
+        if( prjIt == m_projectItems.end() )
+            continue;
+
+        wxString label = projectLabel( prj );
+
+        if( m_tree->GetItemText( prjIt->second ) != label )
+            m_tree->SetItemText( prjIt->second, label );
+
+        m_tree->SetItemBold( prjIt->second, isActiveProject( prj.proFile ) );
+
+        if( !prj.exists )
+            m_tree->SetItemTextColour( prjIt->second, wxSystemSettings::GetColour( wxSYS_COLOUR_GRAYTEXT ) );
+        else if( prj.lock.locked && ( !prj.lock.mine || prj.lock.stale ) )
+            m_tree->SetItemTextColour( prjIt->second, lockColour( prj.lock ) );
+        else
+            m_tree->SetItemTextColour( prjIt->second, wxNullColour );
+
+        for( const WS_FILE& file : prj.files )
+        {
+            auto fileIt = m_fileItems.find( file.path );
+
+            if( fileIt == m_fileItems.end() )
+                continue;
+
+            wxString fileText = fileLabel( prj, file );
+
+            if( m_tree->GetItemText( fileIt->second ) != fileText )
+                m_tree->SetItemText( fileIt->second, fileText );
+
+            m_tree->SetItemTextColour( fileIt->second, lockColour( file.lock ) );
+        }
+    }
+}
+
+
+void WORKSPACE_PANE::onItemTooltip( wxTreeEvent& aEvent )
+{
+    WS_ITEM_DATA* data = dynamic_cast<WS_ITEM_DATA*>( m_tree->GetItemData( aEvent.GetItem() ) );
+
+    if( !data )
+        return;
+
+    const WS_PROJECT* prj = findProject( data->m_proFile );
+
+    if( !prj )
+        return;
+
+    if( data->IsProject() )
+    {
+        aEvent.SetToolTip( lockTooltip( prj->proFile, prj->lock ) );
+        return;
+    }
+
+    for( const WS_FILE& file : prj->files )
+    {
+        if( file.path == data->m_file )
+        {
+            aEvent.SetToolTip( lockTooltip( file.path, file.lock ) );
+            return;
+        }
+    }
+}
+
+
+void WORKSPACE_PANE::onItemActivated( wxTreeEvent& aEvent )
+{
+    WS_ITEM_DATA* data = dynamic_cast<WS_ITEM_DATA*>( m_tree->GetItemData( aEvent.GetItem() ) );
+
+    if( !data )
+        return;
+
+    if( data->IsProject() )
+    {
+        m_tree->Toggle( aEvent.GetItem() );
+        return;
+    }
+
+    bool isSch = wxFileName( data->m_file ).GetExt().Lower() == FILEEXT::KiCadSchematicFileExtension;
+
+    openInProject( data->m_proFile, isSch ? OPEN_WHAT::SCHEMATIC : OPEN_WHAT::PCB );
+}
+
+
+void WORKSPACE_PANE::onItemMenu( wxTreeEvent& aEvent )
+{
+    WS_ITEM_DATA* data = dynamic_cast<WS_ITEM_DATA*>( m_tree->GetItemData( aEvent.GetItem() ) );
+
+    if( !data )
+        return;
+
+    m_tree->SelectItem( aEvent.GetItem() );
+
+    // Copy: the item (and its data) may be deleted by a rescan while the menu is open
+    wxString proFile = data->m_proFile;
+    wxString file = data->m_file;
+    bool     exists = findProject( proFile ) && findProject( proFile )->exists;
+
+    wxMenu menu;
+
+    auto add = [&]( const wxString& aLabel, bool aEnable, std::function<void()> aHandler )
+    {
+        wxMenuItem* item = menu.Append( wxID_ANY, aLabel );
+        item->Enable( aEnable );
+        menu.Bind( wxEVT_MENU,
+                   [aHandler]( wxCommandEvent& )
+                   {
+                       aHandler();
+                   },
+                   item->GetId() );
+    };
+
+    add( _( "Open Schematic Editor" ), exists,
+         [this, proFile]()
+         {
+             openInProject( proFile, OPEN_WHAT::SCHEMATIC );
+         } );
+
+    add( _( "Open PCB Editor" ), exists,
+         [this, proFile]()
+         {
+             openInProject( proFile, OPEN_WHAT::PCB );
+         } );
+
+    menu.AppendSeparator();
+
+    add( _( "Make Active Project of This Window" ), exists && !isActiveProject( proFile ),
+         [this, proFile]()
+         {
+             setActiveProject( proFile );
+         } );
+
+    add( _( "Open Project Folder" ), exists,
+         [proFile]()
+         {
+             LaunchExternal( wxFileName( proFile ).GetPath() );
+         } );
+
+    menu.AppendSeparator();
+
+    add( _( "Remove Project from Workspace" ), true,
+         [this, proFile]()
+         {
+             removeProject( proFile );
+         } );
+
+    add( _( "Refresh" ), true,
+         [this]()
+         {
+             RequestScan();
+         } );
+
+    PopupMenu( &menu );
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// Opening editors
+// ---------------------------------------------------------------------------------------------
+
+bool WORKSPACE_PANE::HasRunningChild( const wxString& aProFile ) const
+{
+    return m_children.count( aProFile ) > 0;
+}
+
+
+void WORKSPACE_PANE::OnChildTerminated( const wxString& aProFile )
+{
+    auto it = m_children.find( aProFile );
+
+    if( it != m_children.end() )
+    {
+        // Remove the (normally empty) command folder
+        wxLogNull noLog;
+        wxString  cmdDir = it->second.cmdDir;
+
+        if( wxDir::Exists( cmdDir ) )
+            wxFileName::Rmdir( cmdDir, wxPATH_RMDIR_RECURSIVE );
+
+        m_children.erase( it );
+    }
+
+    updateLabels();
+    RequestScan();
+}
+
+
+void WORKSPACE_PANE::CloseChildren()
+{
+    for( auto& [proFile, child] : m_children )
+        sendCommand( child, wxS( "quit" ) );
+}
+
+
+void WORKSPACE_PANE::setActiveProject( const wxString& aProFile )
+{
+    if( HasRunningChild( aProFile ) )
+    {
+        DisplayInfoMessage( m_frame, _( "This project is open in its own editor windows. Close them "
+                                        "first to make it the active project of this window." ) );
+        return;
+    }
+
+    m_frame->LoadProject( wxFileName( aProFile ) );
+}
+
+
+void WORKSPACE_PANE::openInProject( const wxString& aProFile, OPEN_WHAT aWhat )
+{
+    if( !wxFileName::FileExists( aProFile ) )
+    {
+        DisplayErrorMessage( m_frame, wxString::Format( _( "Project file '%s' not found." ), aProFile ) );
+        return;
+    }
+
+    // The active project of this window is edited in-process, exactly like in stock KiCad.
+    if( isActiveProject( aProFile ) )
+    {
+        m_frame->GetToolManager()->RunAction( aWhat == OPEN_WHAT::SCHEMATIC ? KICAD_MANAGER_ACTIONS::editSchematic
+                                                                             : KICAD_MANAGER_ACTIONS::editPCB );
+        RequestScan();
+        return;
+    }
+
+    auto it = m_children.find( aProFile );
+
+    if( it != m_children.end() )
+    {
+        sendCommand( it->second, aWhat == OPEN_WHAT::SCHEMATIC ? wxS( "sch" ) : wxS( "pcb" ) );
+        return;
+    }
+
+    if( launchChild( aProFile, aWhat ) )
+    {
+        m_frame->SetStatusText( wxString::Format( _( "Opening project '%s'..." ),
+                                                  wxFileName( aProFile ).GetName() ), 0 );
+        updateLabels();
+    }
+}
+
+
+bool WORKSPACE_PANE::launchChild( const wxString& aProFile, OPEN_WHAT aWhat )
+{
+    wxString cmdDir = wxFileName::GetTempDir() + wxFileName::GetPathSeparator()
+                      + wxString::Format( wxS( "kicad-ws-%lu-%d" ), wxGetProcessId(), ++m_childCounter );
+
+    {
+        wxLogNull noLog;
+
+        if( wxDir::Exists( cmdDir ) )
+            wxFileName::Rmdir( cmdDir, wxPATH_RMDIR_RECURSIVE );
+
+        if( !wxFileName::Mkdir( cmdDir, wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL ) )
+        {
+            DisplayErrorMessage( m_frame, wxString::Format( _( "Could not create folder '%s'." ), cmdDir ) );
+            return false;
+        }
+    }
+
+    std::vector<wxString> args;
+    args.push_back( wxStandardPaths::Get().GetExecutablePath() );
+    args.push_back( wxS( "--ws-child=" ) + cmdDir );
+    args.push_back( aWhat == OPEN_WHAT::SCHEMATIC ? wxS( "--ws-open=sch" ) : wxS( "--ws-open=pcb" ) );
+    args.push_back( aProFile );
+
+    // Keep stable wide copies alive for the duration of the call
+    std::vector<std::wstring> wideArgs;
+
+    for( const wxString& arg : args )
+        wideArgs.push_back( arg.ToStdWstring() );
+
+    std::vector<const wchar_t*> argv;
+
+    for( const std::wstring& arg : wideArgs )
+        argv.push_back( arg.c_str() );
+
+    argv.push_back( nullptr );
+
+    WS_CHILD_PROCESS* process = new WS_CHILD_PROCESS( this, aProFile );
+    long              pid = wxExecute( argv.data(), wxEXEC_ASYNC, process );
+
+    if( pid <= 0 )
+    {
+        delete process;
+        DisplayErrorMessage( m_frame, _( "Could not start the editor process." ) );
+        return false;
+    }
+
+    CHILD child;
+    child.pid = pid;
+    child.cmdDir = cmdDir;
+    child.process = process;
+    m_children[aProFile] = child;
+
+    return true;
+}
+
+
+bool WORKSPACE_PANE::sendCommand( CHILD& aChild, const wxString& aCommand )
+{
+    wxLogNull noLog;
+
+    // Write to a temporary name first and rename: the helper process only ever sees
+    // complete command files.
+    wxString base = aChild.cmdDir + wxFileName::GetPathSeparator()
+                    + wxString::Format( wxS( "%06d" ), ++aChild.seq );
+
+    {
+        wxFFile file( base + wxS( ".tmp" ), wxS( "wb" ) );
+
+        if( !file.IsOpened() )
+            return false;
+
+        std::string text( aCommand.utf8_str() );
+        file.Write( text.data(), text.size() );
+        file.Close();
+    }
+
+    return wxRenameFile( base + wxS( ".tmp" ), base + wxS( ".cmd" ), true );
+}
