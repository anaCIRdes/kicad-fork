+void XSIGNAL_PANEL::onColumnClick( wxListEvent& aEvent )
+{
+    int column = aEvent.GetColumn();
+
+    if( column < 0 || column >= COL_COUNT )
+        return;
+
+    if( column == m_sortColumn )
+    {
+        m_sortAscending = !m_sortAscending;
+    }
+    else
+    {
+        m_sortColumn = column;
+        m_sortAscending = true;
+    }
+
+    rebuildSignalList();
+}
