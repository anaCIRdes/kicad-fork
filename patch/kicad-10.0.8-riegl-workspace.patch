+const WS_PROJECT* WORKSPACE_PANE::findProject( const wxString& aProFile ) const
+{
+    for( const WS_PROJECT& prj : m_snapshot )
+    {
+        if( prj.proFile == aProFile )
+            return &prj;
+    }
+
+    return nullptr;
