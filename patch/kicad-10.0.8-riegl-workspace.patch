+
+void WORKSPACE_PANE::AddActiveProject()
+{
+    if( Prj().IsNullProject() || Prj().GetProjectFullName().IsEmpty() )
+    {
+        DisplayInfoMessage( m_frame, _( "There is no active project that could be added." ) );
+        return;
+    }
+
+    if( m_workspace.AddProject( Prj().GetProjectFullName() ) )
+        workspaceChanged( true );
+}
