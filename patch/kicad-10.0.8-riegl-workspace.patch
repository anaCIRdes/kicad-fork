+#include "workspace.h"
+
+#include <algorithm>
+
+#include <wx/dir.h>
+#include <wx/ffile.h>
+#include <wx/filename.h>
+#include <wx/log.h>
+#include <wx/process.h>
+#include <wx/utils.h>
+
+#include <json_common.h>
+#include <paths.h>
+#include <wildcards_and_files_ext.h>
+
+
+namespace
+{
+/// How deep below the project folder schematics and boards are searched.
+const int SCAN_MAX_DEPTH = 2;
+
+/// Upper bound of files listed per project, protects against huge folders on slow shares.
+const size_t SCAN_MAX_FILES = 200;
+
+
+bool readTextFile( const wxString& aFileName, std::string& aContent )
+{
+    wxLogNull noLog;
+    wxFFile   file( aFileName, wxS( "rb" ) );
+
+    if( !file.IsOpened() )
+        return false;
+
+    wxFileOffset len = file.Length();
+
+    if( len < 0 || len > 4 * 1024 * 1024 )
+        return false;
+
+    aContent.resize( static_cast<size_t>( len ) );
+
+    if( len > 0 && file.Read( aContent.data(), static_cast<size_t>( len ) ) != static_cast<size_t>( len ) )
+        return false;
+
+    return true;
+}
+
+
+bool writeTextFile( const wxString& aFileName, const std::string& aContent )
+{
+    wxLogNull  noLog;
+    wxFileName fn( aFileName );
+
+    if( !fn.DirExists() )
+        wxFileName::Mkdir( fn.GetPath(), wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+
+    wxFFile file( aFileName, wxS( "wb" ) );
+
+    if( !file.IsOpened() )
+        return false;
+
+    return file.Write( aContent.data(), aContent.size() ) == aContent.size() && file.Close();
+}
+
+
+void collectFiles( const wxString& aDir, int aDepth, std::vector<wxString>& aFiles )
+{
+    wxLogNull noLog;
+    wxDir     dir( aDir );
+
+    if( !dir.IsOpened() )
+        return;
+
+    wxString name;
+    bool     more = dir.GetFirst( &name, wxEmptyString, wxDIR_FILES );
+
+    while( more && aFiles.size() < SCAN_MAX_FILES )
+    {
+        // Skip lock files, autosave files and hidden files
+        if( !name.StartsWith( wxS( "~" ) ) && !name.StartsWith( wxS( "." ) )
+            && !name.StartsWith( wxS( "_autosave-" ) ) )
+        {
+            wxString ext = name.AfterLast( '.' ).Lower();
+
+            if( ext == FILEEXT::KiCadSchematicFileExtension || ext == FILEEXT::KiCadPcbFileExtension )
+                aFiles.push_back( aDir + wxFileName::GetPathSeparator() + name );
+        }
+
+        more = dir.GetNext( &name );
+    }
+
+    if( aDepth >= SCAN_MAX_DEPTH )
+        return;
+
+    std::vector<wxString> subDirs;
+    more = dir.GetFirst( &name, wxEmptyString, wxDIR_DIRS );
+
+    while( more )
+    {
+        // Skip hidden folders (.git, .history, ...) and KiCad backup folders
+        if( !name.StartsWith( wxS( "." ) ) && !name.EndsWith( wxS( "-backups" ) ) )
+            subDirs.push_back( name );
+
+        more = dir.GetNext( &name );
+    }
+
+    for( const wxString& sub : subDirs )
+    {
+        wxString subPath = aDir + wxFileName::GetPathSeparator() + sub;
+
+        // A sub folder holding its own project is a different project
+        wxDir subDir( subPath );
+
+        if( subDir.IsOpened() && subDir.HasFiles( wxString( wxS( "*." ) ) + wxString( FILEEXT::ProjectFileExtension ) ) )
+            continue;
+
+        collectFiles( subPath, aDepth + 1, aFiles );
+    }
+}
+} // namespace
+
+
+wxString WS_LOCK_INFO::Owner() const
+{
+    if( user.IsEmpty() && host.IsEmpty() )
+        return wxEmptyString;
+
+    return user + wxS( "@" ) + host;
+}
+
+
+wxString WORKSPACE::Normalize( const wxString& aProFile )
+{
+    wxFileName fn( aProFile );
+    fn.MakeAbsolute();
+    fn.Normalize( wxPATH_NORM_DOTS | wxPATH_NORM_ABSOLUTE | wxPATH_NORM_TILDE );
+    return fn.GetFullPath();
+}
+
+
+bool WORKSPACE::Contains( const wxString& aProFile ) const
+{
+    wxFileName wanted( Normalize( aProFile ) );
+
+    for( const wxString& prj : m_projects )
+    {
+        if( wxFileName( prj ).SameAs( wanted ) )
+            return true;
+    }
+
+    return false;
+}
+
+
+bool WORKSPACE::AddProject( const wxString& aProFile )
+{
+    if( aProFile.IsEmpty() || Contains( aProFile ) )
+        return false;
+
+    m_projects.push_back( Normalize( aProFile ) );
+    return true;
+}
+
+
+bool WORKSPACE::RemoveProject( const wxString& aProFile )
+{
+    wxFileName wanted( Normalize( aProFile ) );
+
+    auto it = std::find_if( m_projects.begin(), m_projects.end(),
+                            [&]( const wxString& prj )
+                            {
+                                return wxFileName( prj ).SameAs( wanted );
+                            } );
+
+    if( it == m_projects.end() )
+        return false;
+
+    m_projects.erase( it );
+    return true;
+}
+
+
+bool WORKSPACE::Load( const wxString& aFileName )
+{
+    std::string content;
+
+    if( !readTextFile( aFileName, content ) )
+        return false;
+
+    std::vector<wxString> projects;
+
+    try
+    {
+        nlohmann::json j = nlohmann::json::parse( content );
+        wxString       baseDir = wxFileName( aFileName ).GetPath();
+
+        for( const nlohmann::json& entry : j.at( "projects" ) )
+        {
+            wxString   path = wxString::FromUTF8( entry.at( "path" ).get<std::string>() );
+            wxFileName fn( path );
+
+            if( !fn.IsAbsolute() )
+                fn.MakeAbsolute( baseDir );
+
+            projects.push_back( Normalize( fn.GetFullPath() ) );
+        }
+    }
+    catch( const std::exception& )
+    {
+        return false;
+    }
+
+    m_fileName = aFileName;
+    m_projects.clear();
+
+    for( const wxString& prj : projects )
+        AddProject( prj );
+
+    return true;
+}
+
+
+bool WORKSPACE::Save() const
+{
+    if( m_fileName.IsEmpty() )
+        return false;
+
+    wxFileName wsFile( m_fileName );
+    wsFile.MakeAbsolute();
+
+    wxString baseDir = wsFile.GetPathWithSep();
+
+    nlohmann::json j;
+    j["version"] = 1;
+    j["projects"] = nlohmann::json::array();
+
+    for( const wxString& prj : m_projects )
+    {
+        wxString stored = prj;
+
+        // Store relative paths (with forward slashes) for projects below the workspace
+        // folder so that a workspace on a share works from Windows and Linux alike.
+        if( prj.StartsWith( baseDir ) )
+        {
+            stored = prj.Mid( baseDir.length() );
+            stored.Replace( wxS( "\\" ), wxS( "/" ) );
+        }
+
+        nlohmann::json entry;
+        entry["path"] = std::string( stored.utf8_str() );
+        j["projects"].push_back( entry );
+    }
+
+    return writeTextFile( wsFile.GetFullPath(), j.dump( 2 ) + "\n" );
+}
+
+
+bool WORKSPACE::SaveAs( const wxString& aFileName )
+{
+    wxString previous = m_fileName;
+    m_fileName = aFileName;
+
+    if( Save() )
+        return true;
+
+    m_fileName = previous;
+    return false;
+}
+
+
+WS_LOCK_INFO WORKSPACE::ReadLockInfo( const wxString& aFile )
+{
+    WS_LOCK_INFO info;
+
+    wxFileName fn( aFile );
+    fn.SetName( FILEEXT::LockFilePrefix + fn.GetName() );
+    fn.SetExt( fn.GetExt() + wxS( "." ) + FILEEXT::LockFileExtension );
+
+    wxString lockName = fn.GetFullPath();
+
+    if( !wxFileName::FileExists( lockName ) )
+        return info;
+
+    info.locked = true;
+
+    std::string content;
+
+    if( readTextFile( lockName, content ) )
+    {
+        try
+        {
+            nlohmann::json j = nlohmann::json::parse( content );
+
+            info.user = wxString::FromUTF8( j.value( "username", std::string() ) );
+            info.host = wxString::FromUTF8( j.value( "hostname", std::string() ) );
+            info.pid = j.value( "pid", 0L );
+            info.since = wxString::FromUTF8( j.value( "since", std::string() ) );
+            info.app = wxString::FromUTF8( j.value( "app", std::string() ) );
+        }
+        catch( const std::exception& )
+        {
+            // Partially written / synced lock file: owner unknown
+        }
+    }
+
+    // Stock KiCad lock files carry no time stamp: fall back to the lock file's own date.
+    if( info.since.IsEmpty() )
+    {
+        wxLogNull  noLog;
+        wxDateTime modified;
+
+        if( fn.GetTimes( nullptr, &modified, nullptr ) && modified.IsValid() )
+            info.since = modified.FormatISOCombined();
+    }
+
+    info.mine = !info.user.IsEmpty() && info.user == wxGetUserId() && info.host == wxGetHostName();
+
+    if( info.mine && info.pid > 0 )
+    {
+        info.thisProcess = info.pid == static_cast<long>( wxGetProcessId() );
+        info.stale = !info.thisProcess && !wxProcess::Exists( static_cast<int>( info.pid ) );
+    }
+
+    return info;
+}
+
+
+std::vector<WS_PROJECT> WORKSPACE::Scan( const std::vector<wxString>& aProjects )
+{
+    std::vector<WS_PROJECT> result;
+    result.reserve( aProjects.size() );
+
+    for( const wxString& proFile : aProjects )
+    {
+        WS_PROJECT prj;
+        prj.proFile = proFile;
+        prj.exists = wxFileName::FileExists( proFile );
+
+        if( prj.exists )
+        {
+            prj.lock = ReadLockInfo( proFile );
+
+            wxFileName            proFn( proFile );
+            std::vector<wxString> files;
+
+            collectFiles( proFn.GetPath(), 0, files );
+
+            // Root schematic and board (same base name as the project) first, then
+            // schematics before boards, then alphabetically.
+            wxString rootName = proFn.GetName();
+
+            auto rank = [&]( const wxString& aPath )
+            {
+                wxFileName fn( aPath );
+                int        r = 0;
+
+                if( fn.GetName() != rootName || fn.GetPath() != proFn.GetPath() )
+                    r += 2;
+
+                if( fn.GetExt().Lower() != FILEEXT::KiCadSchematicFileExtension )
+                    r += 1;
+
+                return r;
+            };
+
+            std::sort( files.begin(), files.end(),
+                       [&]( const wxString& a, const wxString& b )
+                       {
+                           int ra = rank( a );
+                           int rb = rank( b );
+
+                           if( ra != rb )
+                               return ra < rb;
+
+                           return a.CmpNoCase( b ) < 0;
+                       } );
+
+            for( const wxString& file : files )
+            {
+                WS_FILE f;
+                f.path = file;
+                f.lock = ReadLockInfo( file );
+                prj.files.push_back( f );
+            }
+        }
+
+        result.push_back( prj );
+    }
+
+    return result;
+}
+
+
+wxString WORKSPACE::DefaultFileName()
+{
+    wxFileName fn( PATHS::GetUserSettingsPath(), wxS( "default" ), WORKSPACE_FILE_EXT );
+    return fn.GetFullPath();
+}
+
+
+static wxString stateFileName()
+{
+    wxFileName fn( PATHS::GetUserSettingsPath(), wxS( "workspace_state" ), wxS( "json" ) );
+    return fn.GetFullPath();
+}
+
+
+wxString WORKSPACE::LoadLastUsed()
+{
+    std::string content;
+
+    if( !readTextFile( stateFileName(), content ) )
+        return wxEmptyString;
+
+    try
+    {
+        nlohmann::json j = nlohmann::json::parse( content );
+        return wxString::FromUTF8( j.value( "last_workspace", std::string() ) );
+    }
+    catch( const std::exception& )
+    {
+        return wxEmptyString;
+    }
+}
+
+
+void WORKSPACE::SaveLastUsed( const wxString& aFileName )
+{
+    nlohmann::json j;
+    j["last_workspace"] = std::string( aFileName.utf8_str() );
+    writeTextFile( stateFileName(), j.dump( 2 ) + "\n" );
+}
