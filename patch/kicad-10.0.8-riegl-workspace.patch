+WORKSPACE_PANE::WORKSPACE_PANE( KICAD_MANAGER_FRAME* aParent ) :
+        wxPanel( aParent, wxID_ANY ),
+        m_frame( aParent ),
+        m_title( nullptr ),
+        m_tree( nullptr ),
+        m_activity( nullptr ),
+        m_timer( this ),
+        m_scanRequested( true ),
+        m_firstScanDone( false ),
+        m_ticksSinceScan( 0 ),
+        m_childCounter( 0 )
+{
+    buildUi();
+    loadInitialWorkspace();
+
+    Bind( wxEVT_TIMER, &WORKSPACE_PANE::onTimer, this, m_timer.GetId() );
+    m_timer.Start( 1000 );
+}
+
+
+WORKSPACE_PANE::~WORKSPACE_PANE()
+{
+    m_timer.Stop();
+
+    for( auto& [proFile, child] : m_children )
+    {
+        if( child.process )
+            child.process->Orphan();
+    }
+
+    // Wait for a running scan; it only reads a few small files.
+    if( m_scan.valid() )
+        m_scan.wait();
+}
