+XSIGNAL_TOOL::XSIGNAL_TOOL() :
+        PCB_TOOL_BASE( "pcbnew.XSignalTool" ),
+        m_frame( nullptr )
+{
+}
+
+
+/// The connected items (pads, tracks, vias) of a selection
+static std::vector<BOARD_CONNECTED_ITEM*> connectedItems( const SELECTION& aSelection )
+{
+    std::vector<BOARD_CONNECTED_ITEM*> items;
+
+    for( EDA_ITEM* item : aSelection )
+    {
+        switch( item->Type() )
+        {
+        case PCB_PAD_T:
+        case PCB_TRACE_T:
+        case PCB_ARC_T:
+        case PCB_VIA_T:
+            items.push_back( static_cast<BOARD_CONNECTED_ITEM*>( item ) );
+            break;
+
+        default:
+            break;
+        }
+    }
+
+    return items;
+}
+
+
+/// The footprints of a selection: selected footprints and the parents of selected pads, fields
+/// and footprint graphics.  Returns an empty list if anything else is selected.
+static std::vector<FOOTPRINT*> footprintsOf( const SELECTION& aSelection )
+{
+    std::vector<FOOTPRINT*> footprints;
+
+    for( EDA_ITEM* item : aSelection )
+    {
+        FOOTPRINT* fp = nullptr;
+
+        if( item->Type() == PCB_FOOTPRINT_T )
+            fp = static_cast<FOOTPRINT*>( item );
+        else if( item->IsBOARD_ITEM() )
+            fp = static_cast<BOARD_ITEM*>( item )->GetParentFootprint();
+
+        if( !fp )
+            return {};
+
+        if( std::find( footprints.begin(), footprints.end(), fp ) == footprints.end() )
+            footprints.push_back( fp );
+    }
+
+    return footprints;
+}
+
+
+bool XSIGNAL_TOOL::Init()
+{
+    PCB_SELECTION_TOOL* selectionTool = m_toolMgr->GetTool<PCB_SELECTION_TOOL>();
+
+    if( !selectionTool )
+        return true;
+
+    auto twoPads =
+            []( const SELECTION& aSelection )
+            {
+                if( aSelection.GetSize() != 2 )
+                    return false;
+
+                for( const EDA_ITEM* item : aSelection )
+                {
+                    if( item->Type() != PCB_PAD_T )
+                        return false;
+                }
+
+                return true;
+            };
+
+    auto onlyFootprints =
+            []( const SELECTION& aSelection )
+            {
+                if( aSelection.Empty() )
+                    return false;
+
+                for( const EDA_ITEM* item : aSelection )
+                {
+                    if( item->Type() != PCB_FOOTPRINT_T )
+                        return false;
+                }
+
+                return true;
+            };
+
+    // Series components may also be picked by one of their pads or texts
+    auto seriesFootprints =
+            []( const SELECTION& aSelection )
+            {
+                std::vector<FOOTPRINT*> footprints = footprintsOf( aSelection );
+
+                if( footprints.empty() )
+                    return false;
+
+                for( const FOOTPRINT* fp : footprints )
+                {
+                    if( !XSIGNAL_STORE::IsSeriesComponent( fp ) )
+                        return false;
+                }
+
+                return true;
+            };
+
+    auto onlyConnected =
+            []( const SELECTION& aSelection )
+            {
+                if( aSelection.Empty() )
+                    return false;
+
+                for( const EDA_ITEM* item : aSelection )
+                {
+                    switch( item->Type() )
+                    {
+                    case PCB_PAD_T:
+                    case PCB_TRACE_T:
+                    case PCB_ARC_T:
+                    case PCB_VIA_T:
+                        break;
+
+                    default:
+                        return false;
+                    }
+                }
+
+                return true;
+            };
+
+    auto oneConnected =
+            [onlyConnected]( const SELECTION& aSelection )
+            {
+                return aSelection.GetSize() == 1 && onlyConnected( aSelection );
+            };
+
+    CONDITIONAL_MENU& menu = selectionTool->GetToolMenu().GetMenu();
+
+    menu.AddItem( PCB_ACTIONS::xsignalFromSelectedPads, twoPads, 150 );
+    menu.AddItem( PCB_ACTIONS::xsignalFromConnectedNets, seriesFootprints, 150 );
+    menu.AddItem( PCB_ACTIONS::xsignalBetweenComponents, onlyFootprints, 150 );
+    menu.AddItem( PCB_ACTIONS::xsignalFromSelectedNets, onlyConnected, 150 );
+    menu.AddItem( PCB_ACTIONS::xsignalSelectFromItem, oneConnected, 150 );
+
+    return true;
+}
