+/**
+ * One editor frame (schematic editor, PCB editor, ...) of this process or of a workspace
+ * helper process.
+ */
+struct WS_WINDOW_INFO
+{
+    unsigned long long handle = 0;      ///< native window handle (HWND / X11 window id)
+    int                frameType = -1;  ///< FRAME_T
+    wxString           title;
