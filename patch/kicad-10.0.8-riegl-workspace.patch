+// ---------------------------------------------------------------------------------------------
+// Scanning
+// ---------------------------------------------------------------------------------------------
+
+void WORKSPACE_PANE::onTimer( wxTimerEvent& aEvent )
+{
+    if( m_scan.valid() )
+    {
+        if( m_scan.wait_for( std::chrono::seconds( 0 ) ) != std::future_status::ready )
+            return;
+
+        std::vector<WS_PROJECT> snapshot = m_scan.get();
+
+        // Drop the result if the project list changed while the scan was running
+        if( m_scanProjects == m_workspace.GetProjects() )
+            applySnapshot( std::move( snapshot ) );
+        else
+            m_scanRequested = true;
+    }
+
+    m_ticksSinceScan++;
+
+    if( m_scanRequested || m_ticksSinceScan >= SCAN_INTERVAL_S )
+        startScan();
+}
+
+
+void WORKSPACE_PANE::startScan()
+{
+    m_scanRequested = false;
+    m_ticksSinceScan = 0;
+    m_scanProjects = m_workspace.GetProjects();
+
+    std::vector<wxString> projects = m_scanProjects;
+
+    m_scan = std::async( std::launch::async,
+                         [projects]()
+                         {
+                             return WORKSPACE::Scan( projects );
+                         } );
+}
+
+
+void WORKSPACE_PANE::applySnapshot( std::vector<WS_PROJECT>&& aSnapshot )
+{
+    auto collectLocks = []( const std::vector<WS_PROJECT>& aProjects )
+    {
+        std::map<wxString, WS_LOCK_INFO> locks;
+
+        for( const WS_PROJECT& prj : aProjects )
+        {
+            if( prj.lock.locked )
+                locks[prj.proFile] = prj.lock;
+
+            for( const WS_FILE& file : prj.files )
+            {
+                if( file.lock.locked )
+                    locks[file.path] = file.lock;
+            }
+        }
+
+        return locks;
+    };
+
+    std::map<wxString, WS_LOCK_INFO> oldLocks = collectLocks( m_snapshot );
+    std::map<wxString, WS_LOCK_INFO> newLocks = collectLocks( aSnapshot );
+
+    m_snapshot = std::move( aSnapshot );
+
+    wxString signature;
+
+    for( const WS_PROJECT& prj : m_snapshot )
+    {
+        signature << prj.proFile << ( prj.exists ? wxS( "|1\n" ) : wxS( "|0\n" ) );
+
+        for( const WS_FILE& file : prj.files )
+            signature << wxS( " " ) << file.path << wxS( "\n" );
+    }
+
+    if( signature != m_treeSignature )
+        rebuildTree();
+    else
+        updateLabels();
+
+    if( m_firstScanDone )
+        reportLockChanges( oldLocks, newLocks );
+    else
+        reportLockChanges( {}, newLocks );
+
+    m_firstScanDone = true;
+}
+
+
+void WORKSPACE_PANE::reportLockChanges( const std::map<wxString, WS_LOCK_INFO>& aOld,
+                                        const std::map<wxString, WS_LOCK_INFO>& aNew )
+{
+    auto who = []( const WS_LOCK_INFO& aLock )
+    {
+        return aLock.Owner().IsEmpty() ? _( "Unknown user" ) : aLock.Owner();
+    };
+
+    wxString lastMessage;
+    int      count = 0;
+
+    for( const auto& [path, lock] : aNew )
+    {
+        if( lock.mine )
+            continue;
+
+        auto     it = aOld.find( path );
+        wxString name = wxFileName( path ).GetFullName();
+
+        if( it == aOld.end() )
+        {
+            lastMessage = wxString::Format( _( "%s opened %s" ), who( lock ), name );
+        }
+        else if( it->second.Owner() != lock.Owner() )
+        {
+            lastMessage = wxString::Format( _( "%s took over %s (was held by %s)" ), who( lock ), name,
+                                            who( it->second ) );
+        }
+        else
+        {
+            continue;
+        }
+
+        addActivity( lastMessage );
+        count++;
+    }
+
+    for( const auto& [path, lock] : aOld )
+    {
+        if( aNew.count( path ) )
+            continue;
+
+        if( lock.mine )
+            continue;
+
+        lastMessage = wxString::Format( _( "%s closed %s" ), who( lock ), wxFileName( path ).GetFullName() );
+        addActivity( lastMessage );
+        count++;
+    }
+
+    // A lock of ours that somebody else replaced is reported above as "took over"; the
+    // notification bell makes sure it does not go unnoticed.
+    if( count > 0 )
+    {
+        Pgm().GetNotificationsManager().CreateOrUpdate( wxS( "workspace-activity" ), _( "Workspace activity" ),
+                                                        lastMessage );
+    }
+}
+
+
+void WORKSPACE_PANE::addActivity( const wxString& aText )
+{
+    wxString line = wxDateTime::Now().Format( wxS( "%H:%M" ) ) + wxS( "  " ) + aText;
+
+    m_activity->Insert( line, 0 );
+
+    while( m_activity->GetCount() > ACTIVITY_MAX_LINES )
+        m_activity->Delete( m_activity->GetCount() - 1 );
+}
