+
+int XSIGNAL_TOOL::FromSelectedPads( const TOOL_EVENT& aEvent )
+{
+    PCB_SELECTION_TOOL* selectionTool = m_toolMgr->GetTool<PCB_SELECTION_TOOL>();
+    XSIGNAL_STORE*      store = m_frame->GetBoard()->XSignals();
+    std::vector<PAD*>   pads;
+
+    for( EDA_ITEM* item : selectionTool->GetSelection() )
+    {
+        if( item->Type() == PCB_PAD_T )
+            pads.push_back( static_cast<PAD*>( item ) );
+    }
+
+    if( pads.size() != 2 )
+    {
+        DisplayInfoMessage( m_frame,
+                            _( "Select exactly two pads: the start and the end of the signal path." ),
+                            _( "Click the first pad, then Shift+click the second one. If a click "
+                               "selects the whole footprint instead, switch off 'Footprints' in the "
+                               "selection filter. The two pads may be in different nets if series "
+                               "components (resistors, capacitors) lie in between." ) );
+        return 0;
+    }
+
+    XSIGNAL_PROPOSAL proposal;
+
+    if( !store->PathBetweenPads( pads[0], pads[1], 4, proposal.m_Signal ) )
+    {
+        DisplayError( m_frame, _( "The two pads are not connected: they are in different nets and no "
+                                  "chain of series components (two-pin parts or resistor arrays) "
+                                  "joins these nets." ) );
+        return 0;
+    }
+
+    if( store->Exists( proposal.m_Signal ) )
+    {
+        DisplayInfoMessage( m_frame, _( "An xSignal between these two pads already exists." ) );
+        return 0;
+    }
+
+    create( { proposal }, _( "Create xSignal from Selected Pads" ) );
+    return 0;
+}
+
+
+int XSIGNAL_TOOL::FromConnectedNets( const TOOL_EVENT& aEvent )
+{
+    PCB_SELECTION_TOOL*     selectionTool = m_toolMgr->GetTool<PCB_SELECTION_TOOL>();
+    XSIGNAL_STORE*          store = m_frame->GetBoard()->XSignals();
+    std::vector<FOOTPRINT*> series;
+
+    for( FOOTPRINT* fp : footprintsOf( selectionTool->GetSelection() ) )
+    {
+        if( XSIGNAL_STORE::IsSeriesComponent( fp ) )
+            series.push_back( fp );
+    }
+
+    if( series.empty() )
+    {
+        DisplayInfoMessage( m_frame,
+                            _( "Select one or more series components (two-pin parts such as "
+                               "termination resistors or coupling capacitors, or resistor arrays)." ),
+                            _( "An xSignal is created for every signal path that runs through a "
+                               "selected component, from the pads on one side to the pads on the "
+                               "other side." ) );
+        return 0;
+    }
+
+    wxString                      skipped;
+    std::vector<XSIGNAL_PROPOSAL> found = store->PathsThroughComponents( series, &skipped );
+    std::vector<XSIGNAL_PROPOSAL> proposals;
+
+    for( const XSIGNAL_PROPOSAL& proposal : found )
+    {
+        if( !store->Exists( proposal.m_Signal ) )
+            proposals.push_back( proposal );
+    }
+
+    if( proposals.empty() )
+    {
+        wxString msg = found.empty() ? _( "No signal path runs through the selected components." )
+                                     : _( "All paths through the selected components already exist "
+                                          "as xSignals." );
+
+        if( !skipped.IsEmpty() )
+        {
+            msg += wxS( "\n\n" ) + wxString::Format( _( "Skipped because one side is a supply net: %s" ),
+                                                     skipped );
+        }
+
+        DisplayInfoMessage( m_frame, msg );
+        return 0;
+    }
+
+    create( proposals, _( "Create xSignals from Connected Nets" ) );
+    return 0;
+}
+
+
+int XSIGNAL_TOOL::BetweenComponents( const TOOL_EVENT& aEvent )
+{
+    PCB_SELECTION_TOOL*     selectionTool = m_toolMgr->GetTool<PCB_SELECTION_TOOL>();
+    XSIGNAL_STORE*          store = m_frame->GetBoard()->XSignals();
+    FOOTPRINT*              source = nullptr;
+    std::vector<FOOTPRINT*> destinations;
+
+    // Preset from the selection: the component with the most pads is the source
+    for( FOOTPRINT* fp : footprintsOf( selectionTool->GetSelection() ) )
+    {
+        if( XSIGNAL_STORE::IsSeriesComponent( fp ) )
+            continue;
+
+        if( !source || fp->Pads().size() > source->Pads().size() )
+        {
+            if( source )
+                destinations.push_back( source );
+
+            source = fp;
+        }
+        else
+        {
+            destinations.push_back( fp );
+        }
+    }
+
+    DIALOG_XSIGNAL_WIZARD dlg( m_frame, store, source, destinations );
+
+    if( dlg.ShowModal() != wxID_OK )
+        return 0;
+
+    create( dlg.GetProposals(), _( "Create xSignals Between Components" ) );
+    return 0;
+}
+
+
+int XSIGNAL_TOOL::FromSelectedNets( const TOOL_EVENT& aEvent )
+{
+    PCB_SELECTION_TOOL* selectionTool = m_toolMgr->GetTool<PCB_SELECTION_TOOL>();
+    XSIGNAL_STORE*      store = m_frame->GetBoard()->XSignals();
+    std::set<int>       nets;
+
+    for( BOARD_CONNECTED_ITEM* item : connectedItems( selectionTool->GetSelection() ) )
+    {
+        if( item->GetNetCode() > 0 )
+            nets.insert( item->GetNetCode() );
+    }
+
+    if( nets.empty() )
+    {
+        DisplayInfoMessage( m_frame,
+                            _( "Select tracks, vias or pads of the nets whose lengths are to be matched." ),
+                            _( "Every selected net becomes a member of a class with a matched-length "
+                               "requirement. A net with exactly two pads is measured from pad to pad; "
+                               "any other net is measured as a whole." ) );
+        return 0;
+    }
+
+    std::vector<XSIGNAL_PROPOSAL> proposals;
+    int                           existing = 0;
+
+    for( int net : nets )
+    {
+        XSIGNAL_PROPOSAL proposal;
+        proposal.m_Signal = store->SignalForNet( net );
+
+        if( !proposal.m_Signal.m_WholeNet && proposal.m_Signal.m_Nodes.empty() )
+            continue;
+
+        if( store->Exists( proposal.m_Signal ) )
+        {
+            existing++;
+            continue;
+        }
+
+        proposals.push_back( proposal );
+    }
+
+    if( proposals.empty() )
+    {
+        DisplayInfoMessage( m_frame, existing ? _( "The selected nets are already xSignals. Use the "
+                                                   "xSignals panel to move them to a class." )
+                                              : _( "The selected items are not connected to a net." ) );
+        showPanel();
+        return 0;
+    }
+
+    create( proposals, _( "Match Lengths of Selected Nets" ) );
+    return 0;
+}
+
+
+int XSIGNAL_TOOL::SelectFromItem( const TOOL_EVENT& aEvent )
+{
+    PCB_SELECTION_TOOL*                selectionTool = m_toolMgr->GetTool<PCB_SELECTION_TOOL>();
+    XSIGNAL_STORE*                     store = m_frame->GetBoard()->XSignals();
+    std::vector<BOARD_CONNECTED_ITEM*> items = connectedItems( selectionTool->GetSelection() );
+
+    if( items.empty() )
+        return 0;
+
+    std::vector<wxString> names = store->SignalsContaining( items.front() );
+
+    if( names.empty() )
+    {
+        DisplayInfoMessage( m_frame, _( "The selected item is not part of an xSignal." ) );
+        return 0;
+    }
+
+    showPanel();
+
+    if( XSIGNAL_PANEL* panel = m_frame->GetXSignalsPanel() )
+        panel->ShowSignals( names );
+
+    return 0;
+}
+
+
+void XSIGNAL_TOOL::setTransitions()
+{
+    Go( &XSIGNAL_TOOL::TogglePanel,        PCB_ACTIONS::showXSignals.MakeEvent() );
+    Go( &XSIGNAL_TOOL::FromSelectedPads,   PCB_ACTIONS::xsignalFromSelectedPads.MakeEvent() );
+    Go( &XSIGNAL_TOOL::FromConnectedNets,  PCB_ACTIONS::xsignalFromConnectedNets.MakeEvent() );
+    Go( &XSIGNAL_TOOL::BetweenComponents,  PCB_ACTIONS::xsignalBetweenComponents.MakeEvent() );
+    Go( &XSIGNAL_TOOL::FromSelectedNets,   PCB_ACTIONS::xsignalFromSelectedNets.MakeEvent() );
+    Go( &XSIGNAL_TOOL::SelectFromItem,     PCB_ACTIONS::xsignalSelectFromItem.MakeEvent() );
+}
