+/// Add a "label | value | unit" row to a grid sizer and return the binder for it
+static std::unique_ptr<UNIT_BINDER> addLengthRow( PCB_EDIT_FRAME* aFrame, wxWindow* aParent,
+                                                  wxFlexGridSizer* aSizer, const wxString& aLabel )
+{
+    wxStaticText* label = new wxStaticText( aParent, wxID_ANY, aLabel );
+    wxTextCtrl*   ctrl = new wxTextCtrl( aParent, wxID_ANY );
+    wxStaticText* unit = new wxStaticText( aParent, wxID_ANY, wxS( "mm" ) );
+
+    aSizer->Add( label, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, 5 );
+    aSizer->Add( ctrl, 1, wxEXPAND | wxALIGN_CENTER_VERTICAL );
+    aSizer->Add( unit, 0, wxALIGN_CENTER_VERTICAL | wxLEFT, 5 );
+
+    return std::make_unique<UNIT_BINDER>( aFrame, label, ctrl, unit );
+}
+
+
+// ---------------------------------------------------------------------------------------------
+// DIALOG_XSIGNAL_CLASS
+// ---------------------------------------------------------------------------------------------
+
+DIALOG_XSIGNAL_CLASS::DIALOG_XSIGNAL_CLASS( PCB_EDIT_FRAME* aFrame, XSIGNAL_STORE* aStore,
+                                            const wxString& aClassName ) :
+        DIALOG_SHIM( aFrame, wxID_ANY,
+                     aClassName.IsEmpty() ? _( "New xSignal Class" ) : _( "xSignal Class Properties" ),
+                     wxDefaultPosition, wxDefaultSize, wxDEFAULT_DIALOG_STYLE | wxRESIZE_BORDER ),
+        m_frame( aFrame ),
+        m_store( aStore ),
+        m_className( aClassName )
+{
+    // The values belong to the class that is edited, not to the dialog
+    OptOut( this );
+
+    wxBoxSizer* mainSizer = new wxBoxSizer( wxVERTICAL );
+
+    wxFlexGridSizer* grid = new wxFlexGridSizer( 0, 3, 6, 0 );
+    grid->AddGrowableCol( 1, 1 );
+
+    grid->Add( new wxStaticText( this, wxID_ANY, _( "Class name:" ) ), 0,
+               wxALIGN_CENTER_VERTICAL | wxRIGHT, 5 );
+    m_nameCtrl = new wxTextCtrl( this, wxID_ANY );
+    grid->Add( m_nameCtrl, 1, wxEXPAND );
+    grid->AddSpacer( 0 );
+
+    grid->Add( new wxStaticText( this, wxID_ANY, _( "Length matching:" ) ), 0,
+               wxALIGN_CENTER_VERTICAL | wxRIGHT, 5 );
+    m_matchChoice = new wxChoice( this, wxID_ANY );
+    m_matchChoice->Append( _( "None" ) );
+    m_matchChoice->Append( _( "Match to the longest member" ) );
+    m_matchChoice->Append( _( "Match to a chosen member" ) );
+    m_matchChoice->Append( _( "Match to a fixed length" ) );
+    grid->Add( m_matchChoice, 1, wxEXPAND );
+    grid->AddSpacer( 0 );
+
+    m_referenceLabel = new wxStaticText( this, wxID_ANY, _( "Reference member:" ) );
+    grid->Add( m_referenceLabel, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, 5 );
+    m_referenceChoice = new wxChoice( this, wxID_ANY );
+    grid->Add( m_referenceChoice, 1, wxEXPAND );
+    grid->AddSpacer( 0 );
+
+    m_target = addLengthRow( aFrame, this, grid, _( "Target length:" ) );
+    m_tolerance = addLengthRow( aFrame, this, grid, _( "Tolerance:" ) );
+    m_minLength = addLengthRow( aFrame, this, grid, _( "Minimum length (0 = none):" ) );
+    m_maxLength = addLengthRow( aFrame, this, grid, _( "Maximum length (0 = none):" ) );
+
+    mainSizer->Add( grid, 0, wxEXPAND | wxALL, 10 );
+
+    // Reserve room for two lines of explanation, so that the dialog does not have to grow
+    m_hint = new wxStaticText( this, wxID_ANY, wxS( "\n" ) );
+    m_hint->SetMinSize( wxSize( FromDIP( 480 ), m_hint->GetBestSize().y ) );
+    mainSizer->Add( m_hint, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 10 );
+
+    wxStdDialogButtonSizer* buttons = new wxStdDialogButtonSizer();
+    buttons->AddButton( new wxButton( this, wxID_OK ) );
+    buttons->AddButton( new wxButton( this, wxID_CANCEL ) );
+    buttons->Realize();
+    mainSizer->Add( buttons, 0, wxEXPAND | wxALL, 5 );
+
+    SetSizer( mainSizer );
+
+    m_matchChoice->Bind( wxEVT_CHOICE, &DIALOG_XSIGNAL_CLASS::onMatchChoice, this );
+
+    SetupStandardButtons();
+    SetInitialFocus( m_nameCtrl );
+    finishDialogSettings();
+}
